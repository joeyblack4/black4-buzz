def qwen_home(base=None):
    """A private config home for Qwen Code (homes/qwen for the membership,
    homes/qwen-key for the key). Its settings.json gets our settings and keeps
    whatever Qwen Code wrote there; written only when that changes it."""
    home = private_dir(base or HOMES / "qwen")
    private_dir(home.parent)
    path = home / "settings.json"
    old = read_json(path, {})
    new = json.loads(json.dumps(old)) if isinstance(old, dict) else {}
    for section, values in QWEN_SETTINGS.items():
        if not isinstance(new.get(section), dict): new[section] = {}
        new[section].update(values)
    if new != old: write_private(path, json.dumps(new, indent=2) + "\n")
    # Qwen Code reads QWEN.md in its home into every session's system prompt
    # (proven on 0.27.4), whatever the host passes, so the note on reaching
    # the deferred Black 4 tools goes there, for every agent on this harness,
    # and the note on itself after it.
    write_note(home, "qwen", DEFERRED_MCP_NOTE["qwen"] + "\n")
    return home


