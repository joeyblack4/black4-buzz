# secp256k1, for the x-only public key of a new agent key (BIP-340).
P = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
     0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)


def _add(a, b):
    if a is None: return b
    if b is None: return a
    if a[0] == b[0] and (a[1] + b[1]) % P == 0: return None
    if a == b: m = 3 * a[0] * a[0] * pow(2 * a[1], P - 2, P) % P
    else: m = (b[1] - a[1]) * pow(b[0] - a[0], P - 2, P) % P
    x = (m * m - a[0] - b[0]) % P
    return (x, (m * (a[0] - x) - a[1]) % P)


def pubkey_of(secret_hex):
    k, point, addend = int(secret_hex, 16), None, G
    while k:
        if k & 1: point = _add(point, addend)
        addend = _add(addend, addend)
        k >>= 1
    return format(point[0], "064x")


class Fail(Exception):
    """A request that cannot be done; the message is the reply's plain sentence."""


def fail(message):
    raise Fail(message)


def private_dir(path):
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def write_private(path, text):
    """Write a file only this user can read, replacing it atomically."""
    # A name of its own, so writers that race never trip over each other's file.
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f: f.write(text)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def read_json(path, default=None):
    try: return json.loads(path.read_text())
    except (FileNotFoundError, ValueError): return default


def cap_log(path, limit):
    """Past `limit` bytes, copy the log to <name>.1 and empty it in place. A
    running agent holds its log open for appending, so it carries on writing at
    the start of the emptied file; nothing has to restart."""
    try:
        if path.stat().st_size <= limit: return
        shutil.copyfile(path, path.with_name(path.name + ".1"))
        with open(path, "r+") as f: f.truncate(0)
    except OSError:
        pass


def tail(path, n):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - n))
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def log_tail(d, n):
    """The last n characters an agent logged, across the cut-off file, without
    the terminal colours buzz-acp writes."""
    text = re.sub(r"\x1b\[[0-9;]*m", "", tail(d / "agent.log.1", 4 * n) + tail(d / "agent.log", 4 * n))
    return text[-n:]


def log_line(name, message):
    """Append a line to run/<name>.log. Never pass a secret here."""
    try:
        cap_log(private_dir(RUN) / f"{name}.log", RUN_LOG_CAP)
        with open(RUN / f"{name}.log", "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S ") + message + "\n")
    except OSError:
        pass


# ---------------------------------------------------------------- agents

def folder(pubkey):
    if not isinstance(pubkey, str) or not HEX64.match(pubkey):
        fail("pubkey must be 64 hex characters")
    return AGENTS / pubkey


def agent_dirs():
    if not AGENTS.exists(): return []
    return [d for d in sorted(AGENTS.iterdir()) if d.is_dir() and HEX64.match(d.name)]


def read_settings(d):
    return read_json(d / "agent.json", {})


def write_settings(d, settings):
    # A temp name of its own, so two writers never trip over each other's file.
    tmp = d / f".agent.json.{os.getpid()}.{secrets.token_hex(4)}.tmp"
    try:
        tmp.write_text(json.dumps(settings, indent=2))
        tmp.replace(d / "agent.json")
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def process_command(pid):
    """The command line of a live process, or "" (gone, or a zombie)."""
    done = subprocess.run(["/bin/ps", "-p", str(pid), "-o", "stat=,command="], capture_output=True, text=True)
    stat_, _, command = done.stdout.strip().partition(" ")
    return "" if not stat_ or stat_.startswith("Z") else command


def reap():
    """Collect exited children so they do not linger as zombies (the supervisor
    is the parent of every agent it restarts)."""
    while True:
        try: pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError: return
        if pid == 0: return


def running(d):
    """The pid of this agent's buzz-acp, or None. A reused pid does not count."""
    try: pid = int((d / "pid").read_text())
    except (FileNotFoundError, ValueError): return None
    try: os.kill(pid, 0)
    except OSError: return None
    if "buzz-acp" not in process_command(pid): return None
    return pid


def stop(d):
    pid = running(d)
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not running(d): break
            time.sleep(0.1)
        else:
            try: os.killpg(pid, signal.SIGKILL)
            except OSError: pass
    (d / "pid").unlink(missing_ok=True)


class agent_lock:
    """Serialises start/stop of one agent between SSH calls and the supervisor."""
    def __init__(self, d): self.path = d / "lock"
    def __enter__(self):
        self.f = open(self.path, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self
    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


