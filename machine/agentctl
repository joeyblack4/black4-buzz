def qwen_account(command, home, timeout=45):
    """Runs `qwen-account.mjs <command>` on a Qwen home: the last JSON line it
    printed as a dict, or None (missing script or Node, no answer). Never a token."""
    node = node_cli()
    if not node or not account_script().exists(): return None
    env = qwen_env(home)
    try:
        done = subprocess.run([node, str(account_script()), command, str(qwen_package())], env=env, cwd=private_dir(RUN / "check"),
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError):
        return None
    for line in reversed(done.stdout.strip().splitlines()):
        try: answer = json.loads(line)
        except ValueError: continue
        if isinstance(answer, dict): return answer
    return None


def member_cred(harness):
    """The fingerprint of the membership sign-in: its revision when it holds
    tokens, never the file's bytes. A file Qwen Code is rewriting (not JSON for
    an instant) keeps the last fingerprint rather than looking signed out."""
    path = HOMES / harness / MEMBER[harness]["cred"]
    if not path.exists(): return None
    for _ in range(3):
        data = read_json(path)
        if isinstance(data, dict): break
        time.sleep(0.05)
    else:
        return (read_json(CRED_RUN / f"{harness}-check.json", {}) or {}).get("hash") or None
    revision, tokens = data.get("revision"), data.get("tokens")
    if not isinstance(revision, str) or not revision or not isinstance(tokens, dict) or not tokens.get("access_token"): return None
    return token_hash("revision:" + revision)


def run_member_check(harness):
    """`qwen-account.mjs check` on the stored membership: (True/False/None, account)."""
    answer = qwen_account("check", HOMES / harness)
    if not answer: return None, None
    ok = answer.get("ok")
    return (ok if ok in (True, False) else None), (answer.get("account") or None)


def forget_member(harness):
