CALLER = None  # set from --caller by main(); None is the admin
LOGIN_ID = re.compile(r"^[0-9a-f]{16}$")
LOGIN_TTL = int(os.environ.get("AGENTCTL_LOGIN_TTL") or 15 * 60)  # a sign-in left open longer is dropped
