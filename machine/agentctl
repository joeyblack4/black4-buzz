# ---------------------------------------------------------------- Claude credential

def claude_token():
    try: token = (SECRETS / "claude").read_text().strip()
    except FileNotFoundError: return None
    return token or None


def token_hash(token):
    return hashlib.sha256(token.encode()).hexdigest()[:16]


def run_claude_check(token):
    """Ask Claude Code for one tiny reply with this token.
    Returns True (works), False (rejected) or None (could not tell, e.g. offline)."""
    cli = claude_cli()
    if not cli: return None
    env = base_env()
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    cwd = private_dir(RUN / "check")
    try:
        done = subprocess.run(
            [cli, "-p", "Reply with the single word OK.", "--model", "haiku",
             "--max-turns", "1", "--output-format", "json"],
            cwd=cwd, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
    except (subprocess.TimeoutExpired, OSError):
        return None
    return judge_claude_check(done.stdout)


def judge_claude_check(stdout):
    try: result = json.loads(stdout.strip().splitlines()[-1])
    except (ValueError, IndexError): return None
    if not result.get("is_error"): return True
    text = str(result.get("result") or "")
    if result.get("api_error_status") in (401, 403) or re.search(
            r"Not logged in|/login|authenticat|access token|invalid.*token|token.*(expired|revoked)", text, re.I):
        return False
    return None


def save_claude_token(token, account):
    private_dir(SECRETS)
    write_private(SECRETS / "claude", token + "\n")
    write_private(SECRETS / "claude.json", json.dumps({"account": account, "savedAt": int(time.time())}))
    write_private(private_dir(CRED_RUN) / "claude-check.json",
                  json.dumps({"hash": token_hash(token), "ok": True, "at": time.time()}))


def forget_claude_token():
    for name in ("claude", "claude.json"):
        (SECRETS / name).unlink(missing_ok=True)
    (CRED_RUN / "claude-check.json").unlink(missing_ok=True)


