# Qwen Code's QWEN.md in QWEN_HOME (with its note on deferred tools first),
# Antigravity's GEMINI.md in its --gemini-dir (its ~/.gemini/GEMINI.md).
NOTE_FILE = {"claude": "CLAUDE.md", "codex": "AGENTS.md", "grok": "AGENTS.md", "qwen": "QWEN.md", "antigravity": "GEMINI.md"}


def agentctl_command():
    """How an agent on this machine runs agentctl from its shell: its root is
    named when it is not the default one."""
    prefix = "".join(f"{k}={v} " for k, v in runner_env().items())
    return f"{prefix}{BIN / 'agentctl'}"


def self_note(harness):
    cmd = agentctl_command()
    return f"""# Black 4 hardware

You are a Black 4 hardware agent on the machine {machine_name()}, running {LABEL[harness]}. Your agent folder is the one above your working folder ({AGENTS}/<pubkey>/work); its name is your pubkey.

You can read and change your own setup with agentctl: one JSON request on stdin, one JSON reply. Replace <pubkey> with yours.

    echo '{{"op":"status","pubkey":"<pubkey>"}}' | {cmd}
    echo '{{"op":"heartbeat.get","pubkey":"<pubkey>"}}' | {cmd}
    echo '{{"op":"heartbeat.set","pubkey":"<pubkey>","minutes":30}}' | {cmd}
        minutes: 5 to 1440, or 0 for off. "prompt" sets what each heartbeat does ("" for the default).
    echo '{{"op":"models"}}' | {cmd}
        the models and efforts you can run here
    echo '{{"op":"settings.set","pubkey":"<pubkey>","model":"<id>","effort":"<level>","compactAt":150000}}' | {cmd}
        "" for the machine's default model or effort; compactAt: the tokens at which you compact your context, null for your harness's default
    echo '{{"op":"instructions.get","pubkey":"<pubkey>"}}' | {cmd}
    echo '{{"op":"instructions.set","pubkey":"<pubkey>","instructions":"<text>"}}' | {cmd}
    echo '{{"op":"start","pubkey":"<pubkey>"}}' | {cmd}
        restarts you

A change you make to yourself is saved at once and applies after your current turn ends (the reply says "applies": "after this turn"): finish your answer first.

Your heartbeat only sets how often you wake and ask start_next_standing_run. Which jobs run, and when, lives in Platform Control: change that with the Black 4 tools create_standing_work and update_standing_work.
"""


def write_note(home, harness, first=""):
    """The note for this harness in its home's instructions file, after
    `first` (a harness's own note); written only when it changes."""
    note = first + self_note(harness)
    path = home / NOTE_FILE[harness]
    try: current = path.read_text()
    except FileNotFoundError: current = None
    if current != note: write_private(path, note)


# Qwen Code's private home settings: no update of itself, no usage statistics
# or telemetry, and no managed memory (one folder shared by every Qwen agent
# on the machine, written by a second, paid model call after every turn).
# toolOutputBatchBudget caps one message's combined tool output in characters
# (the rest is kept in a file the agent can read); Qwen Code's default is
# 200k, 100k still lets a large Black 4 result (~64k) through whole. When
# Qwen Code compacts its context is each agent's own setting (compactAt).
QWEN_SETTINGS = {"general": {"enableAutoUpdate": False}, "privacy": {"usageStatisticsEnabled": False},
                 "telemetry": {"enabled": False},
                 "memory": {"enableManagedAutoMemory": False, "enableManagedAutoDream": False},
                 "tools": {"toolOutputBatchBudget": 100000}}


def qwen_home(base=None):
    """A private config home for Qwen Code (homes/qwen for the membership,
    homes/qwen-key for the key). Its settings.json gets our settings and keeps
    whatever Qwen Code wrote there; written only when that changes it."""
    home = private_dir(base or HOMES / "qwen")
    private_dir(home.parent)
    path = home / "settings.json"
    old = read_json(path, {})
    new = json.loads(json.dumps(old)) if isinstance(old, dict) else {}
    for section, values in QWEN_SETTINGS.items():
        if not isinstance(new.get(section), dict): new[section] = {}
        new[section].update(values)
    if new != old: write_private(path, json.dumps(new, indent=2) + "\n")
    # Qwen Code reads QWEN.md in its home into every session's system prompt
    # (proven on 0.27.4), whatever the host passes, so the note on reaching
    # the deferred Black 4 tools goes there, for every agent on this harness,
    # and the note on itself after it.
    write_note(home, "qwen", DEFERRED_MCP_NOTE["qwen"] + "\n")
    return home


def qwen_env(home=None):
    env = base_env()
    env["QWEN_HOME"] = str(home or qwen_home())
    env["BROWSER"] = "/usr/bin/true"  # never try to open one
    return env


def slot_home(slot):
    """The private home a slot's CLI runs in, made and settled: homes/<slot>,
    with the note on itself in the CLI's instructions file. Claude Code's
    homes hold only that note and the state Claude Code keeps (CLAUDE_CONFIG_DIR)."""
    harness = harness_of(slot)
    if harness == "qwen": return qwen_home(HOMES / slot)
    if harness == "antigravity":
        home = agy_home(HOMES / slot, key=slot.endswith("-key"))
    elif harness in DEVICE:
        home = cli_home(harness, HOMES / slot, KEYS.get(harness, {}).get("settings", ()) if slot.endswith("-key") else ())
    elif harness == "claude":
        home = private_dir(private_dir(HOMES) / slot)
    else:
        return None
    write_note(home, harness)
    return home


def slot_env(slot):
    """The environment a slot's own programs run in (its home when it has one)."""
    harness = harness_of(slot)
    if harness == "qwen": return qwen_env(slot_home(slot))
    if harness == "antigravity": return agy_env(slot_home(slot))
    if harness in DEVICE: return device_env(harness, slot_home(slot))
    env = base_env()
    if harness == "claude": env[KEYS["claude"]["home_env"]] = str(slot_home(slot))
    return env


def harness_env(harness):
    """The environment this harness's own programs run in, for what is not
    about one sign-in (the ACP handshake)."""
    return slot_env(harness)


def stored_key(harness):
    try: key = (SECRETS / f"{harness}-key").read_text().strip()
    except FileNotFoundError: return None
    return key or None


def key_info(harness):
    """{base, plan, savedAt} of the stored key; never the key."""
    info = read_json(SECRETS / f"{harness}-key.json", {})
    return info if isinstance(info, dict) else {}


def key_base(harness):
    return key_info(harness).get("base") or KEYS[harness]["bases"][0][1]


def http_get_json(url, headers, timeout=20):
    """GET url with these headers (the key among them): (HTTP status, the JSON
    body or None), or (None, None) when nothing answered. The key is in the
    header only, never in a command line or a log, and never follows a redirect
    (which would carry it to another host)."""
    import urllib.error, urllib.request

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs): return None

    req = urllib.request.Request(url, headers={**headers, "Accept": "application/json", "User-Agent": "black4-agentctl"})
    try:
        with urllib.request.build_opener(NoRedirect).open(req, timeout=timeout) as r:
            status, body = r.status, r.read()
    except urllib.error.HTTPError as e:
        status, body = e.code, e.read()
    except (OSError, ValueError):
        return None, None
    try: return status, json.loads(body)
    except ValueError: return status, None


def key_get(harness, base, key):
    """The service's model list for this key: (status, body)."""
    return http_get_json(base + "/models", KEYS[harness]["headers"](key))


def judge_key_answer(harness, status, body=None):
    """True: the key works (200). False: the service rejected it. None: could not tell."""
    if status == 200: return True
    if status is not None and KEYS[harness]["rejected"](status, body): return False
    return None


def verify_key(harness, key):
    """(True, base, plan) when a base answers the model list for this key;
    (False, None, None) when every base rejected it; (None, None, None) when
    one could not be reached or answered something else, which proves nothing."""
    unsure = False
    for plan, base in KEYS[harness]["bases"]:
        ok = judge_key_answer(harness, *key_get(harness, base, key))
        if ok: return True, base, plan
        if ok is None: unsure = True
    return (None if unsure else False), None, None


def save_key(harness, key, base, plan):
    private_dir(SECRETS)
    write_private(SECRETS / f"{harness}-key", key + "\n")
    write_private(SECRETS / f"{harness}-key.json", json.dumps({"base": base, "plan": plan, "savedAt": int(time.time())}))
    write_private(private_dir(CRED_RUN) / f"{harness}-key-check.json",
                  json.dumps({"hash": token_hash(key), "ok": True, "at": time.time()}))


def forget_key(harness):
    for name in (f"{harness}-key", f"{harness}-key.json"):
        (SECRETS / name).unlink(missing_ok=True)
    for name in (f"{harness}-key-check.json", f"{harness}-key-models.json"):
        (CRED_RUN / name).unlink(missing_ok=True)
    if "install" in KEYS.get(harness, {}):  # the CLI's own copy of the key goes with it
        (HOMES / f"{harness}-key" / CRED_FILE).unlink(missing_ok=True)


def run_key_check(harness):
    """The model list with the stored key, on the base it was saved for: it
    lists the models and calls none. Returns (True/False/None, None)."""
    key = stored_key(harness)
    if not key: return None, None
    return judge_key_answer(harness, *key_get(harness, key_base(harness), key)), None


# ---------------------------------------------------------------- sign-in checks
# machine.status answers from the last check of each slot (run/<slot>-
# check.json). A due check runs out of band, in a detached `agentctl check
# <slot>` holding run/<slot>-check.lock, so overlapping status calls start at
# most one. No check can change the sign-in that agents use: Claude's token is
# long-lived and never refreshed, Codex is only asked what its auth.json holds,
# `grok models` calls no model, Qwen Code's own class reads its membership, and
# a key's model list calls none either.

def credential(slot):
    """A fingerprint of the stored sign-in of this slot (never the sign-in
    itself), or None."""
    harness = harness_of(slot)
    if slot.endswith("-key"):
        key = stored_key(harness) if harness in KEYS else None
        return token_hash(key) if key else None
    if harness == "claude":
        token = claude_token()
        return token_hash(token) if token else None
    if harness in MEMBER: return member_cred(harness)
    if harness in DEVICE: return device_cred(harness)
    if harness == "antigravity": return agy_cred()
    return None


def last_check(slot):
    """(fingerprint, the last check of that sign-in or {})."""
    cred = credential(slot)
    cache = read_json(CRED_RUN / f"{slot}-check.json", {}) or {}
    return cred, (cache if cred and cache.get("hash") == cred else {})


def check_slot(slot):
    """(True/False/None, account) from the slot's own check."""
    harness = harness_of(slot)
    if slot.endswith("-key"): return run_key_check(harness)
    if harness == "claude": return run_claude_check(claude_token()), None
    if harness in MEMBER: return run_member_check(harness)
    if harness == "antigravity": return run_agy_check(slot)
    return DEVICE_CHECK[harness]()


def run_check(slot, wait=False):
    """Checks the stored sign-in and records the answer. Returns at once if a
    check of this slot is already running, unless `wait`."""
    lock = open(private_dir(CRED_RUN) / f"{slot}-check.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError: return
        cred, old = last_check(slot)
        if not cred: return
        ok, account = check_slot(slot)
        if ok is None: ok = old.get("ok")  # could not tell (offline): the last answer stands
        write_private(CRED_RUN / f"{slot}-check.json",
                      json.dumps({"hash": cred, "ok": ok, "at": time.time(), "account": account or old.get("account")}))
    finally:
        lock.close()


def spawn_check(slot):
    """Starts `agentctl check <slot>` detached; it outlives this request."""
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "check", slot], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def signed_in(slot, wait=None):
    """(signedIn, account): the last check's answer, True, False or None (no
    answer yet). When a check is due one is started, and waited for up to
    `wait` seconds; past that the last answer stands."""
    cred, cache = last_check(slot)
    if not cred: return False, None
    ttl = CHECK_OK_TTL if cache.get("ok") is True else CHECK_FAIL_TTL
    if not cache or time.time() - cache.get("at", 0) >= ttl:
        spawn_check(slot)
        deadline = time.time() + (STATUS_WAIT if wait is None else wait)
        while time.time() < deadline:
            _, new = last_check(slot)
            if new.get("at") != cache.get("at"):
                cache = new
                break
            time.sleep(0.2)
    # Claude Code and Antigravity print the account only when signing in.
    account = (read_json(SECRETS / f"{slot}.json", {}) or {}).get("account") if slot in ("claude", "antigravity") else cache.get("account")
    return cache.get("ok"), account


def known_bad(slot):
    """Cheap, for start and the supervisor (never runs a CLI): no sign-in, or
    the last check rejected this one. A rejection older than KNOWN_BAD_TTL is
    checked again out of band, and stands until that answers."""
    if harness_of(slot) not in SIGN_IN: return False
    cred, cache = last_check(slot)
    if not cred: return True
    if cache.get("ok") is not False: return False
    if time.time() - cache.get("at", 0) > KNOWN_BAD_TTL: spawn_check(slot)
    return True


def slot_ok(slot):
    """Signed in as far as this machine knows now, without running anything."""
    return bool(credential(slot)) and not known_bad(slot)


def default_pays(harness):
    """How a new agent on this harness pays when nobody chose: by subscription
    when that is signed in, else by key when a key is, else by subscription."""
    if harness not in KEYS: return "subscription"
    if slot_ok(harness): return "subscription"
    return "key" if slot_ok(f"{harness}-key") else "subscription"


def checked_pays(harness, pays):
    """A pays setting from a request: "subscription", "key", or "" or None for
    the machine's default now. Refused when this harness has no such way."""
    if pays in (None, ""): return default_pays(harness)
    if pays not in PAYS: fail('pays is "subscription" or "key"')
    if pays == "key" and harness not in KEYS: fail(f"{LABEL.get(harness, harness)} cannot run on an API key here.")
    if pays == "subscription" and harness not in SIGN_IN: fail(f"{LABEL.get(harness, harness)} has no subscription sign-in here.")
    return pays


def forget_device(harness):
    (HOMES / harness / CRED_FILE).unlink(missing_ok=True)
    (CRED_RUN / f"{harness}-check.json").unlink(missing_ok=True)


def machine_status():
    """What this machine can run. Each row: installed, then its subscription
    sign-in as signedIn (true, false, or null when this machine cannot tell),
    account, and signIn: how Buzz signs it in ("code": open a link, paste the
    code back; "device": open a link, approve the code shown, nothing to
    paste) or null with `note`, one sentence why not; and, for a harness that
    also runs on an API key, `key`: {signIn: "key" (open a link, paste the key
    made there), signedIn, account, plan}. An older plugin reads only the
    subscription fields. The sign-in checks run side by side so the reply
    stays quick."""
    import threading
    rows = []
    for hid in HARNESS_ORDER:
        row = {"id": hid, "label": LABEL[hid], "installed": installed(hid), "signedIn": None,
               "account": None, "signIn": SIGN_IN.get(hid)}
        if not row["signIn"]: row["note"] = NO_SIGN_IN[hid]
        if hid in KEYS: row["key"] = {"signIn": "key", "signedIn": None, "account": None, "plan": key_info(hid).get("plan")}
        rows.append(row)

    def check(row):
        try:
            if row["id"] in SIGN_IN: row["signedIn"], row["account"] = signed_in(row["id"])
            if row["id"] in KEYS: row["key"]["signedIn"], row["key"]["account"] = signed_in(f"{row['id']}-key")
        except Exception as e:  # one harness's trouble must not hide the others
            log_line("status", f"{row['id']} check failed: {type(e).__name__}")
        problem = harness_problem(row["id"])
        if problem: row["problem"] = problem
    threads = [threading.Thread(target=check, args=(row,)) for row in rows if row["installed"]]
    for t in threads: t.start()
    for t in threads: t.join(100)
    return {"ok": True, "machine": machine_name(), "harnesses": rows}


def machine_name():
    name = (read_json(ROOT / "machine.json", {}) or {}).get("name")
    return name or socket.gethostname().split(".")[0]


# ---------------------------------------------------------------- health
# Whether a harness can run here, cheap enough for machine.status and start:
# the installed versions against pins.json, and buzz-acp's own ACP initialize
# with the harness's adapter (`buzz-acp auth-methods`), remembered until either
# program changes. `doctor` adds the machine-wide checks.

ADAPTER_PACKAGE = {"claude": "@agentclientprotocol/claude-agent-acp", "codex": "@agentclientprotocol/codex-acp"}


def vendored_version(link, name):
    """The version in a vendored program's folder: vendor/<name>-<version>/..."""
    found = re.search(rf"/{name}-(\d[^/]*)/", os.path.realpath(link))
    return found.group(1) if found else None


def npm_version(*parts, folder="acp"):
    """The version of a package npm installed under vendor/<folder>."""
    return (read_json(VENDOR / folder / "node_modules" / Path(*parts) / "package.json", {}) or {}).get("version")


def version_problems(harness):
    pins = read_json(PINS)
    if not pins: return []  # doctor reports a missing pins.json once
    out = []
    def want(what, have, pinned):
        if have != pinned: out.append(f"{what} is {have or 'missing'}, pinned {pinned}")
    want("buzz-acp", vendored_version(BIN / "buzz-acp", "buzz"), pins["harness"]["release"])
    package = ADAPTER_PACKAGE.get(harness)
    if package:
        pin = pins["adapters"][package]
        want(package, npm_version(package), pin["version"])
        sdk = npm_version(package, "node_modules", "@agentclientprotocol", "sdk") or npm_version("@agentclientprotocol", "sdk")
        want("its ACP SDK", sdk, pin["sdk"])
    if harness == "codex":
        want("@openai/codex", npm_version("@openai/codex"), pins["clis"]["@openai/codex"]["version"])
        # codex-acp falls back to its sandboxed mode, silently, on a mode it does not know.
        adapter = VENDOR / "acp" / "node_modules" / ADAPTER_PACKAGE["codex"] / "dist" / "index.js"
        if adapter.exists() and f'"{FULL_ACCESS["codex"]["INITIAL_AGENT_MODE"]}"' not in adapter.read_text(errors="replace"):
            out.append(f"{ADAPTER_PACKAGE['codex']} has no {FULL_ACCESS['codex']['INITIAL_AGENT_MODE']} mode")
    if harness == "grok": want("grok", vendored_version(BIN / "grok", "grok"), pins["clis"]["grok"]["version"])
    if harness == "antigravity":
        want("antigravity", vendored_version(BIN / "agy", "antigravity"), pins["clis"]["antigravity"]["version"])
    if harness == "qwen":
        want("@qwen-code/qwen-code", npm_version("@qwen-code", "qwen-code", folder="qwen-code"), pins["clis"]["@qwen-code/qwen-code"]["version"])
        if not account_script().exists(): out.append(f"bin/{ACCOUNT_SCRIPT} is missing")
        elif not node_cli(): out.append("node is missing")
        elif qwen_exports_session() is False: out.append("this Qwen Code has no QwenSubscriptionSession for the membership sign-in")
    return out


def qwen_exports_session():
    """Whether the pinned Qwen Code's chunks export QwenSubscriptionSession,
    which qwen-account.mjs drives: a file scan, remembered per package (its
    package.json's path and time) in run/qwen-export.json. None: no package."""
    package = qwen_package() / "package.json"
    try: stamp = f"{os.path.realpath(package)}:{package.stat().st_mtime}"
    except OSError: return None
    cache = read_json(RUN / "qwen-export.json", {}) or {}
    if cache.get("stamp") == stamp: return cache.get("ok")
    ok = False
    chunks = qwen_package() / "chunks"
    for name in sorted(os.listdir(chunks)) if chunks.is_dir() else []:
        if not name.endswith(".js"): continue
        text = (chunks / name).read_text(errors="replace")
        if "QwenSubscriptionSession=class" in text and re.search(r"export\{[^}]*\bQwenSubscriptionSession\b", text):
            ok = True
            break
    write_private(private_dir(RUN) / "qwen-export.json", json.dumps({"stamp": stamp, "ok": ok}))
    return ok


def handshake(harness):
    """None when buzz-acp completes ACP initialize with this harness's adapter,
    else one line why. A success is remembered until buzz-acp or the adapter
    changes; a failure is checked again next time."""
    command, args = HARNESS[harness]
    if harness == "antigravity": args = agy_args(slot_home("antigravity"))
    found = shutil.which(command, path=agent_path())
    if not (BIN / "buzz-acp").exists(): return "buzz-acp is not installed"
    if not found: return f"{command} is not installed"
    stamp = "|".join(f"{os.path.realpath(p)}:{os.stat(p).st_mtime}" for p in (BIN / "buzz-acp", found))
    cache = RUN / f"{harness}-handshake.json"
    if (read_json(cache, {}) or {}).get("stamp") == stamp: return None
    env = harness_env(harness)
    try:
        done = subprocess.run([str(BIN / "buzz-acp"), "auth-methods", "--json", "--agent-command", command, f"--agent-args={args}"],
                              env=env, cwd=private_dir(RUN), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return f"{command} did not answer buzz-acp's ACP handshake within 30 s"
    try: answer = json.loads(done.stdout)
    except ValueError: answer = None
    if done.returncode != 0 or not isinstance(answer, dict) or "methods" not in answer:
        last = (done.stderr.strip().splitlines() or ["no answer"])[-1][:200]
        return f"{command} failed buzz-acp's ACP handshake: {last}"
    write_private(cache, json.dumps({"stamp": stamp}))
    return None


def harness_problem(harness):
    """One line saying why this harness cannot run an agent here, or None.
    Signing in is not a problem here; machine.status reports it apart."""
    try: problems = version_problems(harness)
    except (KeyError, TypeError, AttributeError): problems = ["pins.json is not readable; run machine/deploy.sh again"]
    return "; ".join(problems) or handshake(harness)


def supervisor_pid():
    pid = (read_json(RUN / "supervisor.json", {}) or {}).get("pid")
    if not pid: return None
    try: os.kill(pid, 0)
    except OSError: return None
    return pid if "agentctl" in process_command(pid) else None


def doctor():
    """Whether this machine can run an agent now, in one reply: machine.status
    with each harness's `problem` and `ready`, plus the connector, the cron
    lines, the supervisor, free disk and each activated agent. `healthy` is
    false when the install itself is wrong (deploy.sh fails on it); a harness
    that only needs signing in leaves it true."""
    status = machine_status()
    problems = [] if read_json(PINS) else ["pins.json is missing; run machine/deploy.sh again."]
    for row in status["harnesses"]:
        if row["id"] in PINNED and not row["installed"]: problems.append(f"{row['label']} is not installed.")
        if row["id"] in PINNED and row.get("problem"): problems.append(f"{row['label']}: {row['problem']}.")
        # Ready: an agent can run on it now, on its subscription or its key.
        row["ready"] = bool(row["installed"] and (row["signedIn"] or (row.get("key") or {}).get("signedIn")) and not row.get("problem"))
        row["access"] = ACCESS[row["id"]]
        if row["id"] in DEFAULTS and row["installed"]:
            # What a new agent runs, paying the way a new one would here: from
            # the caches, so doctor stays cheap.
            row["pays"] = default_pays(row["id"])
            picked = choice(row["id"], {"pays": row["pays"]})
            row["model"], row["effort"] = picked.get("model"), picked.get("effort")
            row["modelsChecked"] = picked.get("checked", True)
            if picked.get("note"): row["modelNote"] = picked["note"]
    connector = os.access(BLACK4_MCP, os.X_OK)
    if not connector: problems.append("The Black 4 connector (mcp/black4) is missing; run machine/deploy.sh again.")
    active = [d for d in agent_dirs() if read_settings(d).get("auth")]
    lines = read_crontab()
    cron = "present" if all(line in lines for line in cron_lines()) else ("missing" if active else "not needed")
    if cron == "missing": problems.append("The cron lines that bring agents back after a reboot are missing; start any agent to restore them.")
    free = shutil.disk_usage(ROOT if ROOT.exists() else HOME).free / 1e9
    if free < DISK_MIN_GB: problems.append(f"Only {free:.1f} GB of disk is free.")
    agents = [{"pubkey": d.name, "name": read_settings(d).get("name"), "running": bool(running(d)),
               "keepsStopping": keeps_stopping(d)} for d in active]
    return {**status, "healthy": not problems, "problems": problems, "connector": connector, "cron": cron,
            "supervisor": bool(supervisor_pid()), "diskFreeGB": round(free, 1), "agents": agents}


def print_doctor():
    """`agentctl doctor`: the same checks for a person (deploy.sh runs it).
    Exits 1 when the install is not healthy. No account or key is printed."""
    r = doctor()
    for row in r["harnesses"]:
        if not row["installed"]: continue
        state = "ready" if row["ready"] else row.get("problem") or (
            "signed out" if row["signedIn"] is False else "cannot be signed in from Buzz" if not row["signIn"] else "sign-in unknown")
        if row.get("key"):
            said = {True: "signed in", False: "signed out", None: "unknown"}
            state += f" (subscription {said[row['signedIn']]}, API key {said[row['key']['signedIn']]})"
        model = (f"; new agents run {row['model'] or 'its own default'}" + (f" at {row['effort']} effort" if row.get("effort") else "")
                 + (f" on the {row['pays']}" if row.get("pays") else "")
                 + ("" if row.get("modelsChecked", True) else " (not checked yet)")) if "model" in row else ""
        print(f"  {row['label']}: {state}; {row['access']}{model}")
        if row.get("modelNote"): print(f"  {row['label']}: {row['modelNote']}")
    print(f"  Black 4 connector: {'present' if r['connector'] else 'missing'}; cron: {r['cron']}; "
          f"supervisor: {'running' if r['supervisor'] else 'not running'}; disk free: {r['diskFreeGB']} GB")
    for a in r["agents"]:
        print(f"  agent {a['pubkey'][:8]}: {'running' if a['running'] else 'stopped'}{', keeps stopping' if a['keepsStopping'] else ''}")
    for p in r["problems"]: print(f"PROBLEM: {p}")
    print("doctor: healthy" if r["healthy"] else "doctor: NOT healthy")
    return 0 if r["healthy"] else 1


# ---------------------------------------------------------------- heartbeat
# An agent with a heartbeat wakes every N minutes and asks Black 4 what is due.
# What it does lives in Platform Control (each job's schedule), never here:
# this holds only whether it wakes and how often.

HEARTBEAT_MIN, HEARTBEAT_MAX = 5, 1440


def heartbeat_minutes(s):
    minutes = s.get("heartbeat")
    return minutes if isinstance(minutes, int) and not isinstance(minutes, bool) and HEARTBEAT_MIN <= minutes <= HEARTBEAT_MAX else 0


HEARTBEAT_PROMPT_MAX = 8000

DEFAULT_HEARTBEAT_PROMPT = """Black 4 heartbeat: run whatever standing job is due for you.

1. Call the Black 4 tool start_next_standing_run with agent "{name}" and model {model}. If your tool list does not show it, find it with your tool search (for example tool_search "select:mcp__black4__start_next_standing_run") and run it through your tool caller, or call it through the Black 4 call_tool (name and arguments). If due is false, end your turn and post nothing.
2. Otherwise do the run completely, exactly as its instructions say, for every business marked run: read its skills and goals, do the work, and publish what it asks for. Post in Buzz only where the instructions say (buzz messages send).
3. Finish with finish_standing_run (the same way): runId, agent "{name}", model {model}, and businesses: one entry per business marked run, each with businessId, outcome (done, no_action or failed), a one-line summary and its reviewIds. Use failed only when you truly cannot do the work, and say why. End the run's summary with your context setting ({compact}) and, if your harness shows them, the tokens this run used.
4. Call start_next_standing_run again and repeat. Do not start another run after 30 minutes of work, but never close a run undone to move on.
"""


def heartbeat_prompt(s):
    custom = (s.get("heartbeatPrompt") or "").strip()
    if custom: return custom + "\n"
    name = (s.get("name") or "a Black 4 agent").replace('"', "'")
    model = (s.get("model") or "").replace('"', "'")
    compact_at = s.get("compactAt") if isinstance(s.get("compactAt"), int) and not isinstance(s.get("compactAt"), bool) else None
    compact = f"compact at {compact_at:,} tokens" if compact_at else "compaction at your harness's default"
    return DEFAULT_HEARTBEAT_PROMPT.format(name=name, model=f'"{model}"' if model else "(your exact model id)", compact=compact)


def exact_model(picked):
    """The model an agent runs, for its heartbeat, when that is an exact id;
    an alias such as opus is left for the agent to name exactly."""
    model = picked.get("model") or ""
    return model if "-" in model else ""


def heartbeat_view(s):
    """What the agent form shows: on or off, how often, and what each heartbeat does."""
    s = {**s, "model": exact_model(choice(s.get("harness") or "claude", s))}
    return {"heartbeat": heartbeat_minutes(s), "prompt": heartbeat_prompt(s).strip(),
            "custom": bool((s.get("heartbeatPrompt") or "").strip()),
            "defaultPrompt": heartbeat_prompt({**s, "heartbeatPrompt": ""}).strip()}


# ---------------------------------------------------------------- buzz-acp's own levers, per agent
# What buzz-acp 0.5.30 takes from the environment, as each agent's setting
# (None: buzz-acp's own default): how many model processes run in parallel,
# one session per channel or per thread, what a new @mention does to a turn
# in flight, a fresh session after so many turns, the longest a turn may run
# (seconds), and how many earlier messages come along as context. A heartbeat
# agent keeps at least two parallel processes, so a person can still talk to
# it while a scheduled run is going.

# ---------------------------------------------------------------- whom an agent answers
# Black 4 has one Buzz community for staff and customers (Joey, 2026-11-17),
# so every agent serves exactly one audience (respondTo):
#   staff       Black 4 staff only. The default for every new agent.
#   business    staff, plus the people linked to one customer business
#               (businessId). What an account manager runs.
#   owner-only  its owner only (and the owner's other agents).
#   anyone      everyone in the community. Only for an agent that holds no
#               business data, and only ever chosen in settings.set: a
#               provision or activate that says "anyone" (what plugins before
#               this one sent as their default) gets staff.
# staff and business run buzz-acp's allowlist gate with the keys Platform
# Control's get_buzz_audience names for this agent, asked signed as the agent
# through its Black 4 connector (`mcp/black4 --call`), at its start and about
# every 10 minutes (the supervisor). The answer is kept in
# agents/<pubkey>/audience.json; a failed refresh keeps the last good one, and
# an agent with none at all starts owner-only (closed, never open). A changed
# list restarts the agent at once when idle, else once no turn is in flight:
# buzz-acp reads the list once, at its start (see "a mention the gate drops"). Until Platform Control has the tool (it answers that it has none),
# staff.json, the machine's static staff list, stands in for its staff keys.
#
# What buzz-acp 0.5.30 does with it (crates/buzz-acp/src/lib.rs,
# author_allowed): channel messages and their threads pass the gate when the
# author is listed, is the owner, or is a sibling (an agent whose NIP-OA owner
# is this agent's owner). Direct messages ignore the list in every mode but
# nobody: only the owner and siblings get a DM answered. So staff reach a
# staff agent by @mention in a channel or thread, not by DM, unless they own it.
RESPOND_TO = ("staff", "business", "owner-only", "anyone")
AUDIENCE_MODES = ("staff", "business")       # the modes that ask Platform Control
NEW_RESPOND_TO = "staff"
AUDIENCE_TOOL = "get_buzz_audience"
AUDIENCE_EVERY = 10 * 60      # a running agent's list is asked again this often
AUDIENCE_RETRY = 60           # an agent that has none is asked again this often
AUDIENCE_FRESH = 60           # a start this soon after an answer does not ask again
AUDIENCE_TIMEOUT = 20         # seconds one ask may take
BUSINESS_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$")


def respond_to(s):
    """Whom the saved settings say the agent answers. An agent saved before
    there was a choice answers its owner only."""
    mode = s.get("respondTo")
    return mode if mode in RESPOND_TO else "owner-only"


def checked_audience(mode, business_id, explicit_anyone=True):
    """(respondTo, businessId) from a request, refused when it does not hold
    together. `explicit_anyone` False turns "anyone" into staff (provision and
    activate, where an older plugin sent it as its default)."""
    if mode in (None, ""): mode = NEW_RESPOND_TO
    if mode == "anyone" and not explicit_anyone: mode = NEW_RESPOND_TO
    if mode not in RESPOND_TO: fail("respondTo is staff, business, owner-only or anyone")
    if mode == "business":
        if not isinstance(business_id, str) or not BUSINESS_ID.fullmatch(business_id):
            fail("an agent that answers a business needs that business's id (businessId)")
        return mode, business_id
    return mode, None


def staff_list():
    """The machine's static staff keys (staff.json), or None when it has none."""
    data = read_json(STAFF_FILE)
    rows = data.get("staff") if isinstance(data, dict) else None
    if not isinstance(rows, list): return None
    keys = [str(r.get("pubkey")) for r in rows if isinstance(r, dict) and HEX64.match(str(r.get("pubkey") or ""))]
    return keys or None


def audience_entries(result):
    """The people in a get_buzz_audience result ({keys: [{pubkey, email, kind,
    businessId?}], asOf}), as (entries, asOf). Only what the gate needs is
    kept: no emails. None when the answer is not that shape."""
    data = result.get("structuredContent") if isinstance(result, dict) else None
    if not isinstance(data, dict) and isinstance(result, dict):
        for part in result.get("content") or []:
            if isinstance(part, dict) and part.get("type") == "text":
                try: data = json.loads(part.get("text") or "")
                except ValueError: continue
                break
    if isinstance(data, dict) and isinstance(data.get("data"), dict): data = data["data"]
    if not isinstance(data, dict) or not isinstance(data.get("keys"), list): return None
    entries = []
    for row in data["keys"]:
        if not isinstance(row, dict) or not HEX64.match(str(row.get("pubkey") or "")): continue
        if row.get("kind") not in ("staff", "customer"): continue
        entry = {"pubkey": row["pubkey"], "kind": row["kind"]}
        if row["kind"] == "customer":
            if not isinstance(row.get("businessId"), str): continue
            entry["businessId"] = row["businessId"]
        entries.append(entry)
    as_of = data.get("asOf") if isinstance(data.get("asOf"), (str, int, float)) else None
    return entries, as_of


def audience_keys(s, entries):
    """The keys an agent with these settings answers, from a list's entries:
    staff for staff; staff and that business's people for business."""
    mode, business = respond_to(s), s.get("businessId")
    keys = [e["pubkey"] for e in entries if e.get("kind") == "staff"]
    if mode == "business" and business:
        keys += [e["pubkey"] for e in entries if e.get("kind") == "customer" and e.get("businessId") == business]
    return sorted(set(keys))


def ask_black4(d, s, tool):
    """One Black 4 tool call signed as this agent, through its connector
    (`mcp/black4 --call`): ("ok", result), ("missing", why) when the server
    has no such tool for it, or ("failed", why)."""
    if not os.access(BLACK4_MCP, os.X_OK): return "failed", "this machine has no Black 4 connector"
    if not s.get("auth"): return "failed", "the agent has no owner attestation yet"
    env = {**base_env(), "BUZZ_PRIVATE_KEY": (d / "key").read_text().strip(), "BUZZ_AUTH_TAG": json.dumps(s["auth"]),
           "BLACK4_MCP_TIMEOUT_MS": str(AUDIENCE_TIMEOUT * 1000)}
    if (s.get("name") or "").strip(): env["BUZZ_ACP_DISPLAY_NAME"] = s["name"].strip()
    try:
        done = subprocess.run([str(BLACK4_MCP), "--call", tool], env=env, input="{}", capture_output=True,
                              text=True, timeout=AUDIENCE_TIMEOUT + 10, cwd=str(d))
    except (OSError, subprocess.TimeoutExpired) as e:
        return "failed", f"the Black 4 connector did not answer ({type(e).__name__})"
    reply = None
    for line in reversed((done.stdout or "").strip().splitlines()):
        try: reply = json.loads(line); break
        except ValueError: continue
    if not isinstance(reply, dict): return "failed", "the Black 4 connector gave no answer"
    if reply.get("ok"): return "ok", reply.get("result")
    detail = str(reply.get("detail") or reply.get("kind") or "no detail")[:200]
    # An agent whose business seat ended: Platform Control refuses it (401
    # agent_unseated) rather than let it act as its owner. Not a passing failure.
    if reply.get("code") == "agent_unseated": return "unseated", detail
    return ("missing" if reply.get("kind") == "missing" else "failed"), detail


def ask_audience(d, s):
    """Asks Platform Control, signed as this agent, whom it may answer:
    ("ok", entries, asOf), ("missing", None, why) when the server has no such
    tool yet, ("unseated", None, why) when its business seat ended, or
    ("failed", None, why). Staff entries may come without an email; only the
    public key counts."""
    status, value = ask_black4(d, s, AUDIENCE_TOOL)
    if status != "ok": return status, None, value
    parsed = audience_entries(value)
    if parsed is None: return "failed", None, "Platform Control's audience was not a list of keys"
    return "ok", parsed[0], parsed[1]


def audience_state(d):
    return read_json(d / "audience.json", {}) or {}


def refresh_audience(d, restart=True):
    """Asks for this agent's list and keeps the answer. A failure keeps the
    last good list. With `restart`, a running agent whose keys changed is
    restarted after its turn. One at a time per agent; returns the state."""
    s = read_settings(d)
    if respond_to(s) not in AUDIENCE_MODES: return audience_state(d)
    lock = open(d / "audience.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError: return audience_state(d)
        state = audience_state(d)
        status, entries, detail = ask_audience(d, s)
        now = time.time()
        # The static staff list stands in only while Platform Control has never
        # answered this agent: a kept Platform list outranks it.
        if status == "missing" and staff_list() and state.get("source") != "platform":
            entries, detail, source = [{"pubkey": k, "kind": "staff"} for k in staff_list()], None, "machine"
            status = "ok"
        else:
            source = "platform"
        if status == "ok":
            state = {"entries": entries, "source": source, "asOf": detail if source == "platform" else None,
                     "at": now, "tried": now}
        elif status == "unseated":
            # Its seat ended: no list any more, so it answers its owner only
            # (and a customer-facing agent does not start again: its seat check fails).
            state = {"tried": now, "error": "unseated: " + str(detail), "unseated": True}
        else:
            state = {**state, "tried": now, "error": detail}
        write_private(d / "audience.json", json.dumps(state))
    finally:
        lock.close()
    if restart and running(d) and not applying(d):
        launched = read_json(d / "launch.json") or {}
        if isinstance(launched, dict) and launched.get("audience") != audience_launch(s, state)["fingerprint"]:
            # Idle: at once (a revoked key stops at once). Mid-turn: after it.
            if turns_in_flight(d) == 0:
                try: log_line("supervisor", f"audience of {d.name[:8]} changed; restarted it: pid {start(d)}")
                except Exception as e: log_line("supervisor", f"audience of {d.name[:8]} changed; restart failed: {str(e)[:200]}")
            else:
                log_line("supervisor", f"audience of {d.name[:8]} changed; restarting it once no turn is in flight")
                defer_apply(d, audience=True)
    return state


def audience_launch(s, state=None):
    """What buzz-acp's gate runs with for these settings and this list:
    {"respondTo": buzz-acp's mode, "keys": [...], "fingerprint"}."""
    mode = respond_to(s)
    if mode == "anyone": gate, keys = "anyone", []
    elif mode in AUDIENCE_MODES:
        keys = audience_keys(s, (state or {}).get("entries") or [])
        gate = "allowlist" if keys else "owner-only"  # none at all: closed, never open
    else: gate, keys = "owner-only", []
    fingerprint = hashlib.sha256(json.dumps([gate, keys]).encode()).hexdigest()[:16]
    return {"respondTo": gate, "keys": keys, "fingerprint": fingerprint}


def audience_due(d, now=None):
    state = audience_state(d)
    now = now or time.time()
    every = AUDIENCE_EVERY if state.get("entries") is not None else AUDIENCE_RETRY
    return now - (state.get("tried") or 0) >= every


def spawn_audience(d):
    """Starts `agentctl audience <pubkey>` detached; it outlives the supervisor's pass."""
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "audience", d.name], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def audience_view(d, s):
    """What list and status say about whom an agent answers: its choice, the
    gate it runs (or would start) with, how many keys, from where and when."""
    mode = respond_to(s)
    view = {"respondTo": mode, **({"businessId": s.get("businessId")} if mode == "business" else {})}
    state = audience_state(d) if mode in AUDIENCE_MODES else {}
    launched = read_json(d / "launch.json") if running(d) else None
    gate = (launched or {}).get("gate") if isinstance(launched, dict) and launched.get("gate") else audience_launch(s, state)
    view["gate"] = gate.get("respondTo")
    view["keys"] = len(gate.get("keys") or []) if isinstance(gate.get("keys"), list) else gate.get("keys")
    if mode in AUDIENCE_MODES:
        view["source"] = state.get("source") if state.get("entries") is not None else None
        if state.get("asOf"): view["asOf"] = state["asOf"]
        if state.get("at"): view["checkedAt"] = int(state["at"])
        if state.get("error") and (state.get("tried") or 0) > (state.get("at") or 0): view["lastError"] = state["error"]
    unheard = unheard_view(d)
    if unheard: view["unheard"] = unheard
    return view


def audience_line(name, view):
    """One line of `agentctl list`: whom the agent answers and how."""
    mode = view["respondTo"] + (f" {view['businessId']}" if view.get("businessId") else "")
    if view.get("gate") == "allowlist": how = f"allow-list of {view.get('keys')} from {view.get('source') or '?'}"
    elif view["respondTo"] in AUDIENCE_MODES: how = "owner-only until a list arrives"
    else: how = view.get("gate")
    unheard = view.get("unheard")
    heard = f"; {unheard['count']} unheard today" + (f", {unheard['waiting']} heard after its restart" if unheard.get("waiting") else "") if unheard else ""
    return f"{name}: {mode} ({how}){heard}"


# ---------------------------------------------------------------- a mention the gate drops
# buzz-acp 0.5.30 reads its allowlist once, into its Config, and has no reload
# (no signal, no file it watches: crates/buzz-acp/src/config.rs and lib.rs),
# and a SIGTERM cancels the turns in flight after 30 s. So a newly linked
# person is heard only after a restart, and the restart waits until no turn
# is in flight (APPLY_WAIT at most, then the hard way; see "an agent changing
# itself"). Its author gate drops everyone else's event with one INFO line,
#   buzz_acp::inbound_author_gate: inbound author gate — dropping event
#   channel_id=<uuid> raw_author=<hex> effective_author=<hex> mode=<gate> is_dm=<bool>
# and nothing else: no reaction, no reply. The supervisor reads those lines
# from agent.log (drops.json keeps where it is, the last day's drops for the
# owner to see, and those not yet handled) and starts `agentctl dropped
# <pubkey>`, at most once per DROP_EVERY, which
#   - asks Platform Control for the list again unless it just did (one ask,
#     as signed as the agent as every ask), so a person who has just linked
#     their key is not left waiting for the 10-minute refresh. Every ask is a
#     whole refresh: a removal takes effect at least as fast as before.
#   - says one line from the runner (the stock buzz CLI, as the agent, a
#     thread reply to the dropped message; never the model) only to a person
#     Platform Control names for this agent, at most once per person per
#     SIGN_EVERY: someone just linked, behind a gate that has not restarted
#     yet (SIGN_SOON), or someone it serves who mentioned it in a direct
#     message, which buzz-acp answers from its owner only (SIGN_DM). Only a
#     message that mentions the agent gets a line. A drop by someone not on
#     the kept list waits (DROP_PATIENCE at most) for a list asked after it,
#     so a skipped or failed ask is tried again. Anyone else, an
#     unlinked key, a customer of another business, another agent, gets
#     nothing: the runner cannot tell them apart and never says who is on
#     the list. Their drops show in status and list ("unheard").
DROP_LINE = re.compile(rb"^(\S+)\s.*inbound author gate .{1,4} dropping event channel_id=(\S+) raw_author=([0-9a-f]{64}) "
                       rb"effective_author=([0-9a-f]{64}) mode=\S+ is_dm=(true|false)")
DROP_EVERY = 60            # seconds between `agentctl dropped` runs for one agent
DROP_REFRESH = 60          # a list asked this recently is not asked again for a drop
DROP_KEEP = 24 * 3600      # how long status shows a drop
DROP_PATIENCE = 15 * 60    # a drop waits this long at most for a list asked after it
SIGN_EVERY = 6 * 3600      # at most one line per person and kind this often
DROP_FIND = 180            # seconds around a drop the dropped message is looked for
SIGN_SOON = "I can't pick up that message, but I will be able to in a few minutes. Mention me again then."
SIGN_DM = "I answer direct messages from my owner only. Mention me in a channel or a thread instead."


def log_stamp(text):
    """Unix seconds of a log line's RFC 3339 UTC stamp, or None."""
    try: return float(calendar.timegm(time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S")))
    except (TypeError, ValueError):
        return None


def drops_state(d):
    return read_json(d / "drops.json", {}) or {}


@contextlib.contextmanager
def drops_lock(d):
    """Held for each read-modify-write of drops.json, by the supervisor and
    `agentctl dropped` alike (briefly: never across a network call)."""
    with open(d / "drops.state.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def watch_drops(d, now=None):
    """Reads what agent.log gained since the last look for the gate's drops.
    Returns whether a drop is waiting to be handled. The first look starts at
    the log's end: a drop from before the watch is not answered."""
    now = now or time.time()
    with drops_lock(d): return _watch_drops(d, now)


def _watch_drops(d, now):
    state = drops_state(d)
    size = log_size(d)
    if "offset" not in state:
        write_private(d / "drops.json", json.dumps({"offset": size, "events": [], "pending": []}))
        return False
    offset = state["offset"] if isinstance(state.get("offset"), int) and state["offset"] <= size else 0  # cut over: from the start
    found = []
    if size > offset:
        try:
            with open(d / "agent.log", "rb") as f:
                f.seek(offset); chunk = f.read(size - offset)
        except OSError:
            chunk = b""
        whole = chunk.rfind(b"\n") + 1  # a line still being written is read next time
        for line in chunk[:whole].split(b"\n"):
            m = DROP_LINE.match(ANSI.sub(b"", line))
            if m:
                found.append({"at": log_stamp(m.group(1).decode(errors="replace")) or now, "channel": m.group(2).decode(errors="replace"),
                              "author": m.group(4).decode(), "dm": m.group(5) == b"true"})
        offset += whole
    if found or offset != state.get("offset"):
        events = [e for e in (state.get("events") or []) + found if isinstance(e, dict) and now - (e.get("at") or 0) < DROP_KEEP][-50:]
        pending = ((state.get("pending") or []) + found)[-20:]
        state = {**state, "offset": offset, "events": events, "pending": pending}
        write_private(d / "drops.json", json.dumps(state))
    return bool(state.get("pending"))


def spawn_dropped(d):
    """Starts `agentctl dropped <pubkey>` detached; it outlives the supervisor's pass."""
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "dropped", d.name], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def runner_buzz(d, s, args, timeout=20):
    """The stock buzz CLI as this agent, on its community: parsed JSON, or None."""
    buzz = BIN / "buzz"
    if not os.access(buzz, os.X_OK) or not s.get("auth") or "://" not in (s.get("community") or ""): return None
    env = {**base_env(), "BUZZ_PRIVATE_KEY": (d / "key").read_text().strip(), "BUZZ_AUTH_TAG": json.dumps(s["auth"]),
           "BUZZ_RELAY_URL": "https://" + s["community"].split("://", 1)[1], "BUZZ_OUTPUT_FORMAT": "json"}
    try:
        done = subprocess.run([str(buzz), *args], env=env, capture_output=True, text=True, timeout=timeout, cwd=str(d))
    except (OSError, subprocess.TimeoutExpired):
        return None
    if done.returncode != 0: return None
    try: parsed = json.loads(done.stdout or "null")
    except ValueError: parsed = None
    return True if parsed is None else parsed  # exit 0 is done, whatever it printed


def dropped_message(d, s, drop):
    """The id of the message a drop was about: the author's latest in that
    channel around the drop's time that mentions this agent. None when it
    cannot be found."""
    at = int(drop.get("at") or 0)
    rows = runner_buzz(d, s, ["messages", "get", "--channel", drop["channel"], "--since", str(at - DROP_FIND), "--limit", "100"])
    best = None
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict) or row.get("pubkey") != drop["author"] or not HEX64.match(str(row.get("id") or "")): continue
        when = row.get("created_at") if isinstance(row.get("created_at"), (int, float)) else None
        if when is None or not at - DROP_FIND <= when <= at + 5: continue
        # Only a message that names the agent: never a line into a conversation
        # (a group direct message too) that was not addressed to it.
        if not any(isinstance(tag, list) and tag[:2] == ["p", d.name] for tag in row.get("tags") or []): continue
        if best is None or when >= best[0]: best = (when, row["id"])
    return best[1] if best else None


def handle_dropped(d):
    """`agentctl dropped <pubkey>`: what the gate dropped since the last run,
    once (see "a mention the gate drops"). One at a time per agent. A drop by
    someone not on the kept list stays pending until a list asked after it
    has arrived, so a skipped or failed ask is tried again on the next run."""
    lock = open(d / "drops.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError: return
        with drops_lock(d):
            pending = [p for p in drops_state(d).get("pending") or [] if isinstance(p, dict) and HEX64.match(str(p.get("author") or ""))]
        if not pending: return
        s = read_settings(d)
        now = time.time()
        listed = respond_to(s) in AUDIENCE_MODES
        audience = audience_state(d)
        keys = set(audience_keys(s, audience.get("entries") or [])) if listed else set()
        # Someone not on the kept list may have just been added: ask now
        # (a changed list restarts the agent: at once when idle, else once no
        # turn is in flight). A listed person's direct message needs no ask.
        if listed and any(p["author"] not in keys for p in pending) and now - (audience.get("tried") or 0) >= DROP_REFRESH:
            audience = refresh_audience(d)
            keys = set(audience_keys(s, audience.get("entries") or []))
        answered = audience.get("at") or 0  # when the kept list last came back
        done, keep = [], []
        for p in pending:
            # (The 10-minute refresh covers one older than DROP_PATIENCE.)
            if listed and p["author"] not in keys and answered < (p.get("at") or 0) and now - (p.get("at") or 0) < DROP_PATIENCE: keep.append(p)
            else: done.append(p)
        latest = {}
        for p in done: latest[(p["author"], bool(p.get("dm")))] = p  # one line per person and kind
        # Only `agentctl dropped` writes signed.json, under drops.lock.
        signed = {k: v for k, v in (read_json(d / "signed.json", {}) or {}).items() if isinstance(v, (int, float)) and now - v < SIGN_EVERY}
        served = {}
        for (author, dm), p in latest.items():
            served[author] = author in keys
            if author not in keys or author == d.name: continue
            kind = "dm" if dm else "soon"
            if f"{author}:{kind}" in signed: continue
            event = dropped_message(d, s, p)
            if not event: continue
            # Noted before it is sent: a send that posts and then times out
            # is never sent twice.
            signed[f"{author}:{kind}"] = now
            write_private(d / "signed.json", json.dumps(signed))
            if runner_buzz(d, s, ["messages", "send", "--channel", p["channel"], "--reply-to", event, "--content", SIGN_DM if dm else SIGN_SOON]) is not None:
                log_line("supervisor", f"told {author[:8]} that {d.name[:8]} {'answers its owner only by direct message' if dm else 'will hear them after its restart'}")
        with drops_lock(d):
            state = drops_state(d)  # the supervisor may have added drops meanwhile
            handled = {json.dumps(p, sort_keys=True) for p in done}
            rest = [p for p in state.get("pending") or [] if json.dumps(p, sort_keys=True) not in handled]
            events = [{**e, **({"served": served[e["author"]]} if e.get("author") in served else {})} for e in state.get("events") or [] if isinstance(e, dict)]
            write_private(d / "drops.json", json.dumps({**state, "events": events, "pending": rest}))
    finally:
        lock.close()


def unheard_view(d):
    """What status and list say about the last day's dropped events: how
    many, the last one's time, whether its author is someone the agent serves
    (then it hears them after its restart), and how many such are waiting."""
    events = [e for e in drops_state(d).get("events") or [] if isinstance(e, dict) and time.time() - (e.get("at") or 0) < DROP_KEEP]
    if not events: return None
    last = events[-1]
    # Someone it serves, dropped since its last start: the gate it runs has
    # not got them yet, and gets them at its next restart.
    try: started = (d / "launch.json").stat().st_mtime
    except OSError: started = 0
    waiting = len({e["author"] for e in events if e.get("served") and not e.get("dm") and (e.get("at") or 0) >= started})
    return {"count": len(events), "lastAt": int(last.get("at") or 0), "lastServed": bool(last.get("served")), "waiting": waiting}


CONTROLS = {  # setting -> (buzz-acp's environment variable, int bounds or the allowed values, buzz-acp's default)
    "agents": ("BUZZ_ACP_AGENTS", (1, 8), 1),
    "sessionPolicy": ("BUZZ_ACP_SESSION_POLICY", ("channel", "thread"), "channel"),
    "multipleEventHandling": ("BUZZ_ACP_MULTIPLE_EVENT_HANDLING", ("steer", "queue", "interrupt", "owner-interrupt"), "steer"),
    "maxTurnsPerSession": ("BUZZ_ACP_MAX_TURNS_PER_SESSION", (0, 10000), 0),
    "maxTurnDuration": ("BUZZ_ACP_MAX_TURN_DURATION", (60, 86400), 7200),
    "contextMessageLimit": ("BUZZ_ACP_CONTEXT_MESSAGE_LIMIT", (0, 100), 12),
}


def checked_control(name, value):
    """A control from a request: None or "" for buzz-acp's default, else a
    value within its bounds or among its values."""
    if value in (None, ""): return None
    _, allowed, _ = CONTROLS[name]
    if isinstance(allowed[0], int):
        if isinstance(value, bool) or not isinstance(value, int) or not allowed[0] <= value <= allowed[1]:
            fail(f"{name} is a whole number from {allowed[0]} to {allowed[1]}, or null for buzz-acp's default")
        return value
    if value not in allowed: fail(f"{name} is one of {', '.join(allowed)}, or null for buzz-acp's default")
    return value


def controls_of(s):
    """{setting: value or None} as saved for this agent."""
    return {name: (s.get(name) if s.get(name) not in (None, "") else None) for name in CONTROLS}


def control_env(s):
    """The environment the saved controls set; a heartbeat agent runs at
    least two parallel processes."""
    env = {}
    for name, (var, _, _) in CONTROLS.items():
        value = s.get(name)
        if value not in (None, ""): env[var] = str(value)
    if heartbeat_minutes(s): env["BUZZ_ACP_AGENTS"] = str(max(2, int(env.get("BUZZ_ACP_AGENTS") or 1)))
    return env


def controls_schema():
    return {name: {**({"min": allowed[0], "max": allowed[1]} if isinstance(allowed[0], int) else {"values": list(allowed)}), "default": default}
            for name, (_, allowed, default) in CONTROLS.items()}


# ---------------------------------------------------------------- when an agent compacts its context
# Black 4 tool results are large (a job list or a business's skills ~64k
# characters, the review queue 93k) and sit in context, so on a 1M window a
# harness's own compaction (Qwen Code: 85% of the window) never came and every
# request re-read them all. Each agent has its own compactAt (tokens; None is
# the harness's default), so Joey can experiment, through the lever each
# pinned CLI has per process (checked on the Commerce Mac, 2026-11-17):
#   Claude Code  CLAUDE_CODE_AUTO_COMPACT_WINDOW=<tokens>, 100k to 1M: the
#                window it compacts against (it compacts a little before it).
#   Codex        CODEX_CONFIG model_auto_compact_token_limit (tokens).
#   Grok Build   GROK_AUTO_COMPACT_THRESHOLD_PERCENT, 0 to 100 of the model's
#                context window (from its own cached listing).
#   Qwen Code    context.autoCompactThreshold, a fraction of the model's
#                window (1M for the models it lists), in the workspace
#                settings file of the agent's own working folder
#                (work/.qwen/settings.json; the home's settings.json is shared
#                by every agent on that slot).
# A harness without the lever, or whose window the machine cannot tell yet,
# says so (`compact.note`), and the plugin greys the choice out.

COMPACT_MIN, COMPACT_MAX, COMPACT_DEFAULT = 20_000, 2_000_000, 150_000  # tokens
COMPACT = {
    "claude": {"min": 100_000, "max": 1_000_000},
    "codex": {},
    "grok": {},
    "qwen": {},
    "antigravity": {"max": 1_000_000},
}
QWEN_WINDOW = 1_000_000  # every model Qwen Code 0.27.4 lists for QwenCloud and the membership


def context_window(harness, model):
    """The model's context window in tokens, as far as this machine knows."""
    if harness == "qwen":
        for slot in ("qwen", "qwen-key"):
            for row in (read_json(HOMES / slot / MEMBER["qwen"]["cred"], {}) or {}).get("modelMetadata") or []:
                if isinstance(row, dict) and row.get("id") == model and isinstance(row.get("contextWindowSize"), int): return row["contextWindowSize"]
        return QWEN_WINDOW
    if harness == "grok":
        for slot in ("grok", "grok-key"):
            cache = read_json(HOMES / slot / "models_cache.json")
            info = ((cache or {}).get("models") or {}).get(model, {}).get("info") if isinstance(cache, dict) else None
            if isinstance(info, dict) and isinstance(info.get("context_window"), int): return info["context_window"]
    if harness == "antigravity": return AGY_WINDOW
    return None


def compact_support(harness, model=None):
    """{supported, min, max, default, note}: whether this harness, on this
    model, takes a per-agent compaction setting here."""
    spec = COMPACT.get(harness)
    if spec is None:
        return {"supported": False, "note": f"{LABEL.get(harness, harness)} has no setting for when it compacts its context."}
    out = {"supported": True, "min": spec.get("min", COMPACT_MIN), "max": spec.get("max", COMPACT_MAX), "default": COMPACT_DEFAULT}
    if harness == "grok" and model and context_window(harness, model) is None:
        return {**out, "supported": False, "note": f"The machine does not know {model}'s context window yet; Grok Build lists it after its first run."}
    return out


def checked_compact(harness, value, model=None):
    """A compactAt from a request: None, "" or 0 for the harness's default,
    else tokens within the harness's range. Refused where it cannot apply."""
    if value in (None, "", 0): return None
    if isinstance(value, bool) or not isinstance(value, int): fail("compactAt is a number of tokens, or null for the harness's default")
    support = compact_support(harness, model)
    if not support["supported"]: fail(support["note"])
    if not support["min"] <= value <= support["max"]:
        fail(f"{LABEL[harness]} compacts at {support['min']:,} to {support['max']:,} tokens here.")
    return value


def default_compact(harness, model=None):
    """What a new agent gets: COMPACT_DEFAULT where the harness takes it."""
    return COMPACT_DEFAULT if compact_support(harness, model)["supported"] else None


def compact_levers(harness, model, compact_at, work):
    """What makes the harness compact at `compact_at` tokens: environment
    variables, and for Qwen Code its workspace settings file in `work`
    (written, or our key taken out again for the harness's default)."""
    env = {}
    if harness == "qwen":
        path = work / ".qwen" / "settings.json"
        old = read_json(path, {})
        new = json.loads(json.dumps(old)) if isinstance(old, dict) else {}
        context = new.get("context") if isinstance(new.get("context"), dict) else {}
        if compact_at: context["autoCompactThreshold"] = round(min(1.0, max(0.01, compact_at / context_window("qwen", model))), 4)
        else: context.pop("autoCompactThreshold", None)
        if context: new["context"] = context
        else: new.pop("context", None)
        if new != old:
            if new: private_dir(work / ".qwen"); write_private(path, json.dumps(new, indent=2) + "\n")
            elif path.exists(): path.unlink()
        return env
    if not compact_at: return env
    if harness == "claude": env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = str(compact_at)
    elif harness == "grok":
        window = context_window("grok", model)
        if window: env["GROK_AUTO_COMPACT_THRESHOLD_PERCENT"] = str(min(100, max(1, round(100 * compact_at / window))))
    elif harness == "antigravity": env["AGY_CLI_AUTO_COMPACT_OVERRIDE"] = str(compact_at)  # tokens, up to the window
    return env


# ---------------------------------------------------------------- model and effort
# Each agent may name a model and a reasoning effort; an empty one takes the
# harness's default here, the most capable model its subscription offers at
# high effort (what the owner's own Claude Code runs). Each harness gets them
# through its own lever, read from the pinned programs on the machine:
#   Claude Code  ANTHROPIC_MODEL and CLAUDE_CODE_EFFORT_LEVEL. Both beat any
#                settings file (an agent can write one in its own folder), and
#                take a full model id the adapter's picker does not list.
#                buzz-acp's BUZZ_ACP_MODEL does not: claude-agent-acp 0.94 cannot
#                select claude-fable-5-2, and buzz-acp then keeps the default
#                model without a word. So it is never set.
#   Codex        CODEX_CONFIG (codex-acp's JSON config for every thread it
#                starts): model and model_reasoning_effort.
#   Grok Build   `grok agent --model M --reasoning-effort E ... stdio`.
#   Antigravity  BUZZ_ACP_MODEL as <model>-<effort> (gemini-4-neon-xhigh), an
#                id agy lists itself and sets both from (session/set_model).
#   Qwen Code    `-m M` on the membership; OPENAI_MODEL on a key. No effort:
#                Qwen Code 0.27.4 sends no reasoning_effort for a model it is
#                given this way, whatever its settings say, so the service's
#                own default thinking for the model applies.
# None of them refuses an unknown model or effort before the first turn, so the
# choice is checked here against what the harness offers on the sign-in the
# agent pays with (its slot): the models Codex and Grok cache in their homes
# (they refresh it themselves), for Claude a listing of the adapter's models
# plus a one-line call that proves each default full id answers on this
# sign-in (run/claude-models.json, per token), for the Qwen membership the
# account's own list (qwen-account.mjs models), and for a key the service's
# model list for it (one GET, no model called), each in run/<slot>-models.json.
# A model or effort chosen for an agent that is not offered is refused, at the
# change and at start; a default that is not offered falls back to the next
# one, and status says so (`modelNote`).

DEFAULTS = {  # harness -> (models to try, most capable first; effort, None for a harness with no effort lever)
    "claude": (("claude-fable-5-2", "fable", "opus"), "high"),
    "codex": (("gpt-6-astra", "gpt-6.1-sol"), "high"),
    "grok": (("grok-4.7", "grok-4.6"), "high"),
    # Never qwen4-max-preview: it retires on 2026-11-25.
    "qwen": (("qwen4-max", "qwen3.8-max", "qwen3.8-flash"), None),
    # Carbon is what Gemini offers for "Code & complex work"; Neon and
    # Hydrogen stand in on a plan without it.
    "antigravity": (("gemini-4-carbon", "gemini-4-neon", "gemini-4-hydrogen"), "high"),
}
EFFORT_ORDER = ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra")
MODEL_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:\[\]/-]{0,79}$")
EFFORT_ID = re.compile(r"^[a-z]{1,16}$")
CLAUDE_MODELS_TTL = 24 * 3600  # the Claude listing is made again after this
CLAUDE_MODELS_FAIL_TTL = 10 * 60  # a failed one is tried again after this, doubling
CLAUDE_MODELS_FAIL_MAX = 6 * 3600  # up to this
MODELS_WAIT = 8.0  # the models op waits this long for a Claude listing under way


def effort_sorted(levels):
    rank = {e: i for i, e in enumerate(EFFORT_ORDER)}
    seen = [e for e in dict.fromkeys(levels) if isinstance(e, str) and EFFORT_ID.match(e)]
    return sorted(seen, key=lambda e: rank.get(e, len(rank)))


def codex_models(home=None):
    """Codex's own cached listing (models_cache.json in its home), listed rows
    only, in Codex's order; None when Codex has not fetched one yet."""
    cache = read_json((home or HOMES / "codex") / "models_cache.json")
    if not isinstance(cache, dict) or not isinstance(cache.get("models"), list): return None
    rows = sorted((m for m in cache["models"] if isinstance(m, dict) and m.get("visibility") == "list" and m.get("slug")),
                  key=lambda m: m.get("priority") or 0)
    rows = [m for m in rows if isinstance(m["slug"], str) and MODEL_ID.match(m["slug"])]
    return [{"id": m["slug"], "label": m.get("display_name") or m["slug"],
             "efforts": effort_sorted(r.get("effort") for r in m.get("supported_reasoning_levels") or [] if isinstance(r, dict))}
            for m in rows]


def grok_models(home=None):
    """Grok's own cached listing (models_cache.json in its home), visible rows."""
    cache = read_json((home or HOMES / "grok") / "models_cache.json")
    if not isinstance(cache, dict) or not isinstance(cache.get("models"), dict): return None
    out = []
    for key, row in cache["models"].items():
        info = (row or {}).get("info") or {}
        if info.get("hidden") or not isinstance(info.get("id") or key, str) or not MODEL_ID.match(info.get("id") or key): continue
        efforts = [e.get("value") for e in info.get("reasoning_efforts") or [] if isinstance(e, dict)] if info.get("supports_reasoning_effort") else []
        out.append({"id": info.get("id") or key, "label": info.get("name") or key, "efforts": effort_sorted(efforts)})
    return out


def claude_label(model_id):
    """claude-fable-5-2 -> Fable 5.2."""
    parts = model_id.split("-")
    if parts[:1] != ["claude"] or len(parts) < 3: return model_id
    return parts[1].capitalize() + " " + ".".join(parts[2:])


def claude_efforts(cli):
    """The effort levels the pinned Claude Code takes, from its own --help."""
    try:
        done = subprocess.run([cli, "--help"], env=base_env(), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (subprocess.TimeoutExpired, OSError):
        return []
    found = re.search(r"--effort <level>[^(]*\(([a-z, ]+)\)", done.stdout)
    return effort_sorted(found.group(1).replace(" ", "").split(",")) if found else []


def claude_answers(cli, token, model):
    """True when a one-line call on this sign-in is answered by `model` itself
    (Claude Code reports the model that answered in modelUsage); False when the
    API says the model is not there for it (404, as 2.1.303 reports it); None
    for anything else (a usage limit, overload, offline), which proves nothing."""
    env = base_env()
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    try:
        done = subprocess.run([cli, "-p", "Reply with the single word OK.", "--model", model, "--max-turns", "1", "--output-format", "json"],
                              cwd=private_dir(RUN / "check"), env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=45)
        result = json.loads(done.stdout.strip().splitlines()[-1])
    except (subprocess.TimeoutExpired, OSError, ValueError, IndexError):
        return None
    return judge_model_answer(result, model)


def judge_model_answer(result, model):
    if not result.get("is_error"): return model in (result.get("modelUsage") or {})
    if result.get("api_error_status") == 404 or re.search(r"issue with the selected model|may not exist or you may not have access",
                                                         str(result.get("result") or ""), re.I):
        return False
    return None


def list_claude_models():
    """The models Claude Code offers on the stored sign-in: the adapter's own
    listing (`buzz-acp models`, aliases such as fable and opus), then each
    default full id that the listing lacks and that answers a one-line call.
    None when it cannot tell (signed out, offline)."""
    token, cli = claude_token(), claude_cli()
    if not token or not cli or not (BIN / "buzz-acp").exists(): return None
    env = base_env()
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    try:
        done = subprocess.run([str(BIN / "buzz-acp"), "models", "--json", "--agent-command", HARNESS["claude"][0], "--agent-args="],
                              cwd=private_dir(RUN / "check"), env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
        listing = json.loads(done.stdout)
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return None
    options = []
    for option in ((listing.get("stable") or {}).get("configOptions") or []):
        if isinstance(option, dict) and option.get("category") == "model":
            options = [o for o in option.get("options") or [] if isinstance(o, dict) and o.get("value") not in (None, "default")]
    efforts = claude_efforts(cli)
    rows = [{"id": o["value"], "label": o.get("name") or o["value"], "efforts": efforts}
            for o in options if isinstance(o["value"], str) and MODEL_ID.match(o["value"])]
    listed = {r["id"] for r in rows}
    extra = []
    for model in DEFAULTS["claude"][0]:
        if model in listed or not model.startswith("claude-"): continue
        answered = claude_answers(cli, token, model)
        if answered is None: return None
        if answered: extra.append({"id": model, "label": claude_label(model), "efforts": efforts})
    return extra + rows


def list_key_models(harness):
    """The chat models the service lists for the stored key (its model list on
    the base the key was saved for), the defaults first and then the rest in
    the service's order; None when it cannot tell (no key, rejected, offline).
    Efforts where the harness has a lever and knows them (Claude Code's own
    levels; what Codex and Grok cached for the model), else none."""
    key = stored_key(harness)
    if not key: return None
    status, body = key_get(harness, key_base(harness), key)
    if status != 200 or not isinstance(body, dict) or not isinstance(body.get("data"), list): return None
    spec = KEYS[harness]
    rows = {m["id"]: m for m in body["data"] if isinstance(m, dict) and isinstance(m.get("id"), str) and MODEL_ID.match(m["id"]) and spec["chat"](m["id"])}
    tries = DEFAULTS[harness][0]
    order = [m for m in tries if m in rows] + [i for i in rows if i not in tries]
    label, efforts = spec.get("label", lambda row: row["id"]), spec.get("efforts", lambda i: [])
    return [{"id": i, "label": str(label(rows[i]) or i), "efforts": effort_sorted(efforts(i))} for i in dict.fromkeys(order)]


def list_member_models(harness):
    """The models the Qwen membership lists (qwen-account.mjs models), in the
    account's order; None when it cannot tell."""
    answer = qwen_account("models", HOMES / harness)
    if not answer or not answer.get("ok") or not isinstance(answer.get("models"), list): return None
    ids = [i for i in answer["models"] if isinstance(i, str) and MODEL_ID.match(i)]
    return [{"id": i, "label": i, "efforts": []} for i in dict.fromkeys(ids)]


def model_source(slot):
    """(the slot's stored sign-in, its lister) for a slot whose listing this
    machine makes itself (Codex and Grok cache their own), else None. Each
    listing lives in run/<slot>-models.json, per sign-in."""
    harness = harness_of(slot)
    if harness == "antigravity":  # agy's own listing, on either way of paying
        return (lambda: stored_key(harness)) if slot.endswith("-key") else agy_cred, lambda: list_agy_models(slot)
    if slot.endswith("-key"):
        return (lambda: stored_key(harness), lambda: list_key_models(harness)) if harness in KEYS else None
    if harness == "claude": return claude_token, list_claude_models
    if harness in MEMBER: return (lambda: member_cred(harness), lambda: list_member_models(harness))
    return None


def refresh_models(harness, wait=False):
    """Makes this harness's listing again for the stored sign-in, at most one
    at a time (run/<harness>-models.lock); returns at once if one is running,
    unless `wait`. A listing that fails (a usage limit, offline) keeps the last
    good one, and is tried again after 10 minutes, then 20, 40 ... up to 6
    hours, so Claude's paid one-line call is not repeated while it cannot
    succeed."""
    signin, lister = model_source(harness)
    lock = open(private_dir(CRED_RUN) / f"{harness}-models.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError: return
        token = signin()
        if not token: return
        cache = read_json(CRED_RUN / f"{harness}-models.json", {}) or {}
        if cache.get("hash") != token_hash(token): cache = {}  # another sign-in: nothing of the last one holds
        elif not models_stale(cache): return
        models = lister()
        now = time.time()
        if models is not None:
            cache = {"hash": token_hash(token), "at": now, "models": models}
        else:
            fails = (cache.get("fails") or 0) + 1
            cache = {**cache, "hash": token_hash(token), "fails": fails, "failedAt": now,
                     "retryAt": now + min(CLAUDE_MODELS_FAIL_TTL * 2 ** (fails - 1), CLAUDE_MODELS_FAIL_MAX)}
        write_private(CRED_RUN / f"{harness}-models.json", json.dumps(cache))
    finally:
        lock.close()


def refresh_claude_models(wait=False):
    return refresh_models("claude", wait)


def models_stale(cache):
    if cache.get("retryAt"): return time.time() >= cache["retryAt"]
    return not cache.get("models") or time.time() - (cache.get("at") or 0) >= CLAUDE_MODELS_TTL


def cached_models(harness, spawn=True):
    """The last good listing of this harness for the stored sign-in, or None
    (none yet, or another sign-in). A stale one is still used, and made again
    out of band."""
    token = model_source(harness)[0]()
    if not token: return None
    cache = read_json(CRED_RUN / f"{harness}-models.json", {}) or {}
    if cache.get("hash") != token_hash(token):
        if spawn: spawn_models_refresh(harness)
        return None
    if spawn and models_stale(cache): spawn_models_refresh(harness)
    return cache.get("models")


def claude_models(spawn=True):
    return cached_models("claude", spawn)


def listing_due(harness):
    """True when this sign-in has no listing for the harness and none is
    waiting out a failure: making one now is worth a few seconds of a start."""
    token = model_source(harness)[0]()
    cache = read_json(CRED_RUN / f"{harness}-models.json", {}) or {}
    return bool(token) and (cache.get("hash") != token_hash(token) or (not cache.get("models") and models_stale(cache)))


def spawn_models_refresh(harness="claude"):
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "models", harness], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def offered(slot):
    """[{id, label, efforts}] this slot (a harness on one way of paying)
    offers here, or None when this machine cannot tell yet. Cheap: reads
    caches only."""
    if model_source(slot): return cached_models(slot)
    if slot == "codex": return codex_models()
    if slot == "grok": return grok_models()
    return None


def find_model(models, model):
    return next((m for m in models if m["id"] == model), None)


def choice(harness, settings, models=False):
    """The model and effort an agent runs with: {model, effort, note, problem}.
    `problem` (one sentence) when its own choice is not offered here; `note`
    when a default is not offered and another one stands in. model and effort
    are None for a harness that takes neither (Goose). What is offered is the
    slot's (the harness on the way the agent pays, settings["pays"]); `models`
    is offered(slot) when the caller has it already."""
    if harness not in DEFAULTS: return {"model": None, "effort": None}
    tries, default_effort = DEFAULTS[harness]
    model = (settings.get("model") or "").strip()
    effort = (settings.get("effort") or "").strip()
    models = offered(slot_of(harness, pays_of(settings))) if models is False else models
    if models is None:  # cannot check yet: what was asked for, or the first default
        return {"model": model or tries[0], "effort": effort or default_effort, "checked": False}
    label = LABEL[harness]
    out = {"model": model, "effort": effort, "checked": True}
    if model:
        entry = find_model(models, model)
        if not entry:
            return {**out, "problem": f"{label} does not offer the model {model} on this machine. Choose another model for this agent."}
    else:
        entry = next((find_model(models, m) for m in tries if find_model(models, m)), None) or (models[0] if models else None)
        if not entry: return {**out, "model": None, "effort": None, "note": f"{label} listed no models; it runs its own default."}
        out["model"] = entry["id"]
        if entry["id"] != tries[0]: out["note"] = f"{tries[0]} is not offered here; {entry['id']} runs instead."
    if effort:
        if effort not in entry["efforts"]:
            return {**out, "problem": f"{entry['label']} does not take the effort {effort}. Choose another effort for this agent."}
    elif default_effort is None:  # a harness with no effort lever: nothing to say
        out["effort"] = None
    elif default_effort in entry["efforts"]:
        out["effort"] = default_effort
    else:  # the highest one below the default, else none
        rank = EFFORT_ORDER.index(default_effort) if default_effort in EFFORT_ORDER else -1
        below = [e for e in entry["efforts"] if e in EFFORT_ORDER and EFFORT_ORDER.index(e) < rank]
        out["effort"] = below[-1] if below else None
        out["note"] = ((out.get("note") or "") + f" {entry['label']} does not take {default_effort} effort; "
                       + (f"{out['effort']} instead." if out["effort"] else "it runs its own default.")).strip()
    return out


def launch(harness, picked, pays="subscription", compact_at=None):
    """(env, agent args) that make this harness run the picked model and effort
    on the way it pays (the sign-in itself is added by start), and compact at
    `compact_at` tokens where that is an environment matter."""
    model, effort = picked.get("model"), picked.get("effort")
    # From a saved setting or a harness's own listing: checked again here,
    # since Grok's go into comma-separated arguments.
    if model and not MODEL_ID.match(model): fail(f"{LABEL[harness]}: {model[:80]!r} is not a model id.")
    if effort and not EFFORT_ID.match(effort): fail(f"{LABEL[harness]}: {effort[:20]!r} is not an effort level.")
    command, args = HARNESS[harness]
    env = {}
    if harness == "claude":
        if model: env["ANTHROPIC_MODEL"] = model
        if effort: env["CLAUDE_CODE_EFFORT_LEVEL"] = effort
    elif harness == "codex":
        config = {**({"model": model} if model else {}), **({"model_reasoning_effort": effort} if effort else {}),
                  **({"model_auto_compact_token_limit": compact_at} if compact_at else {})}
        if config: env["CODEX_CONFIG"] = json.dumps(config)
    elif harness == "grok":
        extra = (["--model", model] if model else []) + (["--reasoning-effort", effort] if effort else [])
        parts = args.split(",")
        args = ",".join(parts[:1] + extra + parts[1:])  # grok agent <options> stdio
    elif harness == "antigravity":
        args = agy_args(slot_home(slot_of(harness, pays)))
        if model: env["BUZZ_ACP_MODEL"] = f"{model}-{effort}" if effort else model
    elif harness == "qwen":
        # Always named: with either auth type Qwen Code has no model of its own.
        model = model or DEFAULTS["qwen"][0][0]
        if pays == "key":
            args = ",".join([args, *KEYS["qwen"]["auth_args"]])
            env["OPENAI_MODEL"] = model
        else:
            args = ",".join([args, *MEMBER["qwen"]["auth_args"], "-m", model])
    return env, args


def models_reply():
    """The `models` op: per installed harness that takes a model, what it
    offers ({id, label, efforts}), the default model and effort here, and
    whether the machine could tell (`checked`). Quick: a Claude listing that
    is missing is made out of band, and waited for only MODELS_WAIT seconds;
    the plugin asks again soon while a harness is unchecked."""
    def listing(hid, pays):
        slot = slot_of(hid, pays)
        models = offered(slot)
        if model_source(slot) and models is None and model_source(slot)[0]():
            deadline = time.time() + MODELS_WAIT
            while models is None and time.time() < deadline:
                time.sleep(0.25)
                models = cached_models(slot, spawn=False)
        picked = choice(hid, {"pays": pays}, models)
        return {"models": models or [], "checked": models is not None,
                "model": picked.get("model"), "effort": picked.get("effort"),
                "compact": compact_support(hid, picked.get("model")),
                **({"note": picked["note"]} if picked.get("note") else {})}
    rows = []
    for hid in DEFAULTS:
        if not installed(hid): continue
        # The subscription's listing at the top level (what an older plugin
        # reads), the key's under `key`.
        rows.append({"id": hid, "label": LABEL[hid], **listing(hid, "subscription"),
                     **({"key": listing(hid, "key")} if hid in KEYS else {})})
    return {"ok": True, "harnesses": rows, "controls": controls_schema()}


def checked_choice(harness, model, effort, pays="subscription"):
    """Refuses a model or effort this harness does not offer here on the way
    the agent pays (when the machine can tell); returns the cleaned pair, ""
    meaning the default."""
    model = model.strip() if isinstance(model, str) else ""
    effort = effort.strip().lower() if isinstance(effort, str) else ""
    if model and not MODEL_ID.match(model): fail("model is not a model id")
    if effort and not EFFORT_ID.match(effort): fail("effort is not an effort level")
    if (model or effort) and harness not in DEFAULTS:
        fail(f"{LABEL.get(harness, harness)} takes its model from the machine; it has no model or effort to choose.")
    picked = choice(harness, {"model": model, "effort": effort, "pays": pays})
    if picked.get("problem"): fail(picked["problem"])
    return model, effort


# ---------------------------------------------------------------- start

def start(d):
    with agent_lock(d):
        return _start(d)


def as_agent(d, s=None):
    """Point the sign-in paths at this agent's creator, for one agent's work
    (the supervisor's pass covers everyone's agents)."""
    use_agent_account(s if s is not None else read_settings(d))


def _start(d):
    s = read_settings(d)
    if not s.get("auth"): fail("agent has no owner attestation yet")
    use_agent_account(s)
    if not ACCOUNT:
        fail("This agent has no creator on this machine, so it has no one's sign-in to run on. A Black 4 admin gives it one (agentctl adopt-signins).")
    harness = s.get("harness") or "claude"
    if harness not in HARNESS: fail(f"unknown harness {harness!r}")
    if not installed(harness):
        fail(f"{LABEL[harness]} is not installed on this machine.")
    problem = harness_problem(harness)
    if problem: fail(f"{LABEL[harness]} cannot run on this machine: {problem}.")
    # The one sign-in this agent pays with, and nothing of the other: a key
    # agent never sees the subscription's token or home, nor the reverse.
    pays = pays_of(s)
    slot = slot_of(harness, pays)
    label = LABEL[harness]
    if pays == "key":
        key = stored_key(harness) if harness in KEYS else None
        if not key or known_bad(slot):
            service = KEYS[harness]["service"] if harness in KEYS else label
            fail(f"{label} has no working API key for {ACCOUNT} on this machine. {ACCOUNT} adds {article(service)} {service} API key from Buzz first, or sets this agent to pay by subscription.")
        env = slot_env(slot)
        env.update(KEYS[harness]["env"](key, key_base(harness)))  # the environment only: never an argument
        spec = KEYS[harness]
        if "install" in spec and not spec["installed"](key) and not spec["install"](key):
            fail(f"{label} could not take the API key on this machine. Add it from Buzz again.")
    elif harness == "claude":
        token = claude_token()
        if not token or known_bad("claude"):
            fail(f"Claude Code is not signed in for {ACCOUNT} on this machine. {ACCOUNT} signs in to Claude from Buzz first.")
        env = slot_env("claude")
        env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    elif harness in DEVICE or harness in MEMBER or harness == "antigravity":
        if known_bad(harness):
            fail(f"{label} is not signed in for {ACCOUNT} on this machine. {ACCOUNT} signs in to {label} from Buzz first.")
        env = slot_env(harness)
    else:
        env = base_env()
    # Right after a deploy or a new sign-in there is no listing yet for a slot
    # this machine lists itself: make it now (a few seconds, once per sign-in)
    # rather than start a model that may not be offered. One waiting out a
    # failure is not retried here.
    if model_source(slot) and listing_due(slot): refresh_models(slot, wait=True)
    picked = choice(harness, s)
    if picked.get("problem"): fail(picked["problem"])
    compact_at = s.get("compactAt") if isinstance(s.get("compactAt"), int) and not isinstance(s.get("compactAt"), bool) else None
    model_env, args = launch(harness, picked, pays, compact_at)
    stop(d)
    (d / "launch.json").unlink(missing_ok=True)
    (d / "work").mkdir(exist_ok=True)
    model_env.update(compact_levers(harness, picked.get("model"), compact_at, d / "work"))
    command = HARNESS[harness][0]
    env.update(runner_env())  # so the agent's own agentctl calls reach this root
    env.update(TURN_LOG)    # buzz-acp's turn lines, which a self-change waits for
    env.update({
        "BUZZ_PRIVATE_KEY": (d / "key").read_text().strip(),
        # The harness speaks WebSocket to the relay; the CLI below uses HTTPS.
        "BUZZ_RELAY_URL": "wss://" + s["community"].split("://", 1)[1],
        "BUZZ_AUTH_TAG": json.dumps(s["auth"]),
        "BUZZ_ACP_AGENT_COMMAND": command,
        "BUZZ_ACP_LAZY_POOL": "true",
    })
    # buzz-acp forwards this to the Black 4 connector, which sends it as the
    # agent's name: the agent and every worker it fans out log as this agent.
    if (s.get("name") or "").strip(): env["BUZZ_ACP_DISPLAY_NAME"] = s["name"].strip()
    minutes = heartbeat_minutes(s)
    if minutes:
        # A heartbeat agent wakes on its own and asks Black 4 what is due
        # (docs/roadmap/job-schedules.md in the platform repository). buzz-acp
        # skips a heartbeat while its model process sleeps, so a heartbeat
        # agent keeps it on, and runs two turns so a person can still talk
        # to it while a scheduled run is going.
        (d / "heartbeat.md").write_text(heartbeat_prompt({**s, "model": exact_model(picked)}))
        env.update({
            "BUZZ_ACP_LAZY_POOL": "false",
            "BUZZ_ACP_HEARTBEAT_INTERVAL": str(minutes * 60),
            "BUZZ_ACP_HEARTBEAT_PROMPT_FILE": str(d / "heartbeat.md"),
            "BUZZ_ACP_AGENTS": "2",
        })
    env.update(control_env(s))  # buzz-acp's own levers, as this agent set them
    if args: env["BUZZ_ACP_AGENT_ARGS"] = args
    if access_of(s) == "platform":
        # The customer-facing profile: see "the customer-facing profile".
        if not platform_runner(): fail("A customer-facing agent runs only on this machine's customer-facing runner.")
        if harness != "claude" or pays != "subscription" or respond_to(s) != "business":
            fail("A customer-facing agent runs Claude Code on its creator's subscription and answers one business.")
        problem = seated_problem(d, s)
        if problem: fail(problem)
        env[KEYS["claude"]["home_env"]] = str(platform_home(d))
        env["BUZZ_ACP_PERMISSION_MODE"] = "default"
    else:
        env.update(FULL_ACCESS[harness])
    # buzz-acp declares one MCP server per session and hands it the agent's key
    # (nsec) and BUZZ_AUTH_TAG. Buzz's own tools are the agent's shell and the
    # buzz CLI, so the slot is free for Black 4. Missing connector: no MCP.
    if os.access(BLACK4_MCP, os.X_OK): env["BUZZ_ACP_MCP_COMMAND"] = str(BLACK4_MCP)
    # Whom it answers (see "whom an agent answers"): a staff or business agent
    # asks for its list now unless it just did, and starts owner-only when
    # it has never had one. `allow` is not used: no key outside the list.
    audience = audience_state(d)
    if respond_to(s) in AUDIENCE_MODES and time.time() - (audience.get("tried") or 0) >= AUDIENCE_FRESH:
        audience = refresh_audience(d, restart=False)
    gate = audience_launch(s, audience)
    env["BUZZ_ACP_RESPOND_TO"] = gate["respondTo"]
    if gate["keys"]: env["BUZZ_ACP_RESPOND_TO_ALLOWLIST"] = ",".join(gate["keys"])
    if (s.get("instructions") or "").strip():
        (d / "instructions.md").write_text(s["instructions"])
        env["BUZZ_ACP_SYSTEM_PROMPT_FILE"] = str(d / "instructions.md")
    # BUZZ_ACP_MODEL only for Antigravity: see "model and effort" above.
    env.update(model_env)
    write_private(d / "launch.json", json.dumps({**{k: picked.get(k) for k in ("model", "effort", "note", "checked")}, "compactAt": compact_at,
                                                 "audience": gate["fingerprint"], "gate": {"respondTo": gate["respondTo"], "keys": len(gate["keys"])}}))
    cap_log(d / "agent.log", AGENT_LOG_CAP)
    # buzz-acp writes to agent.raw.log; the log filter follows it into
    # agent.log (see "an agent changing itself"). The filter for the previous
    # start is ended first, so no two write the same lines.
    stop_sieve(d)
    cap_log(d / "agent.raw.log", AGENT_LOG_CAP)
    raw = open(d / "agent.raw.log", "ab")
    try: os.chmod(d / "agent.raw.log", 0o600)
    except OSError: pass
    start_at = raw.tell()
    proc = subprocess.Popen(
        [str(BIN / "buzz-acp"), "--agent-owner", s["auth"][1]],
        cwd=d / "work", env=env, stdin=subprocess.DEVNULL, stdout=raw, stderr=raw,
        start_new_session=True)
    raw.close()
    (d / "pid").write_text(str(proc.pid))
    sieve = subprocess.Popen([PYTHON, str(SELF), "log-filter", str(d / "agent.raw.log"), str(d / "agent.log"), str(proc.pid), str(start_at)],
                             env={**base_env(), **root_env()}, cwd=str(d), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    write_private(d / "sieve.json", json.dumps({"pid": sieve.pid}))
    time.sleep(START_GRACE)
    if proc.poll() is not None:
        time.sleep(0.5)  # what buzz-acp said on its way out, through the filter
        fail("agent stopped at start: " + log_tail(d, 600))
    ensure_persistence()
    return proc.pid


def harness_agents(harness, pays=None):
    """The agents on this harness, or only those paying this way."""
    for d in agent_dirs():
        s = read_settings(d)
        if ((s.get("harness") or "claude") == harness and (pays is None or pays_of(s) == pays)
                and s.get("createdBy") == ACCOUNT):
            yield d, s


def restart_harness_agents(harness, pays=None):
    """Restart activated agents on this harness (after a sign-in), or only
    those paying the way that was signed in. A new Claude sign-in also goes
    to the customer-facing runner, for this person's agents there."""
    for d, s in harness_agents(harness, pays):
        if s.get("auth"):
            try: start(d)
            except Exception as e: log_line("supervisor", f"restart {d.name[:8]} failed: {str(e)[:200]}")
    if harness == "claude" and pays in (None, "subscription"): sync_platform_signin()


def stop_harness_agents(harness, pays=None):
    for d, _ in harness_agents(harness, pays):
        with agent_lock(d): stop(d)


# ---------------------------------------------------------------- an agent changing itself
# An agent may change its own setup from its shell (its note says how). Such a
# request comes from inside its own process tree: under its buzz-acp, or in
# the session or process group buzz-acp leads (it is started with its own).
# Restarting it there would kill the very turn that asked, before the reply
# posts, so a self-change is saved at once, answered with "applies": "after
# this turn", and applied by a detached `agentctl apply-later <pubkey>`
# outside the agent's process group. The turn's end is read from agent.log:
# agents are started with buzz-acp's ACP wire log on (TURN_LOG), which writes
# every session/prompt it sends and the result it gets back ({"stopReason":
# ...}). That wire also carries the agent's own key (session/new hands it to
# the MCP server) and everything the model and its tools say, so buzz-acp
# writes to agent.raw.log (in the agent's private folder, capped like the
# log) and `agentctl log-filter` follows that file into agent.log, turning a
# prompt into the bare line "agentctl: turn opened", a result into "agentctl:
# turn closed", dropping every other wire line and passing the rest through.
# (Not a pipe: a Node harness sets the pipe it shares with buzz-acp
# non-blocking, and buzz-acp then dies writing to it.) Since buzz-acp last started (its "buzz-acp starting" line), the
# waiter counts turns opened and closed; nothing is in flight when as many
# have closed as opened, and that is when it restarts (a heartbeat agent runs
# two model processes, so the asking turn is not the only one that may be
# running). It then waits for the log to be quiet for TURN_SETTLE seconds, so
# the reply has gone out, and restarts the agent on the saved settings.
# buzz-acp sent SIGTERM
# mid-turn does not wait (checked on 0.5.30: it cancels the turn after a few
# seconds of silence), so nothing is signalled before that. A turn that has not
# ended after APPLY_WAIT is stopped the hard way. Changes from people (the door,
# SSH) restart at once, as before.

APPLY_WAIT = 10 * 60   # a self-change waits this long for the agent's turn to end
TURN_SETTLE = 5        # then this long of a quiet log, for the reply to go out
TURN_LOG = {"RUST_LOG": "info,acp::wire=debug"}  # buzz-acp's ACP traffic, in agent.log
# buzz-acp writes what it sends compactly and what it receives as the agent
# wrote it (Qwen Code without spaces, Python agents with), so spaces are optional.
WIRE = b"acp::wire:"
TURN_OPEN_WIRE = re.compile(rb'acp::wire: \xe2\x86\x92 .*"method":\s*"session/prompt"')  # → a prompt sent
TURN_CLOSE_WIRE = re.compile(rb'acp::wire: \xe2\x86\x90 .*"result":\s*\{\s*"stopReason"')  # ← its result
TURN_OPEN = re.compile(rb"agentctl: turn opened")   # what the log filter writes for them
TURN_CLOSE = re.compile(rb"agentctl: turn closed")
# A prompt buzz-acp 0.5.30 gives up on with no stopReason ever coming back
# (crates/buzz-acp/src/pool.rs): the model process exited, the prompt failed,
# the hard cap hit, or the cancel after an idle timeout failed. Each ends a
# turn as surely as a result does. (An idle timeout itself cancels, and the
# cancelled prompt's result closes it.)
TURN_LOST = re.compile(rb"pool::prompt: (?:agent \d+ exited during (?:prompt|cancel_with_cleanup)|session_prompt error|cancel_with_cleanup error|hard timeout)")
TURN_MARK = re.compile(rb"agentctl: turn (opened|closed)|" + TURN_LOST.pattern)
TURN_START = b"buzz-acp starting:"  # the line buzz-acp writes when it starts


ANSI = re.compile(rb"\x1b\[[0-9;]*m")  # buzz-acp colours its log lines


def sieve_line(line):
    """What of one line of buzz-acp's output goes into agent.log: a wire line
    becomes a bare turn marker or nothing; any other line passes through."""
    plain = ANSI.sub(b"", line)
    if WIRE not in plain: return line
    stamp = plain.split(b" ", 1)[0]
    if TURN_OPEN_WIRE.search(plain): return stamp + b"  INFO agentctl: turn opened\n"
    if TURN_CLOSE_WIRE.search(plain): return stamp + b"  INFO agentctl: turn closed\n"
    return b""


def sieve_log(raw, log, pid, start):
    """`agentctl log-filter <raw> <log> <pid> <from>`: follows agent.raw.log
    from byte `from` into agent.log, line by line through sieve_line, until
    buzz-acp (`pid`) is gone and nothing more has arrived. A raw log cut over
    meanwhile (smaller than where we were) is read again from its start."""
    pos, rest, idle = start, b"", 0
    while True:
        try: size = raw.stat().st_size
        except OSError: size = 0
        if size < pos: pos, rest = 0, b""
        chunk = b""
        if size > pos:
            with open(raw, "rb") as f:
                f.seek(pos); chunk = f.read(size - pos)
            pos = size
        if chunk:
            lines = (rest + chunk).split(b"\n")
            rest = lines.pop()
            kept = b"".join(sieve_line(line + b"\n") for line in lines)
            if kept:
                with open(log, "ab") as out: out.write(kept)
        alive = bool(process_command(pid))  # a zombie buzz-acp (not yet reaped) is gone
        idle = 0 if chunk else idle + 1
        if not alive and idle >= 2:
            if rest:
                with open(log, "ab") as out: out.write(sieve_line(rest + b"\n"))
            return
        time.sleep(0.2)


def stop_sieve(d):
    """Ends the log filter following this agent's raw log, if one is."""
    pid = (read_json(d / "sieve.json", {}) or {}).get("pid")
    if pid and "log-filter" in process_command(pid):
        try: os.kill(pid, signal.SIGTERM)
        except OSError: pass
    (d / "sieve.json").unlink(missing_ok=True)
APPLY_MARK = "applying.json"


def process_tree():
    """{pid: (ppid, pgid, sid)} of every process now."""
    done = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,pgid=,sess="], capture_output=True, text=True)
    tree = {}
    for line in done.stdout.splitlines():
        parts = line.split()
        if len(parts) == 4 and all(p.isdigit() for p in parts): tree[int(parts[0])] = tuple(int(p) for p in parts[1:])
    return tree


def inside_agent(d, pid=None, tree=None):
    """Whether the process `pid` (this one) runs inside agent d's own tree."""
    agent = running(d)
    if not agent: return False
    pid = pid or os.getpid()
    tree = process_tree() if tree is None else tree
    own = tree.get(pid)
    if own and agent in own[1:]: return True  # its process group or session
    seen, p = set(), pid
    while p in tree and p not in seen and p > 1:
        if p == agent: return True
        seen.add(p)
        p = tree[p][0]
    return p == agent


def inside_any_agent():
    """Whether this process runs inside any agent's own tree."""
    tree = process_tree()
    return any(inside_agent(d, tree=tree) for d in agent_dirs())


def applying(d):
    """Whether a self-change is waiting to be applied to this agent."""
    mark = read_json(d / APPLY_MARK, {}) or {}
    return bool(mark) and time.time() - (mark.get("at") or 0) < APPLY_WAIT + 60


def log_size(d):
    try: return (d / "agent.log").stat().st_size
    except OSError: return 0


def defer_apply(d, audience=False):
    """A self-change: nothing restarts now; a detached waiter applies it after
    the agent's turn. The settings are already saved; the log's size now is
    where the waiter starts looking for the turn's end. A changed audience
    (`audience`) waits only for nothing to be in flight."""
    write_private(d / APPLY_MARK, json.dumps({"at": time.time(), "pid": running(d), "logAt": None if audience else log_size(d)}))
    spawn_apply(d)


def spawn_apply(d):
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "apply-later", d.name], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def turns_in_flight(d):
    """How many prompts buzz-acp has sent and not had answered since it last
    started, from agent.log (and agent.log.1 when the log was cut over since
    the start line); None when no start line can be found."""
    text = b""
    for name in ("agent.log.1", "agent.log"):
        try:
            with open(d / name, "rb") as f: text += f.read()
        except OSError:
            pass
    text = ANSI.sub(b"", text)
    start = text.rfind(TURN_START)
    if start < 0: return None
    open_turns = 0
    for mark in TURN_MARK.finditer(text[start:]):
        # Never below none: an end whose start came before the log did hides
        # no turn that opens after it.
        open_turns = open_turns + 1 if mark.group(1) == b"opened" else max(0, open_turns - 1)
    return open_turns


def turn_ended(d, since):
    """Whether nothing is in flight and, for a self-change (`since` the byte of
    agent.log where the asking turn was running), at least one turn has ended
    past `since`. An audience change (`since` None) waits for nothing in flight
    only: the last turn may well have closed before the waiter began."""
    if since is not None:
        path = d / "agent.log"
        try:
            size = path.stat().st_size
            with open(path, "rb") as f:
                f.seek(since if size >= since else 0)
                tail_ = ANSI.sub(b"", f.read())
        except OSError:
            return False
        if not (TURN_CLOSE.search(tail_) or TURN_LOST.search(tail_)): return False
    open_turns = turns_in_flight(d)
    return open_turns is not None and open_turns <= 0


def log_quiet(d, seconds, limit=30):
    """Waits until agent.log has not grown for `seconds` (at most `limit`)."""
    end = time.time() + limit
    last, at = log_size(d), time.time()
    while time.time() < end:
        time.sleep(0.5)
        size = log_size(d)
        if size != last: last, at = size, time.time()
        elif time.time() - at >= seconds: return


def apply_later(d):
    """Runs detached, outside the agent's process group: waits for the turn
    to end, then restarts the agent on its saved settings. One per agent."""
    lock = open(d / "apply.lock", "a")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError: return
    try:
        mark = read_json(d / APPLY_MARK, {}) or {}
        pid, since = running(d), mark.get("logAt", 0)
        if pid:
            # Nothing in flight, then a quiet log so the reply goes out, then
            # nothing in flight still: with parallel sessions another turn may
            # open meanwhile, and a restart then would cut it. At APPLY_WAIT it
            # stops the hard way, so a change never waits for ever.
            deadline, ready = time.time() + APPLY_WAIT, False
            while running(d) == pid and time.time() < deadline:
                if turn_ended(d, since):
                    log_quiet(d, TURN_SETTLE, limit=max(1, min(30, deadline - time.time())))
                    if turn_ended(d, since): ready = True; break
                    continue
                time.sleep(0.5)
            if running(d) == pid and not ready:
                log_line("supervisor", f"apply {d.name[:8]}: its turns did not end in {APPLY_WAIT} s; stopping it")
        (d / "restarts.json").unlink(missing_ok=True)
        if read_settings(d).get("auth"):
            try: log_line("supervisor", f"applied {d.name[:8]} after its turn: pid {start(d)}")
            except Exception as e: log_line("supervisor", f"apply {d.name[:8]} failed: {str(e)[:200]}")
    finally:
        (d / APPLY_MARK).unlink(missing_ok=True)
        lock.close()


# ---------------------------------------------------------------- persistence
# Nobody is logged in at the machine's screen, so there is no GUI launchd session
# to hold a LaunchAgent across a reboot. cron runs without one: an @reboot line
# and an every-minute line both run `agentctl supervise`, which takes a lock and
# then loops, restarting any activated agent that is not running.

def runner_env():
    """The environment a second runner's own processes need to find their root."""
    return {} if ROOT == HOME / "workforce" else {"BLACK4_WORKFORCE_ROOT": str(ROOT)}


def root_env():
    """runner_env, plus whose sign-ins agentctl's own detached process acts on."""
    return {**runner_env(), **({"AGENTCTL_ACCOUNT": ACCOUNT} if ACCOUNT else {})}


def cron_lines():
    prefix = "".join(f"{k}={v} " for k, v in runner_env().items())
    cmd = f"{prefix}{PYTHON} {BIN / 'agentctl'} supervise >/dev/null 2>&1"
    return [f"@reboot {cmd} {CRON_MARK}", f"* * * * * {cmd} {CRON_MARK}"]


def read_crontab():
    done = subprocess.run(["/usr/bin/crontab", "-l"], capture_output=True, text=True)
    return done.stdout if done.returncode == 0 else ""


def write_crontab(text):
    if text.strip():
        subprocess.run(["/usr/bin/crontab", "-"], input=text, text=True, check=True, capture_output=True)
    else:
        subprocess.run(["/usr/bin/crontab", "-r"], capture_output=True)


def merged_crontab(current, install):
    keep = [line for line in current.splitlines() if not line.rstrip().endswith(CRON_MARK)]
    if install: keep += cron_lines()
    return "\n".join(keep) + ("\n" if keep else "")


def ensure_persistence():
    if os.environ.get("AGENTCTL_NO_CRON"): return
    current = read_crontab()
    wanted = merged_crontab(current, True)
    if current != wanted: write_crontab(wanted)


def drop_persistence():
    """Remove the cron lines and the supervisor once no activated agent is left."""
    if any(read_settings(d).get("auth") for d in agent_dirs()): return
    if not os.environ.get("AGENTCTL_NO_CRON"):
        current = read_crontab()
        wanted = merged_crontab(current, False)
        if current != wanted: write_crontab(wanted)
    pid = read_json(RUN / "supervisor.json", {}).get("pid")
    if pid and pid != os.getpid():
        try: os.kill(pid, signal.SIGTERM)
        except OSError: pass


def supervise(passes=None):
    """Keep activated agents running. Only one supervisor runs at a time; a second
    one exits at once. Exits when agentctl itself is replaced, so cron picks up
    the new version within a minute."""
    private_dir(RUN)
    lock = open(RUN / "supervisor.lock", "a")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError: return
    write_private(RUN / "supervisor.json", json.dumps({"pid": os.getpid(), "since": int(time.time())}))
    log_line("supervisor", f"supervisor {os.getpid()} up")
    born = SELF.stat().st_mtime if SELF.exists() else 0
    n = 0
    while passes is None or n < passes:
        n += 1
        supervise_pass()
        cleanup_logins()
        if not any(read_settings(d).get("auth") for d in agent_dirs()):
            drop_persistence(); break
        if SELF.exists() and SELF.stat().st_mtime != born:
            log_line("supervisor", "agentctl changed; exiting for cron to restart"); break
        if passes is None or n < passes: time.sleep(SUPERVISE_EVERY)


def restarts(d):
    """The supervisor's restarts of this agent in a row (agents/<pubkey>/restarts.json):
    count, delay, at (last restart), next (earliest next try). It lives on disk,
    so a crash loop keeps backing off across supervisors and reboots."""
    return read_json(d / "restarts.json", {}) or {}


def keeps_stopping(d):
    return restarts(d).get("count", 0) >= KEEPS_STOPPING


def recheck_launch(d, s):
    """An agent started before its harness's listing was known (launch.json
    checked false) is checked once the listing is in: one that runs what it
    should now is marked checked; one that should run another model or effort
    is restarted on it; one whose own choice is not offered is stopped, so it
    does not fail every turn unseen (status says why, and start refuses it
    until the choice is changed)."""
    launched = read_json(d / "launch.json")
    if not isinstance(launched, dict) or launched.get("checked", True): return
    harness = s.get("harness") or "claude"
    models = offered(slot_of(harness, pays_of(s)))
    if models is None: return
    picked = choice(harness, s, models)
    if not picked.get("problem") and (picked.get("model"), picked.get("effort")) == (launched.get("model"), launched.get("effort")):
        write_private(d / "launch.json", json.dumps({**launched, "checked": True}))
        return
    if picked.get("problem"):
        with agent_lock(d): stop(d)
        log_line("supervisor", f"stopped {d.name[:8]}: {picked['problem']}")
        return
    try: log_line("supervisor", f"restarted {d.name[:8]} on {picked.get('model')} pid {start(d)}")
    except Exception as e: log_line("supervisor", f"restart {d.name[:8]} failed: {str(e)[:200]}")


AUDIENCE_SPAWNED = {}  # pubkey -> when this supervisor last started its refresh
DROPS_SPAWNED = {}     # pubkey -> when this supervisor last started `agentctl dropped`


def supervise_pass(now=None):
    """One look at every agent: restart an activated agent that is not running,
    waiting 5, 10, 20 ... 300 s between restarts while it keeps stopping. One
    that has stayed up 5 minutes since its last restart starts over at 5 s."""
    reap()
    now = now or time.time()
    for d in agent_dirs():
        cap_log(d / "agent.log", AGENT_LOG_CAP)
        cap_log(d / "agent.raw.log", AGENT_LOG_CAP)
        s = read_settings(d)
        if not s.get("auth"): continue
        # What its gate dropped: asked about, and answered, out of band.
        if running(d) and watch_drops(d, now) and now - DROPS_SPAWNED.get(d.name, 0) >= DROP_EVERY:
            DROPS_SPAWNED[d.name] = now
            spawn_dropped(d)
        if applying(d): continue  # a self-change's waiter restarts it
        as_agent(d, s)
        r = restarts(d)
        if running(d):
            if r and now - r.get("at", now) > HEALTHY_AFTER: (d / "restarts.json").unlink(missing_ok=True)
            recheck_launch(d, s)
            # Its list again about every 10 minutes (every minute while it has none), out of band.
            if respond_to(s) in AUDIENCE_MODES and audience_due(d, now) and now - AUDIENCE_SPAWNED.get(d.name, 0) >= AUDIENCE_RETRY:
                AUDIENCE_SPAWNED[d.name] = now
                spawn_audience(d)
            continue
        if now < r.get("next", 0): continue
        if known_bad(slot_of(s.get("harness") or "claude", pays_of(s))): continue  # waits for a sign-in
        delay = min(max(r.get("delay", 0) * 2, 5), RESTART_MAX_DELAY)
        try:
            log_line("supervisor", f"started {d.name[:8]} pid {start(d)}")
        except Exception as e:  # Fail, or anything unexpected: back off all the same
            log_line("supervisor", f"start {d.name[:8]} failed: {str(e)[:200]}")
        if d.exists():
            write_private(d / "restarts.json", json.dumps({"count": r.get("count", 0) + 1, "delay": delay, "at": now, "next": now + delay}))


# ---------------------------------------------------------------- sign-in
# `claude setup-token` prints a link, waits for the code the person pastes back,
# then prints a long-lived OAuth token. It needs a terminal, and the sign-in
# spans two SSH calls, so a detached helper runs it in a pty and keeps state in
# logins/<id>/ (mode 700): state.json (url or error), code (written by
# login.finish), result.json (written by the helper). The token never touches
# that folder: the helper writes it straight to secrets/claude.

URL_RE = re.compile(r"https://[^\s\"'<>]+/oauth/authorize\?[^\s\"'<>]+")
TOKEN_RE = re.compile(r"sk-ant-[a-z0-9]+-[A-Za-z0-9_\-]{20,}")
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")
CODE_RE = re.compile(r"^[A-Za-z0-9_\-#.~=+/]{8,1024}$")


def screen_text(raw):
    """Terminal output as plain text: cursor-forward becomes spaces, other escapes go."""
    raw = re.sub(rb"\x1b\[(\d*)C", lambda m: b" " * int(m.group(1) or 1), raw)
    raw = re.sub(rb"\x1b\[[0-9;?>=]*[A-Za-z]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b[()][A-Z0-9]|\x1b[=>78]", b"", raw)
    return raw.decode(errors="replace").replace("\r", "\n")


def login_dir(login_id):
    if not isinstance(login_id, str) or not LOGIN_ID.match(login_id):
        fail("loginId is not valid")
    return LOGINS / login_id


def kill_login(d):
    info = read_json(d / "helper.json", {})
    for pid in (info.get("child"), info.get("pid")):
        if not pid: continue
        try: os.killpg(pid, signal.SIGKILL)
        except OSError:
            try: os.kill(pid, signal.SIGKILL)
            except OSError: pass
    shutil.rmtree(d, ignore_errors=True)


def cleanup_logins(now=None):
    if not LOGINS.exists(): return
    now = now or time.time()
    for d in LOGINS.iterdir():
        if not d.is_dir(): continue
        info = read_json(d / "helper.json", {})
        started = info.get("startedAt") or d.stat().st_mtime
        alive = False
        if info.get("pid"):
            try: os.kill(info["pid"], 0); alive = True
            except OSError: pass
        # A key sign-in has no helper: it stays open for its lifetime.
        if now - started > LOGIN_TTL or (not alive and info.get("kind") != "key" and now - started > 120):
            kill_login(d)


def login_start(harness, flows=None, pays="subscription"):
    """Opens one sign-in, of the harness's subscription or (pays "key") of an
    API key. Claude: a link whose page shows a code to paste back (needsCode
    true). Codex, Grok and the Qwen membership: a link and a short userCode
    the person approves there (needsCode false); the plugin then calls
    login.finish with no code, which waits for that approval. A key: a link to
    the page where one is made (needsCode true, flow "key"); the plugin then
    calls login.finish with the key pasted as the code. A plugin says which
    flows it can show by sending flows: ["code", "device", "key"]; an older
    one cannot show a device code or a key field, so it gets a sentence
    instead of a sign-in it could not finish."""
    if pays not in PAYS: fail('pays is "subscription" or "key"')
    label = LABEL.get(harness, str(harness))
    flows = flows if isinstance(flows, list) else []
    if pays == "key":
        if harness not in KEYS: fail(f"{label} cannot run on an API key on this machine.")
        if not installed(harness): fail(f"{label} is not installed on this machine.")
        if "key" not in flows:
            fail(f"Update the Black 4 plugin in Buzz to add {article(KEYS[harness]['service'])} {KEYS[harness]['service']} API key from it.")
    else:
        if harness not in SIGN_IN:
            if harness in NO_SIGN_IN: fail(NO_SIGN_IN[harness])
            fail("Buzz cannot sign in that harness on this machine.")
        if harness == "claude" and not claude_cli():
            fail("Claude Code is not installed on this machine.")
        if harness == "antigravity" and not agy_cli(): fail(f"{label} is not installed on this machine.")
        if harness in DEVICE and not device_cli(harness): fail(f"{label} is not installed on this machine.")
        if harness in MEMBER and not (installed(harness) and node_cli() and account_script().exists()):
            fail(f"{label} is not installed on this machine.")
        if (harness in DEVICE or harness in MEMBER) and "device" not in flows:
            fail(f"Update the Black 4 plugin in Buzz to sign in to {label} from it.")
    cleanup_logins()
    if LOGINS.exists():  # one sign-in at a time: a new one replaces the old
        for old in LOGINS.iterdir():
            if old.is_dir(): kill_login(old)
    login_id = secrets.token_hex(8)
    d = private_dir(private_dir(LOGINS) / login_id)
    if pays == "key":
        # No helper: the key arrives in login.finish and is checked there.
        started = time.time()
        write_private(d / "helper.json", json.dumps({"startedAt": started, "harness": harness, "ttl": LOGIN_TTL, "kind": "key"}))
        return {"ok": True, "loginId": login_id, "url": KEYS[harness]["keyUrl"], "needsCode": True, "flow": "key",
                "expiresAt": int(started + LOGIN_TTL)}
    write_private(d / "helper.json", json.dumps({"startedAt": time.time(), "harness": harness, "ttl": LOGIN_TTL}))
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    subprocess.Popen([PYTHON, str(SELF), "login-helper", login_id], env=env, cwd=str(d),
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    deadline = time.time() + 40
    while time.time() < deadline:
        state = read_json(d / "state.json")
        if state and state.get("url"):
            if SIGN_IN.get(harness) == "code":
                return {"ok": True, "loginId": login_id, "url": state["url"], "needsCode": True}
            return {"ok": True, "loginId": login_id, "url": state["url"], "needsCode": False,
                    "userCode": state.get("userCode"), "expiresAt": int(state.get("expiresAt") or 0) or None}
        if state and state.get("error"):
            kill_login(d); fail(state["error"])
        time.sleep(0.2)
    kill_login(d)
    fail(f"{label} did not give a sign-in link in time. Try again.")


def login_finish(login_id, code):
    d = login_dir(login_id)
    if not d.exists():
        fail("This sign-in has expired or was cancelled. Start the sign-in again.")
    info = read_json(d / "helper.json", {}) or {}
    harness = info.get("harness") or "claude"
    if info.get("kind") == "key": return key_finish(d, harness, code)
    if harness in DEVICE or harness in MEMBER: return device_finish(d, harness)
    code = (code or "").strip() if isinstance(code, str) else ""
    page = "antigravity.google" if harness == "antigravity" else "the Anthropic page"
    if not CODE_RE.match(code):
        fail(f"That does not look like a sign-in code. Copy the whole code from {page} and paste it again.")
    if (d / "result.json").exists() or (d / "code").exists():
        fail("This sign-in is already finishing.")
    write_private(d / "code", code)
    deadline = time.time() + 90
    while time.time() < deadline:
        result = read_json(d / "result.json")
        if result is not None:
            return finished(d, result)
        if not d.exists():
            fail("This sign-in has expired or was cancelled. Start the sign-in again.")
        time.sleep(0.2)
    kill_login(d)
    fail(f"{LABEL.get(harness, 'Claude Code')} did not answer after the code was entered. Start the sign-in again.")


def finished(d, result):
    """The reply for a sign-in whose helper has written its result. On success
    the helper goes on to restart the agents on that harness, so this replies
    without waiting for them; only the folder goes."""
    if not result.get("ok"):
        kill_login(d)
        fail(result.get("error") or "The sign-in did not finish.")
    shutil.rmtree(d, ignore_errors=True)
    return {"ok": True, "signedIn": True, "account": result.get("account")}


def helper_alive(info):
    try: os.kill(info["pid"], 0)
    except (KeyError, TypeError, OSError): return False
    return True


def key_finish(d, harness, key):
    """The pasted API key, checked against the service and then kept. A key
    that is refused, or that could not be checked, leaves this sign-in open so
    the person pastes again; only a kept key or an expired sign-in closes it."""
    service = KEYS[harness]["service"]
    key = key.strip() if isinstance(key, str) else ""
    if not KEY_RE.match(key):
        fail(f"That does not look like an API key. Copy the whole key from the {service} page and paste it again.")
    info = read_json(d / "helper.json", {}) or {}
    if time.time() - (info.get("startedAt") or 0) > (info.get("ttl") or LOGIN_TTL):
        kill_login(d)
        fail("This sign-in expired. Start the sign-in again.")
    ok, base, plan = verify_key(harness, key)
    if ok is None: fail(f"{service} could not be reached to check the key. Try again in a moment.")
    if not ok: fail(f"{service} did not accept that key. Check it and paste it again.")
    save_key(harness, key, base, plan)
    if "install" in KEYS[harness]: KEYS[harness]["install"](key)  # where the CLI reads it (Codex's own file)
    shutil.rmtree(d, ignore_errors=True)
    refresh_models(f"{harness}-key", wait=True)  # one GET: what this key offers, before its agents start
    spawn_restart(harness, "key")  # the agents paying by key, after the reply is free to go
    return {"ok": True, "signedIn": True, "account": None, "plan": plan}


def spawn_restart(harness, pays):
    """Starts `agentctl restart-agents <harness> <pays>` detached, so a
    sign-in's reply does not wait for each agent to come up."""
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "restart-agents", harness, pays], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def device_finish(d, harness):
    """Waits up to FINISH_WAIT seconds for the person to approve the code. Not
    yet: {"ok": true, "signedIn": false, "pending": true}, and the sign-in stays
    open for the next call. A helper that has stopped, or a sign-in past its
    lifetime, is an error, never pending again."""
    deadline = time.time() + FINISH_WAIT
    while True:
        result = read_json(d / "result.json")
        if result is not None: return finished(d, result)
        if not d.exists():
            fail("This sign-in has expired or was cancelled. Start the sign-in again.")
        info = read_json(d / "helper.json", {}) or {}
        if time.time() - (info.get("startedAt") or 0) > (info.get("ttl") or LOGIN_TTL) + 30:
            kill_login(d)
            fail("This sign-in code expired. Start the sign-in again.")
        if not helper_alive(info) and read_json(d / "result.json") is None:
            kill_login(d)
            fail(f"The {LABEL[harness]} sign-in stopped on this machine. Start the sign-in again.")
        if time.time() >= deadline: return {"ok": True, "signedIn": False, "pending": True}
        time.sleep(0.3)


def run_in_pty(argv, env, cwd):
    """Starts argv on a wide pty; returns (pid, fd)."""
    import pty, struct, termios
    pid, fd = pty.fork()
    if pid == 0:
        os.chdir(str(cwd))
        os.execve(argv[0], argv, env)
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 1000, 0, 0))
    return pid, fd


def device_helper(login_id, d, info):
    """Runs detached. Drives `<cli> login --device-auth` in a pty, in a fresh
    home inside the login folder, so a sign-in that is abandoned or refused
    never touches the one agents use. Once the CLI exits signed in, its
    auth.json is moved into homes/<harness> and checked for real."""
    import select
    harness = info["harness"]
    label = LABEL[harness]
    started = info.get("startedAt") or time.time()
    ttl = info.get("ttl") or LOGIN_TTL
    home = cli_home(harness, d / "home")
    pid, fd = run_in_pty([device_cli(harness), *DEVICE[harness]["login"]], device_env(harness, home), d)
    info.update({"pid": os.getpid(), "child": pid})
    write_private(d / "helper.json", json.dumps(info))
    raw = b""  # a device sign-in prints no secret, but keep it in memory only

    def pump(seconds):
        nonlocal raw
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: chunk = os.read(fd, 65536)
                except OSError: return False
                if not chunk: return False
                raw += chunk
        return True

    def exit_code():
        try:
            done, status = os.waitpid(pid, os.WNOHANG)
            return os.waitstatus_to_exitcode(status) if done else None
        except ChildProcessError:
            return -1

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass

    try:
        url = code = None
        while not (url and code):
            alive = pump(0.5)
            text = screen_text(raw)
            url = url or (DEVICE_URL_RE.search(text) or [None])[0]
            code = code or (USER_CODE_RE.search(text) or [None])[0]
            if url and code: break
            if not alive or exit_code() is not None or time.time() - started > 45:
                write_private(d / "state.json", json.dumps({"error": f"{label} did not give a sign-in code. Try again."}))
                return finish({"ok": False, "error": "no code"})
        write_private(d / "state.json", json.dumps({"url": url, "userCode": code, "expiresAt": started + ttl}))
        while True:
            alive = pump(0.5)
            status = exit_code()
            if status is None and alive:
                if not d.exists(): return finish({"ok": False, "error": "cancelled"})
                if time.time() - started > ttl:
                    return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
                continue
            if status is None:  # pty closed: give the CLI a moment to exit
                for _ in range(20):
                    status = exit_code()
                    if status is not None: break
                    time.sleep(0.25)
            text = screen_text(raw)
            new = home / CRED_FILE
            if status == 0 and new.exists() and new.read_bytes().strip():
                write_private(private_dir(cli_home(harness)) / CRED_FILE, new.read_text())
                new.unlink(missing_ok=True)
                run_check(harness, wait=True)
                _, check = last_check(harness)
                if check.get("ok") is False:
                    return finish({"ok": False, "error": f"{label} signed in, but {DEVICE[harness]['service']} refused the sign-in. Check the subscription and start the sign-in again."})
                finish({"ok": True, "account": check.get("account")})
                return restart_harness_agents(harness, "subscription")  # after the reply is free to go
            if re.search(r"expired|timed? ?out", text, re.I):
                return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
            if re.search(r"denied|declined|rejected|cancel", text, re.I):
                return finish({"ok": False, "error": "The sign-in was not approved. Start the sign-in again."})
            return finish({"ok": False, "error": f"{label} did not finish the sign-in. Start the sign-in again."})
    finally:
        raw = b""
        try: os.close(fd)
        except OSError: pass
        shutil.rmtree(d / "home", ignore_errors=True)


def member_helper(login_id, d, info):
    """Runs detached. Drives `qwen-account.mjs signin` (Qwen Code's own
    device sign-in) in a fresh home inside the login folder, so a sign-in that
    is abandoned or refused never touches the one agents use. It prints one
    JSON line with the link and code, then one with the outcome; a membership
    that is not Plus or Pro is refused, and a good one's credentials file is
    moved into homes/<harness> and checked for real."""
    import select
    harness = info["harness"]
    label, spec = LABEL[harness], MEMBER[harness]
    started = info.get("startedAt") or time.time()
    ttl = info.get("ttl") or LOGIN_TTL
    home = qwen_home(d / "home")
    node = node_cli()
    if not node or not account_script().exists():
        write_private(d / "state.json", json.dumps({"error": f"{label} is not installed on this machine."}))
        return write_private(d / "result.json", json.dumps({"ok": False, "error": "not installed"}))
    proc = subprocess.Popen([node, str(account_script()), "signin", str(qwen_package())], env=qwen_env(home), cwd=str(d),
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, start_new_session=True)
    info.update({"pid": os.getpid(), "child": proc.pid})
    write_private(d / "helper.json", json.dumps(info))

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.killpg(proc.pid, signal.SIGKILL)
        except OSError: pass

    def next_line(deadline):
        """The next JSON object the script prints, or None (nothing by the deadline, cancelled, or it exited)."""
        while time.time() < deadline:
            if not d.exists(): return None
            r, _, _ = select.select([proc.stdout], [], [], 0.5)
            if not r:
                if proc.poll() is not None: return None
                continue
            line = proc.stdout.readline()
            if not line: return None
            try: msg = json.loads(line)
            except ValueError: continue
            if isinstance(msg, dict): return msg
        return None

    try:
        device = next_line(started + 45)
        if not device or not device.get("url") or not device.get("userCode"):
            write_private(d / "state.json", json.dumps({"error": f"{label} did not give a sign-in code. Try again."}))
            return finish({"ok": False, "error": (device or {}).get("error") or "no code"})
        code = str(device["userCode"])
        write_private(d / "state.json", json.dumps({"url": device["url"], "userCode": code,
                                                    "expiresAt": int(device.get("expiresAt") or started + ttl)}))
        outcome = next_line(started + ttl)
        if not d.exists(): return finish({"ok": False, "error": "cancelled"})
        if outcome is None:
            return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
        if not outcome.get("ok"):
            why = str(outcome.get("error") or "")
            if re.search(r"expired|timeout|slow_down", why, re.I):
                return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
            if re.search(r"denied|declined|rejected|cancel", why, re.I):
                return finish({"ok": False, "error": "The sign-in was not approved. Start the sign-in again."})
            return finish({"ok": False, "error": f"{label} did not finish the sign-in. Start the sign-in again."})
        plan = str(outcome.get("memberType") or "").lower()
        new = home / spec["cred"]
        if plan not in spec["plans"]:
            new.unlink(missing_ok=True)
            return finish({"ok": False, "error": f"{label} needs a Plus or Pro membership on {spec['site']}; this account has {plan or 'none'}."})
        if not new.exists() or not new.read_bytes().strip():
            return finish({"ok": False, "error": f"{label} did not finish the sign-in. Start the sign-in again."})
        write_private(qwen_home() / spec["cred"], new.read_text())
        new.unlink(missing_ok=True)
        run_check(harness, wait=True)
        _, check = last_check(harness)
        if check.get("ok") is False:
            return finish({"ok": False, "error": f"{label} signed in, but {spec['service']} refused the sign-in. Check the membership and start the sign-in again."})
        finish({"ok": True, "account": outcome.get("account") or check.get("account")})
        refresh_models(harness, wait=True)  # what this membership offers, before its agents start
        return restart_harness_agents(harness, "subscription")  # after the reply is free to go
    finally:
        try: proc.stdout.close()
        except Exception: pass
        shutil.rmtree(d / "home", ignore_errors=True)


def login_helper(login_id):
    """Runs detached, for one sign-in. Whatever goes wrong, login.start and
    login.finish get an answer: an unexpected failure is written as the result."""
    d = LOGINS / login_id
    if not LOGIN_ID.match(login_id) or not d.is_dir(): return
    info = read_json(d / "helper.json", {})
    try:
        if info.get("harness") in DEVICE: return device_helper(login_id, d, info)
        if info.get("harness") in MEMBER: return member_helper(login_id, d, info)
        if info.get("harness") == "antigravity": return agy_helper(login_id, d, info)
        return claude_helper(login_id, d, info)
    except Exception as e:
        log_line("login", f"sign-in helper failed: {type(e).__name__}")
        if not d.exists() or (d / "result.json").exists(): return
        error = "The sign-in failed on this machine. Start the sign-in again."
        if not (read_json(d / "state.json") or {}).get("url"): write_private(d / "state.json", json.dumps({"error": error}))
        write_private(d / "result.json", json.dumps({"ok": False, "error": error}))


def claude_helper(login_id, d, info):
    """Drives `claude setup-token` in a pty."""
    import pty, select, struct, termios
    started = info.get("startedAt") or time.time()
    env = base_env()
    env.update({"TERM": "xterm-256color", "BROWSER": "/usr/bin/true", "COLUMNS": "1000", "LINES": "50"})
    cli = claude_cli()
    pid, fd = pty.fork()
    if pid == 0:
        os.chdir(str(d))
        os.execve(cli, [cli, "setup-token"], env)
    info.update({"pid": os.getpid(), "child": pid})
    write_private(d / "helper.json", json.dumps(info))
    # Wide enough that the link and the token never wrap.
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 1000, 0, 0))
    raw = b""  # held in memory only: after the code it contains the token

    def pump(seconds):
        nonlocal raw
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: chunk = os.read(fd, 65536)
                except OSError: return False
                if not chunk: return False
                raw += chunk
                return True
        return True

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass

    try:
        url = None
        while url is None:
            if time.time() - started > 45 or not pump(0.5):
                write_private(d / "state.json", json.dumps({"error": "Claude Code did not give a sign-in link. Try again."}))
                return finish({"ok": False, "error": "no link"})
            m = URL_RE.search(screen_text(raw))
            if m: url = m.group(0)
        write_private(d / "state.json", json.dumps({"url": url}))
        while not (d / "code").exists():
            if not d.exists() or time.time() - started > LOGIN_TTL:
                return finish({"ok": False, "error": "This sign-in expired. Start the sign-in again."})
            pump(0.5)  # keep the pty drained
        code = (d / "code").read_text().strip()
        (d / "code").unlink(missing_ok=True)
        raw = b""
        os.write(fd, code.encode())
        time.sleep(0.3)
        os.write(fd, b"\r")
        deadline = time.time() + 75
        alive = True
        while time.time() < deadline:
            alive = pump(0.5) and alive
            text = screen_text(raw)
            token = TOKEN_RE.search(text)
            if token:
                emails = EMAIL_RE.findall(text[token.end():] + text[:token.start()])
                account = emails[0] if emails else None
                save_claude_token(token.group(0), account)
                raw = b""
                finish({"ok": True, "account": account})
                refresh_claude_models(wait=True)  # what this sign-in offers, before its agents start
                return restart_harness_agents("claude", "subscription")  # after the reply is free to go
            err = re.search(r"OAuth error[^\n]*", text)
            if err:
                return finish({"ok": False, "error": "That code was not accepted. Start the sign-in again to get a new link."})
            if not alive:
                break
        finish({"ok": False, "error": "Claude Code did not finish the sign-in. Start the sign-in again."})
    finally:
        # What Claude Code showed after the code went in, for diagnosing a
        # sign-in that did not finish. The token and the code are masked first.
        try:
            shown = TOKEN_RE.sub("<token>", screen_text(raw))
            if "code" in dir() and code: shown = shown.replace(code, "<code>")
            if not (ROOT / "secrets" / "claude").exists() or "<token>" not in shown:
                write_private(private_dir(ROOT / "run") / "login-debug.txt", shown[-4000:])
        except Exception:
            pass
        raw = b""
        try: os.close(fd)
        except OSError: pass


def agy_helper(login_id, d, info):
    """Runs detached. Drives `agy acp --login` in a pty, in a fresh folder
    inside the login folder, so a sign-in that is abandoned or refused never
    touches the one agents use: it prints a Google link, then takes the code
    antigravity.google shows. Once agy exits signed in, its sign-in file moves
    into homes/antigravity and is checked for real."""
    import select
    label = LABEL["antigravity"]
    started = info.get("startedAt") or time.time()
    ttl = info.get("ttl") or LOGIN_TTL
    home = agy_home(d / "home")
    env = agy_env(home)
    env.update({"TERM": "xterm-256color", "COLUMNS": "4000", "LINES": "50"})
    pid, fd = run_in_pty([agy_cli(), *AGY["login"], "--gemini-dir", str(home)], env, d)
    info.update({"pid": os.getpid(), "child": pid})
    write_private(d / "helper.json", json.dumps(info))
    raw = b""  # held in memory only: it echoes the code
    code = None

    def pump(seconds):
        nonlocal raw
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: chunk = os.read(fd, 65536)
                except OSError: return False
                if not chunk: return False
                raw += chunk
        return True

    def exit_code():
        try:
            done, status = os.waitpid(pid, os.WNOHANG)
            return os.waitstatus_to_exitcode(status) if done else None
        except ChildProcessError:
            return -1

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass

    try:
        url = None
        while url is None:
            alive = pump(0.5)
            m = AGY_URL_RE.search(screen_text(raw).replace("\n", " "))
            if m: url = m.group(0); break
            if not alive or exit_code() is not None or time.time() - started > 45:
                write_private(d / "state.json", json.dumps({"error": f"{label} did not give a sign-in link. Try again."}))
                return finish({"ok": False, "error": "no link"})
        write_private(d / "state.json", json.dumps({"url": url}))
        while not (d / "code").exists():
            if not d.exists() or time.time() - started > ttl:
                return finish({"ok": False, "error": "This sign-in expired. Start the sign-in again."})
            if not pump(0.5) or exit_code() is not None:
                return finish({"ok": False, "error": f"{label} stopped waiting for the code. Start the sign-in again."})
        code = (d / "code").read_text().strip()
        (d / "code").unlink(missing_ok=True)
        raw = b""
        os.write(fd, code.encode())
        time.sleep(0.3)
        os.write(fd, b"\r")
        deadline = time.time() + 75
        status = None
        while time.time() < deadline:
            alive = pump(0.5)
            status = exit_code()
            if status is not None or not alive: break
        if status is None:
            for _ in range(20):
                status = exit_code()
                if status is not None: break
                time.sleep(0.25)
        text = screen_text(raw).replace(code, "")
        signed = agy_token(home)
        if status == 0 and signed:
            account = signed.get("id_token_email") if isinstance(signed.get("id_token_email"), str) else None
            if not account:
                emails = EMAIL_RE.findall(text)
                account = emails[-1].rstrip(".") if emails else None
            agents = agy_home()
            for parts in AGY["with_cred"] + (AGY["cred"],):  # the sign-in file last
                source = home.joinpath(*parts)
                if not source.exists(): continue
                target = agents.joinpath(*parts)
                private_dir(target.parent)
                write_private(target, source.read_text())
                source.unlink(missing_ok=True)
            save_agy_account(account)
            run_check("antigravity", wait=True)
            _, check = last_check("antigravity")
            if check.get("ok") is False:
                return finish({"ok": False, "error": f"{label} signed in, but Google refused the sign-in. Check the account and start the sign-in again."})
            finish({"ok": True, "account": account})
            refresh_models("antigravity", wait=True)  # what this account offers, before its agents start
            return restart_harness_agents("antigravity", "subscription")  # after the reply is free to go
        if re.search(r"invalid_grant|invalid.{0,20}code|malformed|bad request", text, re.I):
            return finish({"ok": False, "error": "That code was not accepted. Start the sign-in again to get a new link."})
        return finish({"ok": False, "error": f"{label} did not finish the sign-in. Start the sign-in again."})
    finally:
        raw = b""
        code = None
        try: os.close(fd)
        except OSError: pass
        shutil.rmtree(d / "home", ignore_errors=True)


def logout(harness, pays="subscription"):
    """Forgets one sign-in of a harness and stops the agents paying with it."""
    if pays not in PAYS: fail('pays is "subscription" or "key"')
    if pays == "key":
        if harness not in KEYS: fail("That harness has no API key on this machine.")
        forget_key(harness)
    elif harness == "claude":
        forget_claude_token()
        sync_platform_signin()  # this person's agents there stop too
    elif harness in DEVICE: forget_device(harness)
    elif harness in MEMBER: forget_member(harness)
    elif harness == "antigravity": forget_agy()
    else: fail("Buzz cannot sign that harness out on this machine.")
    stop_harness_agents(harness, pays)
    return {"ok": True}


# ---------------------------------------------------------------- Buzz profile

def buzz(d, *args):
    s = read_settings(d)
    env = dict(base_env(), BUZZ_PRIVATE_KEY=(d / "key").read_text().strip(),
               BUZZ_RELAY_URL=s["community"], BUZZ_AUTH_TAG=json.dumps(s["auth"]))
    return subprocess.run([str(BIN / "buzz"), *args], env=env, capture_output=True, text=True, timeout=30)


def publish_profile(d):
    s = read_settings(d)
    args = ["users", "set-profile", "--name", s["name"]]
    if s.get("picture"): args += ["--avatar", s["picture"]]
    done = buzz(d, *args)
    return done.returncode == 0, (done.stderr or done.stdout)[-300:]


def owner_of(settings):
    auth = settings.get("auth")
    if isinstance(auth, list) and len(auth) == 4 and HEX64.match(str(auth[1])): return auth[1]
    return None


def community_url(value):
    if not isinstance(value, str) or not re.match(r"^(wss|https)://[A-Za-z0-9.-]+(:\d+)?/?$", value):
        fail("community must be a wss:// or https:// address")
    return "https://" + value.split("://", 1)[1].rstrip("/")


# ---------------------------------------------------------------- the customer-facing profile
# Staff agents keep full access (FULL_ACCESS). An agent customers talk to (an
# account manager) runs with access "platform" instead:
#   - Claude Code only, with the Black 4 MCP and WebFetch and nothing else: no
#     shell, no file tools, no subagents. Two locks, each enough alone, both
#     in the agent's own Claude home (agents/<pubkey>/claude, written at every
#     start): Claude Code's deny rules, which take the tools out of the
#     model's list, and a PreToolUse hook (`agentctl tool-gate`) that refuses
#     every tool outside the allowed set. buzz-acp runs it in the adapter's
#     default permission mode, never bypassPermissions; it approves every
#     permission prompt itself, so a prompt is no lock. (claude-agent-acp
#     0.94.0 offers no dontAsk mode, so buzz-acp could not set one.) Checked on
#     the Commerce Mac, 2026-11-17, through claude-agent-acp as buzz-acp
#     drives it: with the deny rules, Bash, Read, Write, Glob and Agent were
#     not offered; with the hook alone, each was refused by it; an @path in a
#     message reached no file.
#   - its audience is one business (respondTo "business").
#   - it lives on a runner of its own, run by a separate macOS user with its
#     own workforce root (runner.json {"profile": "platform"}), so even a
#     broken lock reads none of the staff agents' keys or sign-ins. The main
#     runner forwards every request about such an agent to that runner with
#     `sudo -n -u <user>` (runner.json {"platform": {"user", "agentctl"}} on
#     the main runner, written by machine/platform-user.sh), along with the
#     creator's Claude sign-in, which the platform runner keeps in its own
#     accounts/ (it cannot read the main runner's).
ACCESS_PROFILES = ("full", "platform")
PLATFORM_TOOLS = ("WebFetch", "ToolSearch")   # besides the Black 4 MCP's own (mcp__black4__*)
PLATFORM_MCP_PREFIX = "mcp__black4__"
PLATFORM_DENY = ("Bash", "BashOutput", "KillBash", "KillShell", "PowerShell", "Read", "Write", "Edit", "MultiEdit",
                 "NotebookEdit", "NotebookRead", "Glob", "Grep", "LS", "LSP", "WebSearch", "Task", "Agent", "Workflow",
                 "TaskCreate", "TaskUpdate", "TaskOutput", "TaskStop", "SendMessage", "Skill", "SlashCommand", "Monitor",
                 "CronCreate", "CronDelete", "ScheduleWakeup", "RemoteTrigger", "EnterWorktree", "ExitWorktree",
                 "EnterPlanMode", "ExitPlanMode", "TodoWrite", "ListMcpResourcesTool", "ReadMcpResourceTool", "ListAgents",
                 "ReportFindings", "AskUserQuestion", "mcp__acp")
# Customers talk only to customer-facing agents: a full-access agent never
# answers a business.
BUSINESS_NEEDS_PLATFORM = ("An agent that answers a business is customer-facing: it is made as one (access platform), "
                           "with only the Black 4 tools. A full-access agent answers staff.")
FORWARDED_SIGNIN_OPS = {"provision", "activate", "start", "settings.set", "instructions.set", "heartbeat.set", "profile"}


def access_of(s):
    return "platform" if s.get("access") == "platform" else "full"


def runner():
    """This runner's runner.json: {"profile": "platform"} on the customer-facing
    runner, {"platform": {...}} on a main runner that has one."""
    data = read_json(RUNNER_FILE)
    return data if isinstance(data, dict) else {}


def platform_runner():
    """Whether this is the customer-facing runner."""
    return runner().get("profile") == "platform"


def platform_target():
    """The customer-facing runner the main runner forwards to, or None."""
    target = runner().get("platform")
    if not isinstance(target, dict) or not isinstance(target.get("agentctl"), str): return None
    user = target.get("user")
    if user is not None and not (isinstance(user, str) and re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user)): return None
    return target


def seated_problem(d, s):
    """Why this customer-facing agent may not start, or None. Black 4 acts as
    an agent's owner unless the agent is seated in a business (Platform
    Control's seat_agent), and then only in that business. So it starts only
    when its own whoami says so: kind customer, businesses exactly its own."""
    status, result = ask_black4(d, s, "whoami")
    if status != "ok": return f"Black 4 could not confirm this agent's seat ({result}), so it does not start."
    data = None
    for part in (result or {}).get("content") or []:
        if isinstance(part, dict) and part.get("type") == "text":
            try: data = json.loads(part.get("text") or "")
            except ValueError: pass
            break
    data = (data or {}).get("data", data) if isinstance(data, dict) else {}
    business = s.get("businessId")
    if data.get("kind") == "customer" and data.get("businesses") == [business]: return None
    return (f"This customer-facing agent is not seated in {business}: Black 4 would let it act as its owner ({data.get('kind') or 'unknown'}). "
            "Black 4 staff seat it first (seat_agent with this agent's key and that business).")


def tool_allowed(name):
    return isinstance(name, str) and (name in PLATFORM_TOOLS or (name.startswith(PLATFORM_MCP_PREFIX) and len(name) > len(PLATFORM_MCP_PREFIX)))


def tool_gate():
    """`agentctl tool-gate`: Claude Code's PreToolUse hook for a platform
    agent. Exit 0 lets an allowed tool through; anything else, or input it
    cannot read, exits 2, which blocks the call and tells the model why."""
    try:
        name = json.loads(sys.stdin.read() or "{}").get("tool_name")
    except (ValueError, AttributeError):
        name = None
    if tool_allowed(name): return 0
    sys.stderr.write(f"{name or 'This tool'} is not available to this agent. It has only the Black 4 tools and WebFetch.\n")
    return 2


def platform_settings():
    """Claude Code's user settings for a platform agent."""
    gate = f"{PYTHON} {SELF} tool-gate"
    return {
        "permissions": {"defaultMode": "default", "allow": ["mcp__black4", *PLATFORM_TOOLS], "deny": list(PLATFORM_DENY),
                        "disableBypassPermissionsMode": "disable"},
        "hooks": {"PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": gate, "timeout": 10}]}]},
        "enableAllProjectMcpServers": False,
        "disableAllHooks": False,
    }


def platform_home(d):
    """The platform agent's own Claude home, its settings written anew."""
    home = private_dir(d / "claude")
    write_private(home / "settings.json", json.dumps(platform_settings(), indent=2))
    return home


def forward(req, signin=None):
    """Sends one request to the customer-facing runner and returns its reply."""
    target = platform_target()
    if not target: fail("This machine has no customer-facing runner yet. A Black 4 admin sets one up (machine/platform-user.sh).")
    argv = [target["agentctl"], *(["--caller", CALLER] if CALLER else [])]
    if target.get("user"): argv = ["/usr/bin/sudo", "-n", "-u", target["user"], "-H", *argv]
    body = dict(req, **({"signin": signin} if signin else {}))
    env = {**base_env(), **({"AGENTCTL_HOME": target["home"]} if target.get("home") and not target.get("user") else {})}
    try:
        done = subprocess.run(argv, input=json.dumps(body), capture_output=True, text=True, timeout=180, env=env, cwd="/")
    except (OSError, subprocess.TimeoutExpired) as e:
        fail(f"The customer-facing runner did not answer ({type(e).__name__}).")
    for line in reversed((done.stdout or "").strip().splitlines()):
        try: reply = json.loads(line)
        except ValueError: continue
        if isinstance(reply, dict):
            if not reply.get("ok"): fail(str(reply.get("error") or "the customer-facing runner refused"))
            return reply
    fail("The customer-facing runner did not answer: " + (done.stderr or "")[-200:].strip())


def creator_signin(creator):
    """The creator's Claude sign-in, for the customer-facing runner, which
    cannot read this runner's accounts. None when they have none."""
    if not creator: return None
    saved = ACCOUNT
    use_account(creator)
    try:
        token = claude_token()
        return {"account": creator, "claude": token} if token else {"account": creator, "claude": None}
    finally:
        use_account(saved)


def take_signin(signin):
    """On the customer-facing runner: keep the creator's sign-in that came
    with a forwarded request (None drops it)."""
    if not isinstance(signin, dict) or not ACCOUNT_NAME.fullmatch(str(signin.get("account") or "")): return
    saved = ACCOUNT
    use_account(signin["account"])
    try:
        token = signin.get("claude")
        if isinstance(token, str) and TOKEN_RE.fullmatch(token.strip()):
            if claude_token() != token.strip(): save_claude_token(token.strip(), None)
        elif token is None and claude_token():
            forget_claude_token()
    finally:
        use_account(saved)


def platform_rows(op):
    """The customer-facing runner's agents, for list and identity here."""
    if not platform_target(): return []
    try: reply = forward({"op": op})
    except Fail as e:
        log_line("supervisor", f"customer-facing runner: {str(e)[:200]}")
        return []
    return [dict(row, runner="platform") for row in reply.get("agents") or [] if isinstance(row, dict)]


def handle_forwarded(req):
    """On the main runner: a request that belongs to the customer-facing
    runner, sent there; None when it is this runner's own."""
    if platform_runner() or not platform_target(): return None
    op = req.get("op")
    if op == "provision":
        if (req.get("config") or {}).get("access") != "platform": return None
        return forward(req, creator_signin(CALLER) if CALLER else None)
    if not isinstance(req.get("pubkey"), str) or not HEX64.match(req["pubkey"]) or (AGENTS / req["pubkey"]).exists(): return None
    rows = {row.get("pubkey"): row for row in platform_rows("list")}
    if req["pubkey"] not in rows: return None
    return forward(req, creator_signin(rows[req["pubkey"]].get("createdBy")) if op in FORWARDED_SIGNIN_OPS else None)


def sync_platform_signin():
    """After this runner's Claude sign-in changed: hand it to the customer-
    facing runner, which restarts that person's agents on it."""
    if platform_runner() or not platform_target() or not ACCOUNT: return
    try: forward({"op": "signin.sync"}, creator_signin(ACCOUNT))
    except Fail as e: log_line("supervisor", f"customer-facing runner sign-in sync: {str(e)[:200]}")


# ---------------------------------------------------------------- requests

CHANGES = {"remove", "activate", "profile", "instructions.set", "settings.set", "start", "heartbeat.set"}
SELF_APPLY = {"profile", "instructions.set", "settings.set", "start", "heartbeat.set"}  # restart later when the agent asks


def model_fields(s, cache=None, d=None):
    """What status and list say about an agent's model: the model and effort
    it runs with, whether it chose them (modelChosen, effortChosen), and
    modelNote or modelProblem when the machine has one. A running agent
    reports what it was started with (launch.json), which is what it runs
    until it restarts; a stopped one what it would start with now. `cache`
    keeps one offered() per harness across a list."""
    harness = s.get("harness") or "claude"
    if harness not in DEFAULTS: return {"model": None, "effort": None}
    compact_at = s.get("compactAt") if isinstance(s.get("compactAt"), int) and not isinstance(s.get("compactAt"), bool) else None
    chosen = {"modelChosen": bool(s.get("model")), "effortChosen": bool(s.get("effort")), "compactAt": compact_at, "controls": controls_of(s)}
    slot = slot_of(harness, pays_of(s))
    if cache is None: cache = {}
    if slot not in cache: cache[slot] = offered(slot)
    picked = choice(harness, s, cache[slot])
    unchecked = f"The machine has not yet checked that {LABEL[harness]} offers this model on its sign-in."
    if d is not None and running(d):
        launched = read_json(d / "launch.json")
        if not isinstance(launched, dict):
            return {"model": None, "effort": None, **chosen, "modelChecked": False,
                    "modelNote": f"Started before agents had a model here; it runs {LABEL[harness]}'s own default until it restarts."}
        checked = launched.get("checked", True) is not False or picked.get("checked", True)
        note = launched.get("note") or (None if checked else unchecked)
        return {"model": launched.get("model"), "effort": launched.get("effort"), **chosen, "modelChecked": bool(checked),
                **({"modelNote": note} if note else {}),
                **({"modelProblem": picked["problem"]} if picked.get("problem") else {})}
    checked = picked.get("checked", True)
    note = picked.get("note") or (None if checked else unchecked)
    return {"model": picked.get("model"), "effort": picked.get("effort"), **chosen, "modelChecked": checked,
            **({"modelNote": note} if note else {}),
            **({"modelProblem": picked["problem"]} if picked.get("problem") else {})}


def may_change(settings, op):
    """Every caller sees and changes every agent: Black 4's agents are the
    whole staff's. Only removing one is its creator's (or the admin's, the
    machine owner's own key, which has no label). A change never moves whose
    sign-ins the agent runs on: always its creator's."""
    creator = settings.get("createdBy")
    if op == "remove" and CALLER and creator != CALLER:
        fail(f"This agent belongs to {creator or 'the machine owner'}. Only they or a Black 4 admin can remove it.")

def handle(req):
    if not isinstance(req, dict): fail("request must be a JSON object")
    op = req.get("op")
    private_dir(AGENTS)
    # Sign-ins, the machine's status and its models are the caller's own.
    use_account(CALLER)
    # A creator's sign-in comes along only from the main runner to the
    # customer-facing one (see "the customer-facing profile"); from anyone
    # else it is dropped unread.
    signin = req.pop("signin", None)
    if platform_runner(): take_signin(signin)
    if op == "signin.sync":
        if not platform_runner(): fail("unknown op")
        who = signin.get("account") if isinstance(signin, dict) else None
        use_account(who)
        if claude_token(): restart_harness_agents("claude", "subscription")
        else: stop_harness_agents("claude", "subscription")
        return {"ok": True}
    forwarded = handle_forwarded(req)
    if forwarded is not None: return forwarded

    if op == "machine.status": return machine_status()
    if op == "models": return models_reply()
    if op == "doctor": return doctor()
    if op == "login.start":
        harness, pays = req.get("harness"), req.get("pays") or "subscription"
        # The caller signs in their own account; their agents run on it.
        if not ACCOUNT: fail("Sign in to a model from Buzz as yourself: this machine keeps every sign-in under the person who made it.")
        return login_start(harness, req.get("flows"), pays)
    if op == "login.finish": return login_finish(req.get("loginId"), req.get("code"))
    if op == "login.cancel":
        d = login_dir(req.get("loginId"))
        if d.exists(): kill_login(d)
        return {"ok": True}
    if op == "logout":
        if not ACCOUNT: fail("Sign out from Buzz as the person who signed in.")
        return logout(req.get("harness"), req.get("pays") or "subscription")

    if op == "provision":
        name = (req.get("name") or "").strip()
        if not name or len(name) > 128: fail("name is required (128 characters at most)")
        # A retried creation gets the same agent back, not a second key.
        for d in agent_dirs():
            s = read_settings(d)
            if (s.get("name") == name and not s.get("auth") and s.get("requestId") == req.get("requestId")
                    and s.get("createdBy") == CALLER):
                return {"ok": True, "pubkey": d.name}
        community = community_url(req.get("community"))
        config = req.get("config") or {}
        harness = config.get("harness") or "claude"
        if harness not in HARNESS: fail(f"unknown harness {str(harness)[:40]!r}")
        # How it pays is settled now and kept: a default that moved with the
        # machine's sign-ins would move the agent's bill without a word.
        pays = checked_pays(harness, config.get("pays"))
        model, effort = checked_choice(harness, config.get("model"), config.get("effort"), pays)
        # When it compacts its context: 150k tokens for a new agent, where the
        # harness takes it on the model the agent will run.
        runs = model or choice(harness, {"pays": pays}).get("model")
        compact_at = checked_compact(harness, config["compactAt"], runs) if config.get("compactAt") not in (None, "") else default_compact(harness, runs)
        # Whom it answers: staff unless it says otherwise ("anyone" here is an
        # older plugin's default, so it is staff too).
        audience, business = checked_audience(config.get("respondTo"), config.get("businessId"), explicit_anyone=False)
        access = config.get("access") or "full"
        if access not in ACCESS_PROFILES: fail("access is full or platform")
        if access == "platform":
            if not platform_runner(): fail("This machine has no customer-facing runner yet. A Black 4 admin sets one up (machine/platform-user.sh).")
            if harness != "claude": fail("A customer-facing agent runs Claude Code: it is the harness whose tools Black 4 locks down.")
            if pays != "subscription": fail("A customer-facing agent pays with its creator's Claude subscription.")
            if audience != "business": fail("A customer-facing agent answers one business: choose it (respondTo business, businessId).")
        elif platform_runner():
            fail("This runner is for customer-facing agents only (access platform).")
        elif audience == "business":
            fail(BUSINESS_NEEDS_PLATFORM)
        secret = secrets.token_hex(32)
        while not 0 < int(secret, 16) < N: secret = secrets.token_hex(32)
        pubkey = pubkey_of(secret)
        d = AGENTS / pubkey
        d.mkdir(mode=0o700)
        fd = os.open(d / "key", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.write(fd, secret.encode()); os.close(fd)
        write_settings(d, {
            "name": name, "picture": req.get("picture"), "requestId": req.get("requestId"),
            "community": community,
            "harness": harness, "pays": pays, "model": model, "effort": effort, "compactAt": compact_at,
            "instructions": config.get("instructions") or "",
            "respondTo": audience, **({"businessId": business} if business else {}), "access": access,
            "createdAt": int(time.time()), "createdBy": CALLER,
        })
        return {"ok": True, "pubkey": pubkey}

    if op == "identity":
        # Which owner key each agent attests, so the owner can be linked to a
        # Black 4 account. Public keys only; no key file is opened.
        return {"ok": True, "agents": [
            {"pubkey": d.name, "name": read_settings(d).get("name"),
             "owner": owner_of(read_settings(d))} for d in agent_dirs()] + platform_rows("identity")}

    if op == "list":
        rows, cache = [], {}
        for d in agent_dirs():
            s = read_settings(d)
            as_agent(d, s)
            rows.append({"pubkey": d.name, "name": s.get("name"), "harness": s.get("harness"), "pays": pays_of(s),
                         "respondTo": respond_to(s), "audience": audience_view(d, s), "activated": bool(s.get("auth")), "running": bool(running(d)),
                         "keepsStopping": keeps_stopping(d), "createdBy": s.get("createdBy"), "heartbeat": heartbeat_minutes(s),
                         "picture": s.get("picture"), "owner": owner_of(s), "yours": bool(CALLER) and s.get("createdBy") == CALLER,
                         "access": access_of(s), **model_fields(s, cache.setdefault(ACCOUNT, {}), d)})
        return {"ok": True, "agents": rows + platform_rows("list")}

    d = folder(req.get("pubkey"))
    if op in CHANGES and d.exists(): may_change(read_settings(d), op)
    # The agent itself asking (from its shell): its restart waits for its turn.
    me = CALLER is None and op in SELF_APPLY and d.exists() and inside_agent(d)
    later = {"applies": "after this turn"} if me else {}
    # Asked for in person: the supervisor's backoff starts over.
    if op in ("start", "activate", "instructions.set", "settings.set") and d.exists(): (d / "restarts.json").unlink(missing_ok=True)
    if op == "remove":
        if d.exists():
            with agent_lock(d): stop(d)
            shutil.rmtree(d)
        drop_persistence()
        return {"ok": True}
    if not d.exists(): fail("no such agent on this machine")
    s = read_settings(d)
    # Everything about one agent (its models, how it pays, its start) is on
    # its creator's sign-ins, whoever asks.
    as_agent(d, s)

    if op == "activate":
        auth = req.get("auth")
        if (not isinstance(auth, list) or len(auth) != 4 or auth[0] != "auth"
                or not HEX64.match(str(auth[1])) or not re.match(r"^[0-9a-f]{128}$", str(auth[3]))):
            fail("auth must be a NIP-OA tag: [auth, owner, conditions, signature]")
        s["auth"] = auth
        s["community"] = community_url(req.get("community") or s["community"])
        for key in ("harness", "model", "effort", "instructions", "heartbeat", "pays", "compactAt"):
            if (req.get("config") or {}).get(key) is not None: s[key] = req["config"][key]
        config = req.get("config") or {}
        if config.get("respondTo") is not None:
            # As at provision: "anyone" from the Create form is an older plugin's default.
            s["respondTo"], business = checked_audience(config["respondTo"], config.get("businessId", s.get("businessId")), explicit_anyone=False)
            if (s["respondTo"] == "business") != (access_of(s) == "platform"):
                fail(BUSINESS_NEEDS_PLATFORM if s["respondTo"] == "business" else "A customer-facing agent answers one business.")
            if business: s["businessId"] = business
            else: s.pop("businessId", None)
        # What each heartbeat does, chosen with the agent ("" keeps Black 4's standard).
        prompt = (req.get("config") or {}).get("heartbeatPrompt")
        if prompt is not None:
            if not isinstance(prompt, str): fail("heartbeatPrompt is text")
            s["heartbeatPrompt"] = prompt.strip()[:HEARTBEAT_PROMPT_MAX]
        harness = s.get("harness") or "claude"
        if harness not in HARNESS: fail(f"unknown harness {str(harness)[:40]!r}")
        s["pays"] = checked_pays(harness, s.get("pays"))
        s["model"], s["effort"] = checked_choice(harness, s.get("model"), s.get("effort"), s["pays"])
        if "compactAt" in s: s["compactAt"] = checked_compact(harness, s.get("compactAt"), s.get("model") or None)
        write_settings(d, s)
        pid = start(d)
        ok, detail = publish_profile(d)
        return {"ok": True, "pid": pid, "profilePublished": ok, **({} if ok else {"profileError": detail})}

    if op == "profile":
        renamed = bool(req.get("name")) and req["name"].strip() != (s.get("name") or "")
        if req.get("name"): s["name"] = req["name"].strip()
        if "picture" in req: s["picture"] = req.get("picture")
        write_settings(d, s)
        ok, detail = publish_profile(d)
        if not ok: fail("profile was not published: " + detail)
        # A new name reaches Black 4's records from the agent's next start.
        if renamed and s.get("auth") and running(d): defer_apply(d) if me else start(d)
        return {"ok": True, **(later if renamed else {})}

    if op == "heartbeat.get":
        return {"ok": True, **heartbeat_view(s)}
    if op == "heartbeat.set":
        # minutes: 0 turns it off; prompt: what each heartbeat does, "" for the default.
        if "minutes" in req:
            minutes = req.get("minutes")
            if minutes not in (0, None) and (not isinstance(minutes, int) or isinstance(minutes, bool)
                                             or not HEARTBEAT_MIN <= minutes <= HEARTBEAT_MAX):
                fail(f"minutes is 0 (off) or {HEARTBEAT_MIN} to {HEARTBEAT_MAX}")
            s["heartbeat"] = minutes or 0
        if "prompt" in req:
            prompt = req.get("prompt")
            if prompt is not None and not isinstance(prompt, str): fail("prompt is text")
            s["heartbeatPrompt"] = (prompt or "").strip()[:HEARTBEAT_PROMPT_MAX]
        write_settings(d, s)
        if s.get("auth"): defer_apply(d) if me else start(d)
        return {"ok": True, **heartbeat_view(s), **later}

    if op == "instructions.get":
        return {"ok": True, "instructions": s.get("instructions") or ""}
    if op == "instructions.set":
        with agent_lock(d):
            s = read_settings(d)
            s["instructions"] = str(req.get("instructions") or "")[:20000]
            write_settings(d, s)
            if s.get("auth"): defer_apply(d) if me else _start(d)
        return {"ok": True, **later}

    if op == "settings.set":
        # The agent's model and effort ("" is the harness's default here), how
        # it pays ("subscription" or "key"; "" settles the machine's default
        # now), compactAt (tokens; null for the harness's default), whom it
        # answers (respondTo and businessId: see "whom an agent answers";
        # allow is kept for older plugins and not used) and buzz-acp's levers. A field left out stays
        # as it was; a new way of paying drops a model and effort not sent with
        # it, since the other sign-in offers its own. An activated agent
        # restarts on them.
        audience_change = any(k in req for k in ("respondTo", "businessId", "allow"))
        if audience_change and CALLER is None and inside_any_agent():
            # Whom an agent answers is a person's choice, never the agent's own
            # (nor another agent's): an agent's shell runs agentctl as the admin.
            fail("An agent cannot change whom an agent answers. A person changes it in the agent's Settings in Buzz.")
        if "allow" in req and (not isinstance(req["allow"], list) or any(not HEX64.match(str(k)) for k in req["allow"])):
            fail("allow is a list of public keys (64 hex characters each)")
        current = read_settings(d)
        if "respondTo" in req or "businessId" in req:
            audience, business = checked_audience(req.get("respondTo", respond_to(current)), req.get("businessId", current.get("businessId")))
            if access_of(current) == "platform" and audience != "business": fail("A customer-facing agent answers one business.")
            if access_of(current) != "platform" and audience == "business": fail(BUSINESS_NEEDS_PLATFORM)
        if access_of(current) == "platform" and req.get("pays") not in (None, "", "subscription"):
            fail("A customer-facing agent pays with its creator's Claude subscription.")
        with agent_lock(d):
            s = read_settings(d)
            harness = s.get("harness") or "claude"
            pays = checked_pays(harness, req["pays"]) if "pays" in req else pays_of(s)
            changed = pays != pays_of(s)
            model = req["model"] if "model" in req else ("" if changed else s.get("model"))
            effort = req["effort"] if "effort" in req else ("" if changed else s.get("effort"))
            s["model"], s["effort"] = checked_choice(harness, model, effort, pays)
            s["pays"] = pays
            if "compactAt" in req: s["compactAt"] = checked_compact(harness, req["compactAt"], s["model"] or choice(harness, s).get("model"))
            for name in CONTROLS:
                if name in req: s[name] = checked_control(name, req[name])
            if "respondTo" in req or "businessId" in req:
                if (audience, business) != (respond_to(s), s.get("businessId")): (d / "audience.json").unlink(missing_ok=True)
                s["respondTo"] = audience
                if business: s["businessId"] = business
                else: s.pop("businessId", None)
            if "allow" in req: s["allow"] = list(dict.fromkeys(str(k) for k in req["allow"]))
            write_settings(d, s)
            if s.get("auth"): defer_apply(d) if me else _start(d)
        return {"ok": True, "pays": pays, "respondTo": respond_to(s), "audience": audience_view(d, s), "allow": s.get("allow") or [], **model_fields(s, d=d), **later}

    if op == "start":
        if me:
            defer_apply(d)
            return {"ok": True, "pid": running(d), **later}
        return {"ok": True, "pid": start(d)}

    if op == "status":
        r = restarts(d)
        return {"ok": True, "running": bool(running(d)), "activated": bool(s.get("auth")),
                "name": s.get("name"), "harness": s.get("harness"), "pays": pays_of(s), "respondTo": respond_to(s), "audience": audience_view(d, s), "allow": s.get("allow") or [],
                "keepsStopping": keeps_stopping(d), "restarts": r.get("count", 0), "access": access_of(s), **model_fields(s, d=d),
                "createdBy": s.get("createdBy"), "yours": bool(CALLER) and s.get("createdBy") == CALLER,
                **({"nextRestart": int(r["next"])} if r.get("next") and not running(d) else {}),
                "log": log_tail(d, 1500)}

    fail("unknown op")


def print_list():
    """`agentctl list`: each agent, whom it answers and whether it runs."""
    for d in agent_dirs():
        s = read_settings(d)
        state = "running" if running(d) else ("stopped" if s.get("auth") else "not set up")
        print(f"{d.name[:8]}  {audience_line(s.get('name') or '?', audience_view(d, s))}; {LABEL.get(s.get('harness') or 'claude', '?')}, {state}")
    return 0


def adopt_signins(who):
    """Once, by the admin on the machine: the sign-ins made before they were
    each person's (secrets/, homes/, logins/ and the sign-in caches in run/
    at the root) become `who`'s, and so do agents with no recorded creator.
    Refused when `who` already has sign-ins, so it never merges two people's."""
    if not (CALLER_EMAIL.fullmatch(who) or CALLER_LABEL.fullmatch(who)): fail("give a staff email or a teammate label")
    target = account_root(who)
    if target.exists(): fail(f"{who} already has sign-ins on this machine")
    private_dir(target.parent)
    target.mkdir(mode=0o700)
    for name in ("secrets", "homes", "logins"):
        if (ROOT / name).exists(): (ROOT / name).rename(target / name)
    run = private_dir(target / "run")
    if RUN.exists():
        for f in RUN.iterdir():
            if re.fullmatch(r"[a-z]+(-key)?-(check|models)\.(json|lock)", f.name): f.rename(run / f.name)
    moved = []
    for d in agent_dirs():
        s = read_settings(d)
        if not s.get("createdBy"):
            s["createdBy"] = who
            write_settings(d, s)
            moved.append(d.name)
    print(json.dumps({"ok": True, "account": who, "agents": moved}))


def main(argv=None):
    global CALLER
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["--caller"]:
        # Only an authorized_keys forced command or the door passes this, and
        # then nothing else: a teammate's key never reaches supervise or a helper.
        if len(argv) != 2 or not (CALLER_LABEL.fullmatch(argv[1]) or CALLER_EMAIL.fullmatch(argv[1])):
            print(json.dumps({"ok": False, "error": "this key's caller label is not valid; ask an admin to add it again"}))
            return
        CALLER, argv = argv[1], []
    use_account(os.environ.get("AGENTCTL_ACCOUNT") or None)
    if argv[:1] == ["adopt-signins"] and len(argv) == 2: return adopt_signins(argv[1])
    if argv[:1] == ["tool-gate"] and len(argv) == 1: sys.exit(tool_gate())
    if argv[:1] == ["supervise"]: return supervise()
    if argv[:1] == ["audience"] and len(argv) == 2 and HEX64.match(argv[1]) and (AGENTS / argv[1]).is_dir():
        return refresh_audience(AGENTS / argv[1]) and None
    if argv[:1] == ["dropped"] and len(argv) == 2 and HEX64.match(argv[1]) and (AGENTS / argv[1]).is_dir():
        return handle_dropped(AGENTS / argv[1])
    if argv[:1] == ["list"] and len(argv) == 1: sys.exit(print_list())
    if argv[:1] == ["doctor"]: sys.exit(print_doctor())
    if argv[:1] == ["login-helper"] and len(argv) == 2: return login_helper(argv[1])
    if argv[:1] == ["check"] and len(argv) == 2 and harness_of(argv[1]) in SIGN_IN: return run_check(argv[1])
    if argv[:1] == ["models"] and len(argv) == 2 and model_source(argv[1]): return refresh_models(argv[1])
    if argv[:1] == ["restart-agents"] and len(argv) in (2, 3) and argv[1] in HARNESS and argv[2:] in ([], ["subscription"], ["key"]):
        return restart_harness_agents(argv[1], argv[2] if len(argv) == 3 else None)
    if argv[:1] == ["apply-later"] and len(argv) == 2 and HEX64.match(argv[1]) and (AGENTS / argv[1]).is_dir():
        return apply_later(AGENTS / argv[1])
    if argv[:1] == ["log-filter"] and len(argv) == 5 and argv[3].isdigit() and argv[4].isdigit():
        return sieve_log(Path(argv[1]), Path(argv[2]), int(argv[3]), int(argv[4]))
    try:
        try: req = json.loads(sys.stdin.read() or "{}")
        except ValueError: fail("request is not JSON")
        reply = handle(req)
    except Fail as e:
        reply = {"ok": False, "error": str(e)}
    except Exception as e:  # an unexpected failure is still one JSON line
        reply = {"ok": False, "error": f"agentctl failed: {type(e).__name__}: {str(e)[:300]}"}
    print(json.dumps(reply))


if __name__ == "__main__":
    main()
