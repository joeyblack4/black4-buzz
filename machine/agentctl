def set_root(home, root=None):
    """Point every path at the runner's root: <home>/workforce, or `root`
    (BLACK4_WORKFORCE_ROOT) for a second runner beside it, e.g. a dev copy.
    Tests use a temporary home."""
    global HOME, ROOT, AGENTS, BIN, RUN, VENDOR, BLACK4_MCP, CRON_MARK, PINS
    HOME = Path(home)
    ROOT = (HOME / Path(root).expanduser()) if root else HOME / "workforce"
    # Each root has its own cron lines. The default root keeps the released
    # mark; another root's mark must not contain it (released runners drop
    # every line that does).
    CRON_MARK = "# black4-workforce" if ROOT == HOME / "workforce" else f"# black4-runner:{ROOT}"
    AGENTS, BIN = ROOT / "agents", ROOT / "bin"
    RUN, VENDOR = ROOT / "run", ROOT / "vendor"
    # buzz-acp names the MCP server after this file's stem, so the agent's
    # tools appear as black4 tools (mcp__black4__<tool> in Claude Code).
    BLACK4_MCP = ROOT / "mcp" / "black4"
    # The version set this machine was installed with (machine/pins.json,
    # copied by setup.sh). doctor and machine.status check the install against it.
    PINS = ROOT / "pins.json"
    use_account(None)


# Every model sign-in belongs to one person: the account that signed it in.
# An agent runs only on its creator's (`createdBy`), and a caller signs in,
# checks and signs out only its own. Nothing falls back to anyone else's:
# an agent with no creator, or a creator with no sign-in, does not start.
ACCOUNT_NAME = re.compile(r"^[a-z0-9][a-z0-9._%+@-]{0,253}$")
NO_ACCOUNT = "-none-"  # no file name an account can have (one starts with a letter or digit)


def account_root(who):
    return ROOT / "accounts" / (who if isinstance(who, str) and ACCOUNT_NAME.fullmatch(who) else NO_ACCOUNT)


def use_account(who):
    """Point the sign-in paths at one person's: accounts/<who>/ holds their
    secrets (Claude token, API keys), homes (Codex, Grok and Qwen sign-ins in
    private CLI homes, each slot's home), logins (open sign-ins) and run
    (each sign-in's checks and model listings). None (the admin, or an agent
    made before creators were recorded) has no sign-ins at all."""
    global ACCOUNT, SECRETS, HOMES, LOGINS, CRED_RUN
    ACCOUNT = who if isinstance(who, str) and ACCOUNT_NAME.fullmatch(who) else None
    base = account_root(ACCOUNT)
    SECRETS, HOMES, LOGINS, CRED_RUN = base / "secrets", base / "homes", base / "logins", base / "run"


def use_agent_account(settings):
    use_account(settings.get("createdBy"))


