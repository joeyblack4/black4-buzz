def toml_with(text, section, key, value):
    """TOML text with `key = value` set at the top level or in [section], and
    every other line kept as it was."""
    lines = [line for line in text.splitlines() if not re.match(rf"\s*{re.escape(key)}\s*=", line)]
    setting = f"{key} = {value}"
    if section is None: return "\n".join([setting] + lines) + "\n"
    stripped = [line.strip() for line in lines]
    if f"[{section}]" in stripped: lines.insert(stripped.index(f"[{section}]") + 1, setting)
    else: lines += ([""] if lines else []) + [f"[{section}]", setting]
    return "\n".join(lines) + "\n"


def cli_home(harness, base=None):
    """A private config home for this harness. Its config.toml gets our one
    setting and keeps whatever the CLI wrote there; it is written only when that
    changes it."""
    home = private_dir(base or HOMES / harness)
    private_dir(home.parent)
    path = home / "config.toml"
    try: old = path.read_text()
    except FileNotFoundError: old = ""
    new = toml_with(old, *DEVICE[harness]["setting"])
    if new != old: write_private(path, new)
    return home


def device_cli(harness):
    return shutil.which(DEVICE[harness]["cli"], path=agent_path())


def device_env(harness, home=None):
    env = base_env()
    env[DEVICE[harness]["home_env"]] = str(home or cli_home(harness))
    env["NO_BROWSER"] = "1"         # codex-acp: no browser sign-in offer
    env["BROWSER"] = "/usr/bin/true"  # never try to open one
    return env


def device_cred(harness):
    """The stored sign-in file's fingerprint (never its content), or None."""
    try: data = (HOMES / harness / CRED_FILE).read_bytes()
    except FileNotFoundError: return None
    return hashlib.sha256(data).hexdigest()[:16] if data.strip() else None


def run_codex_check():
    """Ask Codex's own app-server (what codex-acp runs) which account its
    auth.json holds, with refreshToken false. Nothing else is asked: a request
    to OpenAI may refresh the sign-in, and Codex's refresh token is used once,
    so a check refreshing beside a running agent could sign that agent out. A
    revoked sign-in therefore shows when an agent uses it. No model is called.
    Returns (True/False/None, account)."""
    cli = device_cli("codex")
    if not cli: return None, None
    try:
        proc = subprocess.Popen([cli, "app-server"], cwd=private_dir(RUN / "check"), env=device_env("codex"),
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return None, None
    import select
    deadline = time.time() + 45

    def call(i, method, params):
        proc.stdin.write(json.dumps({"id": i, "method": method, "params": params}) + "\n"); proc.stdin.flush()
        while time.time() < deadline:
            r, _, _ = select.select([proc.stdout], [], [], 0.5)
            if not r: continue
            line = proc.stdout.readline()
            if not line: return None
            try: msg = json.loads(line)
            except ValueError: continue
            if msg.get("id") == i: return msg
        return None
    try:
        if not call(0, "initialize", {"clientInfo": {"name": "agentctl", "version": "1"}}): return None, None
        proc.stdin.write(json.dumps({"method": "initialized"}) + "\n"); proc.stdin.flush()
        read = call(1, "account/read", {"refreshToken": False})
        if not read or "result" not in read: return None, None
        account = (read["result"] or {}).get("account")
        if not account: return False, None
        if account.get("type") != "chatgpt": return False, None  # an API key is not a subscription
        return True, account.get("email") or None
    except (OSError, ValueError):
        return None, None
    finally:
        try: proc.kill(); proc.wait(5)
        except Exception: pass
        for f in (proc.stdin, proc.stdout):
            try: f.close()
            except Exception: pass


def run_grok_check():
    """`grok models` on the stored sign-in: it lists the models without calling
    one, and says "You are not authenticated." when signed out. Returns
    (True/False/None, None): Grok does not report the account."""
    cli = device_cli("grok")
    if not cli: return None, None
    try:
        done = subprocess.run([cli, "models"], cwd=private_dir(RUN / "check"), env=device_env("grok"),
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except (subprocess.TimeoutExpired, OSError):
        return None, None
    return judge_grok_check(done.returncode, done.stdout, done.stderr), None


def judge_grok_check(code, stdout, stderr):
    if re.search(r"not authenticated|not signed in|unauthori[sz]ed|\b401\b|(sign-?in|session|token) (has )?(expired|been revoked)",
                 f"{stdout}\n{stderr}", re.I):
        return False
    return True if code == 0 else None


DEVICE_CHECK = {"codex": run_codex_check, "grok": run_grok_check}


# ---------------------------------------------------------------- sign-in checks
# machine.status answers from the last check of each sign-in (run/<harness>-
# check.json). A due check runs out of band, in a detached `agentctl check
# <harness>` holding run/<harness>-check.lock, so overlapping status calls start
# at most one. No check can change the sign-in that agents use: Claude's token
# is long-lived and never refreshed, Codex is only asked what its auth.json
# holds, and `grok models` calls no model.

def credential(harness):
    """A fingerprint of the stored sign-in (never the sign-in itself), or None."""
    if harness == "claude":
        token = claude_token()
        return token_hash(token) if token else None
    return device_cred(harness)


def last_check(harness):
    """(fingerprint, the last check of that sign-in or {})."""
    cred = credential(harness)
    cache = read_json(RUN / f"{harness}-check.json", {}) or {}
    return cred, (cache if cred and cache.get("hash") == cred else {})


def run_check(harness, wait=False):
    """Checks the stored sign-in and records the answer. Returns at once if a
    check of this harness is already running, unless `wait`."""
    lock = open(private_dir(RUN) / f"{harness}-check.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError: return
        cred, old = last_check(harness)
        if not cred: return
        if harness == "claude": ok, account = run_claude_check(claude_token()), None
        else: ok, account = DEVICE_CHECK[harness]()
        if ok is None: ok = old.get("ok")  # could not tell (offline): the last answer stands
        write_private(RUN / f"{harness}-check.json",
                      json.dumps({"hash": cred, "ok": ok, "at": time.time(), "account": account or old.get("account")}))
    finally:
        lock.close()


def spawn_check(harness):
    """Starts `agentctl check <harness>` detached; it outlives this request."""
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "check", harness], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def signed_in(harness, wait=None):
    """(signedIn, account): the last check's answer, True, False or None (no
    answer yet). When a check is due one is started, and waited for up to
    `wait` seconds; past that the last answer stands."""
    cred, cache = last_check(harness)
    if not cred: return False, None
    ttl = CHECK_OK_TTL if cache.get("ok") is True else CHECK_FAIL_TTL
    if not cache or time.time() - cache.get("at", 0) >= ttl:
        spawn_check(harness)
        deadline = time.time() + (STATUS_WAIT if wait is None else wait)
        while time.time() < deadline:
            _, new = last_check(harness)
            if new.get("at") != cache.get("at"):
                cache = new
                break
            time.sleep(0.2)
    account = (read_json(SECRETS / "claude.json", {}) or {}).get("account") if harness == "claude" else cache.get("account")
    return cache.get("ok"), account


def known_bad(harness):
    """Cheap, for start and the supervisor (never runs a CLI): no sign-in, or
    the last check rejected this one. A rejection older than KNOWN_BAD_TTL is
    checked again out of band, and stands until that answers."""
    if harness not in SIGN_IN: return False
    cred, cache = last_check(harness)
    if not cred: return True
    if cache.get("ok") is not False: return False
    if time.time() - cache.get("at", 0) > KNOWN_BAD_TTL: spawn_check(harness)
    return True


def forget_device(harness):
    (HOMES / harness / CRED_FILE).unlink(missing_ok=True)
    (RUN / f"{harness}-check.json").unlink(missing_ok=True)


def machine_status():
    """What this machine can run. Each row: installed, signedIn (true, false, or
    null when this machine cannot tell), account, and signIn: how Buzz signs it
    in ("code": open a link, paste the code back; "device": open a link, approve
    the code shown, nothing to paste) or null with `note`, one sentence why not.
    The sign-in checks run side by side so the reply stays quick."""
    import threading
    rows = []
    for hid in ("claude", "codex", "grok", "goose"):
        row = {"id": hid, "label": LABEL[hid], "installed": installed(hid), "signedIn": None,
               "account": None, "signIn": SIGN_IN.get(hid)}
        if not row["signIn"]: row["note"] = NO_SIGN_IN[hid]
        rows.append(row)

    def check(row):
        try:
            if row["id"] in SIGN_IN: row["signedIn"], row["account"] = signed_in(row["id"])
        except Exception as e:  # one harness's trouble must not hide the others
            log_line("status", f"{row['id']} check failed: {type(e).__name__}")
        problem = harness_problem(row["id"])
        if problem: row["problem"] = problem
    threads = [threading.Thread(target=check, args=(row,)) for row in rows if row["installed"]]
    for t in threads: t.start()
    for t in threads: t.join(100)
    return {"ok": True, "machine": machine_name(), "harnesses": rows}


def machine_name():
    name = (read_json(ROOT / "machine.json", {}) or {}).get("name")
    return name or socket.gethostname().split(".")[0]


# ---------------------------------------------------------------- health
# Whether a harness can run here, cheap enough for machine.status and start:
# the installed versions against pins.json, and buzz-acp's own ACP initialize
# with the harness's adapter (`buzz-acp auth-methods`), remembered until either
# program changes. `doctor` adds the machine-wide checks.

ADAPTER_PACKAGE = {"claude": "@agentclientprotocol/claude-agent-acp", "codex": "@agentclientprotocol/codex-acp"}


def vendored_version(link, name):
    """The version in a vendored program's folder: vendor/<name>-<version>/..."""
    found = re.search(rf"/{name}-(\d[^/]*)/", os.path.realpath(link))
    return found.group(1) if found else None


def npm_version(*parts):
    return (read_json(VENDOR / "acp" / "node_modules" / Path(*parts) / "package.json", {}) or {}).get("version")


def version_problems(harness):
    pins = read_json(PINS)
    if not pins: return []  # doctor reports a missing pins.json once
    out = []
    def want(what, have, pinned):
        if have != pinned: out.append(f"{what} is {have or 'missing'}, pinned {pinned}")
    want("buzz-acp", vendored_version(BIN / "buzz-acp", "buzz"), pins["harness"]["release"])
    package = ADAPTER_PACKAGE.get(harness)
    if package:
        pin = pins["adapters"][package]
        want(package, npm_version(package), pin["version"])
        sdk = npm_version(package, "node_modules", "@agentclientprotocol", "sdk") or npm_version("@agentclientprotocol", "sdk")
        want("its ACP SDK", sdk, pin["sdk"])
    if harness == "codex":
        want("@openai/codex", npm_version("@openai/codex"), pins["clis"]["@openai/codex"]["version"])
        # codex-acp falls back to its sandboxed mode, silently, on a mode it does not know.
        adapter = VENDOR / "acp" / "node_modules" / ADAPTER_PACKAGE["codex"] / "dist" / "index.js"
        if adapter.exists() and f'"{FULL_ACCESS["codex"]["INITIAL_AGENT_MODE"]}"' not in adapter.read_text(errors="replace"):
            out.append(f"{ADAPTER_PACKAGE['codex']} has no {FULL_ACCESS['codex']['INITIAL_AGENT_MODE']} mode")
    if harness == "grok": want("grok", vendored_version(BIN / "grok", "grok"), pins["clis"]["grok"]["version"])
    return out


def handshake(harness):
    """None when buzz-acp completes ACP initialize with this harness's adapter,
    else one line why. A success is remembered until buzz-acp or the adapter
    changes; a failure is checked again next time."""
    command, args = HARNESS[harness]
    found = shutil.which(command, path=agent_path())
    if not (BIN / "buzz-acp").exists(): return "buzz-acp is not installed"
    if not found: return f"{command} is not installed"
    stamp = "|".join(f"{os.path.realpath(p)}:{os.stat(p).st_mtime}" for p in (BIN / "buzz-acp", found))
    cache = RUN / f"{harness}-handshake.json"
    if (read_json(cache, {}) or {}).get("stamp") == stamp: return None
    env = device_env(harness) if harness in DEVICE else base_env()
    try:
        done = subprocess.run([str(BIN / "buzz-acp"), "auth-methods", "--json", "--agent-command", command, f"--agent-args={args}"],
                              env=env, cwd=private_dir(RUN), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return f"{command} did not answer buzz-acp's ACP handshake within 30 s"
    try: answer = json.loads(done.stdout)
    except ValueError: answer = None
    if done.returncode != 0 or not isinstance(answer, dict) or "methods" not in answer:
        last = (done.stderr.strip().splitlines() or ["no answer"])[-1][:200]
        return f"{command} failed buzz-acp's ACP handshake: {last}"
    write_private(cache, json.dumps({"stamp": stamp}))
    return None


def harness_problem(harness):
    """One line saying why this harness cannot run an agent here, or None.
    Signing in is not a problem here; machine.status reports it apart."""
    try: problems = version_problems(harness)
    except (KeyError, TypeError, AttributeError): problems = ["pins.json is not readable; run machine/deploy.sh again"]
    return "; ".join(problems) or handshake(harness)


def supervisor_pid():
    pid = (read_json(RUN / "supervisor.json", {}) or {}).get("pid")
    if not pid: return None
    try: os.kill(pid, 0)
    except OSError: return None
    return pid if "agentctl" in process_command(pid) else None


def doctor():
    """Whether this machine can run an agent now, in one reply: machine.status
    with each harness's `problem` and `ready`, plus the connector, the cron
    lines, the supervisor, free disk and each activated agent. `healthy` is
    false when the install itself is wrong (deploy.sh fails on it); a harness
    that only needs signing in leaves it true."""
    status = machine_status()
    problems = [] if read_json(PINS) else ["pins.json is missing; run machine/deploy.sh again."]
    for row in status["harnesses"]:
        if row["id"] in PINNED and not row["installed"]: problems.append(f"{row['label']} is not installed.")
        if row["id"] in PINNED and row.get("problem"): problems.append(f"{row['label']}: {row['problem']}.")
        row["ready"] = bool(row["installed"] and row["signedIn"] and not row.get("problem"))
        row["access"] = ACCESS[row["id"]]
        if row["id"] in DEFAULTS and row["installed"]:
            # What a new agent runs: from the caches, so doctor stays cheap.
            picked = choice(row["id"], {})
            row["model"], row["effort"] = picked.get("model"), picked.get("effort")
            row["modelsChecked"] = picked.get("checked", True)
            if picked.get("note"): row["modelNote"] = picked["note"]
    connector = os.access(BLACK4_MCP, os.X_OK)
    if not connector: problems.append("The Black 4 connector (mcp/black4) is missing; run machine/deploy.sh again.")
    active = [d for d in agent_dirs() if read_settings(d).get("auth")]
    lines = read_crontab()
    cron = "present" if all(line in lines for line in cron_lines()) else ("missing" if active else "not needed")
    if cron == "missing": problems.append("The cron lines that bring agents back after a reboot are missing; start any agent to restore them.")
    free = shutil.disk_usage(ROOT if ROOT.exists() else HOME).free / 1e9
    if free < DISK_MIN_GB: problems.append(f"Only {free:.1f} GB of disk is free.")
    agents = [{"pubkey": d.name, "name": read_settings(d).get("name"), "running": bool(running(d)),
               "keepsStopping": keeps_stopping(d)} for d in active]
    return {**status, "healthy": not problems, "problems": problems, "connector": connector, "cron": cron,
            "supervisor": bool(supervisor_pid()), "diskFreeGB": round(free, 1), "agents": agents}


def print_doctor():
    """`agentctl doctor`: the same checks for a person (deploy.sh runs it).
    Exits 1 when the install is not healthy. No account or key is printed."""
    r = doctor()
    for row in r["harnesses"]:
        if not row["installed"]: continue
        state = "ready" if row["ready"] else row.get("problem") or (
            "signed out" if row["signedIn"] is False else "cannot be signed in from Buzz" if not row["signIn"] else "sign-in unknown")
        model = (f"; new agents run {row['model'] or 'its own default'}" + (f" at {row['effort']} effort" if row.get("effort") else "")
                 + ("" if row.get("modelsChecked", True) else " (not checked yet)")) if "model" in row else ""
        print(f"  {row['label']}: {state}; {row['access']}{model}")
        if row.get("modelNote"): print(f"  {row['label']}: {row['modelNote']}")
    print(f"  Black 4 connector: {'present' if r['connector'] else 'missing'}; cron: {r['cron']}; "
          f"supervisor: {'running' if r['supervisor'] else 'not running'}; disk free: {r['diskFreeGB']} GB")
    for a in r["agents"]:
        print(f"  agent {a['pubkey'][:8]}: {'running' if a['running'] else 'stopped'}{', keeps stopping' if a['keepsStopping'] else ''}")
    for p in r["problems"]: print(f"PROBLEM: {p}")
    print("doctor: healthy" if r["healthy"] else "doctor: NOT healthy")
    return 0 if r["healthy"] else 1


# ---------------------------------------------------------------- heartbeat
# An agent with a heartbeat wakes every N minutes and asks Black 4 what is due.
# What it does lives in Platform Control (each job's schedule), never here:
# this holds only whether it wakes and how often.

HEARTBEAT_MIN, HEARTBEAT_MAX = 5, 1440


def heartbeat_minutes(s):
    minutes = s.get("heartbeat")
    return minutes if isinstance(minutes, int) and not isinstance(minutes, bool) and HEARTBEAT_MIN <= minutes <= HEARTBEAT_MAX else 0


HEARTBEAT_PROMPT_MAX = 8000

DEFAULT_HEARTBEAT_PROMPT = """Black 4 heartbeat: run whatever standing job is due for you.

1. Call the Black 4 tool start_next_standing_run with agent "{name}" and model {model}. If your tool list does not show it, call it through the Black 4 call_tool (name and arguments). If due is false, end your turn and post nothing.
2. Otherwise do the run completely, exactly as its instructions say, for every business marked run: read its skills and goals, do the work, and publish what it asks for. Post in Buzz only where the instructions say (buzz messages send).
3. Finish with finish_standing_run (the same way): runId, agent "{name}", model {model}, and businesses: one entry per business marked run, each with businessId, outcome (done, no_action or failed), a one-line summary and its reviewIds. Use failed only when you truly cannot do the work, and say why.
4. Call start_next_standing_run again and repeat. Do not start another run after 30 minutes of work, but never close a run undone to move on.
"""


def heartbeat_prompt(s):
    custom = (s.get("heartbeatPrompt") or "").strip()
    if custom: return custom + "\n"
    name = (s.get("name") or "a Black 4 agent").replace('"', "'")
    model = (s.get("model") or "").replace('"', "'")
    return DEFAULT_HEARTBEAT_PROMPT.format(name=name, model=f'"{model}"' if model else "(your exact model id)")


def heartbeat_view(s):
    """What the agent form shows: on or off, how often, and what each heartbeat does."""
    return {"heartbeat": heartbeat_minutes(s), "prompt": heartbeat_prompt(s).strip(),
            "custom": bool((s.get("heartbeatPrompt") or "").strip()),
            "defaultPrompt": heartbeat_prompt({**s, "heartbeatPrompt": ""}).strip()}


# ---------------------------------------------------------------- model and effort
# Each agent may name a model and a reasoning effort; an empty one takes the
# harness's default here, the most capable model its subscription offers at
# high effort (what the owner's own Claude Code runs). Each harness gets them
# through its own lever, read from the pinned programs on the machine:
#   Claude Code  ANTHROPIC_MODEL and CLAUDE_CODE_EFFORT_LEVEL. Both beat any
#                settings file (an agent can write one in its own folder), and
#                take a full model id the adapter's picker does not list.
#                buzz-acp's BUZZ_ACP_MODEL does not: claude-agent-acp 0.94 cannot
#                select claude-fable-5-2, and buzz-acp then keeps the default
#                model without a word. So it is never set.
#   Codex        CODEX_CONFIG (codex-acp's JSON config for every thread it
#                starts): model and model_reasoning_effort.
#   Grok Build   `grok agent --model M --reasoning-effort E ... stdio`.
# None of them refuses an unknown model or effort before the first turn, so the
# choice is checked here against what the harness offers: the models Codex and
# Grok cache in their homes (they refresh it themselves), and for Claude a
# listing of the adapter's models plus a one-line call that proves each default
# full id answers on this sign-in (run/claude-models.json, per token). A model
# or effort chosen for an agent that is not offered is refused, at the change
# and at start; a default that is not offered falls back to the next one, and
# status says so (`modelNote`).

DEFAULTS = {  # harness -> (models to try, most capable first; effort)
    "claude": (("claude-fable-5-2", "fable", "opus"), "high"),
    "codex": (("gpt-6-astra", "gpt-6.1-sol"), "high"),
    "grok": (("grok-4.7", "grok-4.6"), "high"),
}
EFFORT_ORDER = ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra")
MODEL_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:\[\]/-]{0,79}$")
EFFORT_ID = re.compile(r"^[a-z]{1,16}$")
CLAUDE_MODELS_TTL = 24 * 3600  # the Claude listing is made again after this
CLAUDE_MODELS_FAIL_TTL = 10 * 60  # a failed one is tried again after this, doubling
CLAUDE_MODELS_FAIL_MAX = 6 * 3600  # up to this
MODELS_WAIT = 8.0  # the models op waits this long for a Claude listing under way


def effort_sorted(levels):
    rank = {e: i for i, e in enumerate(EFFORT_ORDER)}
    seen = [e for e in dict.fromkeys(levels) if isinstance(e, str) and EFFORT_ID.match(e)]
    return sorted(seen, key=lambda e: rank.get(e, len(rank)))


def codex_models():
    """Codex's own cached listing (models_cache.json in its home), listed rows
    only, in Codex's order; None when Codex has not fetched one yet."""
    cache = read_json(HOMES / "codex" / "models_cache.json")
    if not isinstance(cache, dict) or not isinstance(cache.get("models"), list): return None
    rows = sorted((m for m in cache["models"] if isinstance(m, dict) and m.get("visibility") == "list" and m.get("slug")),
                  key=lambda m: m.get("priority") or 0)
    rows = [m for m in rows if isinstance(m["slug"], str) and MODEL_ID.match(m["slug"])]
    return [{"id": m["slug"], "label": m.get("display_name") or m["slug"],
             "efforts": effort_sorted(r.get("effort") for r in m.get("supported_reasoning_levels") or [] if isinstance(r, dict))}
            for m in rows]


def grok_models():
    """Grok's own cached listing (models_cache.json in its home), visible rows."""
    cache = read_json(HOMES / "grok" / "models_cache.json")
    if not isinstance(cache, dict) or not isinstance(cache.get("models"), dict): return None
    out = []
    for key, row in cache["models"].items():
        info = (row or {}).get("info") or {}
        if info.get("hidden") or not isinstance(info.get("id") or key, str) or not MODEL_ID.match(info.get("id") or key): continue
        efforts = [e.get("value") for e in info.get("reasoning_efforts") or [] if isinstance(e, dict)] if info.get("supports_reasoning_effort") else []
        out.append({"id": info.get("id") or key, "label": info.get("name") or key, "efforts": effort_sorted(efforts)})
    return out


def claude_label(model_id):
    """claude-fable-5-2 -> Fable 5.2."""
    parts = model_id.split("-")
    if parts[:1] != ["claude"] or len(parts) < 3: return model_id
    return parts[1].capitalize() + " " + ".".join(parts[2:])


def claude_efforts(cli):
    """The effort levels the pinned Claude Code takes, from its own --help."""
    try:
        done = subprocess.run([cli, "--help"], env=base_env(), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (subprocess.TimeoutExpired, OSError):
        return []
    found = re.search(r"--effort <level>[^(]*\(([a-z, ]+)\)", done.stdout)
    return effort_sorted(found.group(1).replace(" ", "").split(",")) if found else []


def claude_answers(cli, token, model):
    """True when a one-line call on this sign-in is answered by `model` itself
    (Claude Code reports the model that answered in modelUsage); False when the
    API says the model is not there for it (404, as 2.1.303 reports it); None
    for anything else (a usage limit, overload, offline), which proves nothing."""
    env = base_env()
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    try:
        done = subprocess.run([cli, "-p", "Reply with the single word OK.", "--model", model, "--max-turns", "1", "--output-format", "json"],
                              cwd=private_dir(RUN / "check"), env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=45)
        result = json.loads(done.stdout.strip().splitlines()[-1])
    except (subprocess.TimeoutExpired, OSError, ValueError, IndexError):
        return None
    return judge_model_answer(result, model)


def judge_model_answer(result, model):
    if not result.get("is_error"): return model in (result.get("modelUsage") or {})
    if result.get("api_error_status") == 404 or re.search(r"issue with the selected model|may not exist or you may not have access",
                                                         str(result.get("result") or ""), re.I):
        return False
    return None


def list_claude_models():
    """The models Claude Code offers on the stored sign-in: the adapter's own
    listing (`buzz-acp models`, aliases such as fable and opus), then each
    default full id that the listing lacks and that answers a one-line call.
    None when it cannot tell (signed out, offline)."""
    token, cli = claude_token(), claude_cli()
    if not token or not cli or not (BIN / "buzz-acp").exists(): return None
    env = base_env()
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    try:
        done = subprocess.run([str(BIN / "buzz-acp"), "models", "--json", "--agent-command", HARNESS["claude"][0], "--agent-args="],
                              cwd=private_dir(RUN / "check"), env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30)
        listing = json.loads(done.stdout)
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return None
    options = []
    for option in ((listing.get("stable") or {}).get("configOptions") or []):
        if isinstance(option, dict) and option.get("category") == "model":
            options = [o for o in option.get("options") or [] if isinstance(o, dict) and o.get("value") not in (None, "default")]
    efforts = claude_efforts(cli)
    rows = [{"id": o["value"], "label": o.get("name") or o["value"], "efforts": efforts}
            for o in options if isinstance(o["value"], str) and MODEL_ID.match(o["value"])]
    listed = {r["id"] for r in rows}
    extra = []
    for model in DEFAULTS["claude"][0]:
        if model in listed or not model.startswith("claude-"): continue
        answered = claude_answers(cli, token, model)
        if answered is None: return None
        if answered: extra.append({"id": model, "label": claude_label(model), "efforts": efforts})
    return extra + rows


def refresh_claude_models(wait=False):
    """Makes the Claude listing again for the stored sign-in, at most one at a
    time (run/claude-models.lock); returns at once if one is running, unless
    `wait`. A listing that fails (a usage limit, offline) keeps the last good
    one, and is tried again after 10 minutes, then 20, 40 ... up to 6 hours,
    so the paid one-line call is not repeated while it cannot succeed."""
    lock = open(private_dir(RUN) / "claude-models.lock", "a")
    try:
        try: fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError: return
        token = claude_token()
        if not token: return
        cache = read_json(RUN / "claude-models.json", {}) or {}
        if cache.get("hash") != token_hash(token): cache = {}  # another sign-in: nothing of the last one holds
        elif not claude_models_stale(cache): return
        models = list_claude_models()
        now = time.time()
        if models is not None:
            cache = {"hash": token_hash(token), "at": now, "models": models}
        else:
            fails = (cache.get("fails") or 0) + 1
            cache = {**cache, "hash": token_hash(token), "fails": fails, "failedAt": now,
                     "retryAt": now + min(CLAUDE_MODELS_FAIL_TTL * 2 ** (fails - 1), CLAUDE_MODELS_FAIL_MAX)}
        write_private(RUN / "claude-models.json", json.dumps(cache))
    finally:
        lock.close()


def claude_models_stale(cache):
    if cache.get("retryAt"): return time.time() >= cache["retryAt"]
    return not cache.get("models") or time.time() - (cache.get("at") or 0) >= CLAUDE_MODELS_TTL


def claude_models(spawn=True):
    """The last good Claude listing for the stored sign-in, or None (none yet,
    or another sign-in). A stale one is still used, and made again out of band."""
    token = claude_token()
    if not token: return None
    cache = read_json(RUN / "claude-models.json", {}) or {}
    if cache.get("hash") != token_hash(token):
        if spawn: spawn_models_refresh()
        return None
    if spawn and claude_models_stale(cache): spawn_models_refresh()
    return cache.get("models")


def claude_listing_due():
    """True when this sign-in has no Claude listing and none is waiting out a
    failure: making one now is worth a few seconds of a start."""
    token = claude_token()
    cache = read_json(RUN / "claude-models.json", {}) or {}
    return bool(token) and (cache.get("hash") != token_hash(token) or (not cache.get("models") and claude_models_stale(cache)))


def spawn_models_refresh():
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    try:
        subprocess.Popen([PYTHON, str(SELF), "models", "claude"], env=env, cwd=str(private_dir(RUN)),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def offered(harness):
    """[{id, label, efforts}] this harness offers here, or None when this
    machine cannot tell yet. Cheap: reads caches only."""
    if harness == "claude": return claude_models()
    if harness == "codex": return codex_models()
    if harness == "grok": return grok_models()
    return None


def find_model(models, model):
    return next((m for m in models if m["id"] == model), None)


def choice(harness, settings, models=False):
    """The model and effort an agent runs with: {model, effort, note, problem}.
    `problem` (one sentence) when its own choice is not offered here; `note`
    when a default is not offered and another one stands in. model and effort
    are None for a harness that takes neither (Goose). `models` is offered(harness)
    when the caller has it already."""
    if harness not in DEFAULTS: return {"model": None, "effort": None}
    tries, default_effort = DEFAULTS[harness]
    model = (settings.get("model") or "").strip()
    effort = (settings.get("effort") or "").strip()
    models = offered(harness) if models is False else models
    if models is None:  # cannot check yet: what was asked for, or the first default
        return {"model": model or tries[0], "effort": effort or default_effort, "checked": False}
    label = LABEL[harness]
    out = {"model": model, "effort": effort, "checked": True}
    if model:
        entry = find_model(models, model)
        if not entry:
            return {**out, "problem": f"{label} does not offer the model {model} on this machine. Choose another model for this agent."}
    else:
        entry = next((find_model(models, m) for m in tries if find_model(models, m)), None) or (models[0] if models else None)
        if not entry: return {**out, "model": None, "effort": None, "note": f"{label} listed no models; it runs its own default."}
        out["model"] = entry["id"]
        if entry["id"] != tries[0]: out["note"] = f"{tries[0]} is not offered here; {entry['id']} runs instead."
    if effort:
        if effort not in entry["efforts"]:
            return {**out, "problem": f"{entry['label']} does not take the effort {effort}. Choose another effort for this agent."}
    elif default_effort in entry["efforts"]:
        out["effort"] = default_effort
    else:  # the highest one below the default, else none
        rank = EFFORT_ORDER.index(default_effort) if default_effort in EFFORT_ORDER else -1
        below = [e for e in entry["efforts"] if e in EFFORT_ORDER and EFFORT_ORDER.index(e) < rank]
        out["effort"] = below[-1] if below else None
        out["note"] = ((out.get("note") or "") + f" {entry['label']} does not take {default_effort} effort; "
                       + (f"{out['effort']} instead." if out["effort"] else "it runs its own default.")).strip()
    return out


def launch(harness, picked):
    """(env, agent args) that make this harness run the picked model and effort."""
    model, effort = picked.get("model"), picked.get("effort")
    # From a saved setting or a harness's own listing: checked again here,
    # since Grok's go into comma-separated arguments.
    if model and not MODEL_ID.match(model): fail(f"{LABEL[harness]}: {model[:80]!r} is not a model id.")
    if effort and not EFFORT_ID.match(effort): fail(f"{LABEL[harness]}: {effort[:20]!r} is not an effort level.")
    command, args = HARNESS[harness]
    env = {}
    if harness == "claude":
        if model: env["ANTHROPIC_MODEL"] = model
        if effort: env["CLAUDE_CODE_EFFORT_LEVEL"] = effort
    elif harness == "codex":
        config = {**({"model": model} if model else {}), **({"model_reasoning_effort": effort} if effort else {})}
        if config: env["CODEX_CONFIG"] = json.dumps(config)
    elif harness == "grok":
        extra = (["--model", model] if model else []) + (["--reasoning-effort", effort] if effort else [])
        parts = args.split(",")
        args = ",".join(parts[:1] + extra + parts[1:])  # grok agent <options> stdio
    return env, args


def models_reply():
    """The `models` op: per installed harness that takes a model, what it
    offers ({id, label, efforts}), the default model and effort here, and
    whether the machine could tell (`checked`). Quick: a Claude listing that
    is missing is made out of band, and waited for only MODELS_WAIT seconds;
    the plugin asks again soon while a harness is unchecked."""
    rows = []
    for hid in DEFAULTS:
        if not installed(hid): continue
        models = offered(hid)
        if hid == "claude" and models is None and claude_token():
            deadline = time.time() + MODELS_WAIT
            while models is None and time.time() < deadline:
                time.sleep(0.25)
                models = claude_models(spawn=False)
        picked = choice(hid, {}, models)
        rows.append({"id": hid, "label": LABEL[hid], "models": models or [], "checked": models is not None,
                     "model": picked.get("model"), "effort": picked.get("effort"),
                     **({"note": picked["note"]} if picked.get("note") else {})})
    return {"ok": True, "harnesses": rows}


def checked_choice(harness, model, effort):
    """Refuses a model or effort this harness does not offer here (when the
    machine can tell); returns the cleaned pair, "" meaning the default."""
    model = model.strip() if isinstance(model, str) else ""
    effort = effort.strip().lower() if isinstance(effort, str) else ""
    if model and not MODEL_ID.match(model): fail("model is not a model id")
    if effort and not EFFORT_ID.match(effort): fail("effort is not an effort level")
    if (model or effort) and harness not in DEFAULTS:
        fail(f"{LABEL.get(harness, harness)} takes its model from the machine; it has no model or effort to choose.")
    picked = choice(harness, {"model": model, "effort": effort})
    if picked.get("problem"): fail(picked["problem"])
    return model, effort


# ---------------------------------------------------------------- start

def start(d):
    with agent_lock(d):
        return _start(d)


def _start(d):
    s = read_settings(d)
    if not s.get("auth"): fail("agent has no owner attestation yet")
    harness = s.get("harness") or "claude"
    if harness not in HARNESS: fail(f"unknown harness {harness!r}")
    if not installed(harness):
        fail(f"{LABEL[harness]} is not installed on this machine.")
    problem = harness_problem(harness)
    if problem: fail(f"{LABEL[harness]} cannot run on this machine: {problem}.")
    env = base_env()
    if harness == "claude":
        token = claude_token()
        if not token or known_bad("claude"):
            fail("Claude Code is not signed in on this machine. Sign in to Claude from Buzz first.")
        env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    elif harness in DEVICE:
        if known_bad(harness):
            fail(f"{LABEL[harness]} is not signed in on this machine. Sign in to {LABEL[harness]} from Buzz first.")
        env = device_env(harness)
    # Right after a deploy or a new sign-in there is no Claude listing yet:
    # make it now (a few seconds, once per sign-in) rather than start a model
    # that may not be offered. One waiting out a failure is not retried here.
    if harness == "claude" and claude_listing_due(): refresh_claude_models(wait=True)
    picked = choice(harness, s)
    if picked.get("problem"): fail(picked["problem"])
    model_env, args = launch(harness, picked)
    stop(d)
    (d / "launch.json").unlink(missing_ok=True)
    command = HARNESS[harness][0]
    env.update({
        "BUZZ_PRIVATE_KEY": (d / "key").read_text().strip(),
        # The harness speaks WebSocket to the relay; the CLI below uses HTTPS.
        "BUZZ_RELAY_URL": "wss://" + s["community"].split("://", 1)[1],
        "BUZZ_AUTH_TAG": json.dumps(s["auth"]),
        "BUZZ_ACP_AGENT_COMMAND": command,
        "BUZZ_ACP_RESPOND_TO": s.get("respondTo") or "owner-only",
        "BUZZ_ACP_LAZY_POOL": "true",
    })
    minutes = heartbeat_minutes(s)
    if minutes:
        # A heartbeat agent wakes on its own and asks Black 4 what is due
        # (docs/roadmap/job-schedules.md in the platform repository). buzz-acp
        # skips a heartbeat while its model process sleeps, so a heartbeat
        # agent keeps it on, and runs two turns so a person can still talk
        # to it while a scheduled run is going.
        # The model it runs, when that is an exact id (an alias such as
        # opus is left for the agent to name exactly).
        exact = picked.get("model") if "-" in (picked.get("model") or "") else ""
        (d / "heartbeat.md").write_text(heartbeat_prompt({**s, "model": exact}))
        env.update({
            "BUZZ_ACP_LAZY_POOL": "false",
            "BUZZ_ACP_HEARTBEAT_INTERVAL": str(minutes * 60),
            "BUZZ_ACP_HEARTBEAT_PROMPT_FILE": str(d / "heartbeat.md"),
            "BUZZ_ACP_AGENTS": "2",
        })
    if args: env["BUZZ_ACP_AGENT_ARGS"] = args
    env.update(FULL_ACCESS[harness])
    # buzz-acp declares one MCP server per session and hands it the agent's key
    # (nsec) and BUZZ_AUTH_TAG. Buzz's own tools are the agent's shell and the
    # buzz CLI, so the slot is free for Black 4. Missing connector: no MCP.
    if os.access(BLACK4_MCP, os.X_OK): env["BUZZ_ACP_MCP_COMMAND"] = str(BLACK4_MCP)
    if s.get("allow"): env["BUZZ_ACP_RESPOND_TO_ALLOWLIST"] = ",".join(s["allow"])
    if (s.get("instructions") or "").strip():
        (d / "instructions.md").write_text(s["instructions"])
        env["BUZZ_ACP_SYSTEM_PROMPT_FILE"] = str(d / "instructions.md")
    # Never BUZZ_ACP_MODEL: see "model and effort" above.
    env.update(model_env)
    write_private(d / "launch.json", json.dumps({k: picked.get(k) for k in ("model", "effort", "note", "checked")}))
    (d / "work").mkdir(exist_ok=True)
    cap_log(d / "agent.log", AGENT_LOG_CAP)
    log = open(d / "agent.log", "ab")
    proc = subprocess.Popen(
        [str(BIN / "buzz-acp"), "--agent-owner", s["auth"][1]],
        cwd=d / "work", env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
        start_new_session=True)
    log.close()
    (d / "pid").write_text(str(proc.pid))
    time.sleep(START_GRACE)
    if proc.poll() is not None:
        fail("agent stopped at start: " + log_tail(d, 600))
    ensure_persistence()
    return proc.pid


def restart_harness_agents(harness):
    """Restart running or activated agents on this harness (after a sign-in)."""
    for d in agent_dirs():
        s = read_settings(d)
        if s.get("auth") and (s.get("harness") or "claude") == harness:
            try: start(d)
            except Exception as e: log_line("supervisor", f"restart {d.name[:8]} failed: {str(e)[:200]}")


def stop_harness_agents(harness):
    for d in agent_dirs():
        if (read_settings(d).get("harness") or "claude") == harness:
            with agent_lock(d): stop(d)


# ---------------------------------------------------------------- persistence
# Nobody is logged in at the machine's screen, so there is no GUI launchd session
# to hold a LaunchAgent across a reboot. cron runs without one: an @reboot line
# and an every-minute line both run `agentctl supervise`, which takes a lock and
# then loops, restarting any activated agent that is not running.

def root_env():
    """The environment a second runner's own processes need to find their root."""
    return {} if ROOT == HOME / "workforce" else {"BLACK4_WORKFORCE_ROOT": str(ROOT)}


def cron_lines():
    prefix = "".join(f"{k}={v} " for k, v in root_env().items())
    cmd = f"{prefix}{PYTHON} {BIN / 'agentctl'} supervise >/dev/null 2>&1"
    return [f"@reboot {cmd} {CRON_MARK}", f"* * * * * {cmd} {CRON_MARK}"]


def read_crontab():
    done = subprocess.run(["/usr/bin/crontab", "-l"], capture_output=True, text=True)
    return done.stdout if done.returncode == 0 else ""


def write_crontab(text):
    if text.strip():
        subprocess.run(["/usr/bin/crontab", "-"], input=text, text=True, check=True, capture_output=True)
    else:
        subprocess.run(["/usr/bin/crontab", "-r"], capture_output=True)


def merged_crontab(current, install):
    keep = [line for line in current.splitlines() if not line.rstrip().endswith(CRON_MARK)]
    if install: keep += cron_lines()
    return "\n".join(keep) + ("\n" if keep else "")


def ensure_persistence():
    if os.environ.get("AGENTCTL_NO_CRON"): return
    current = read_crontab()
    wanted = merged_crontab(current, True)
    if current != wanted: write_crontab(wanted)


def drop_persistence():
    """Remove the cron lines and the supervisor once no activated agent is left."""
    if any(read_settings(d).get("auth") for d in agent_dirs()): return
    if not os.environ.get("AGENTCTL_NO_CRON"):
        current = read_crontab()
        wanted = merged_crontab(current, False)
        if current != wanted: write_crontab(wanted)
    pid = read_json(RUN / "supervisor.json", {}).get("pid")
    if pid and pid != os.getpid():
        try: os.kill(pid, signal.SIGTERM)
        except OSError: pass


def supervise(passes=None):
    """Keep activated agents running. Only one supervisor runs at a time; a second
    one exits at once. Exits when agentctl itself is replaced, so cron picks up
    the new version within a minute."""
    private_dir(RUN)
    lock = open(RUN / "supervisor.lock", "a")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError: return
    write_private(RUN / "supervisor.json", json.dumps({"pid": os.getpid(), "since": int(time.time())}))
    log_line("supervisor", f"supervisor {os.getpid()} up")
    born = SELF.stat().st_mtime if SELF.exists() else 0
    n = 0
    while passes is None or n < passes:
        n += 1
        supervise_pass()
        cleanup_logins()
        if not any(read_settings(d).get("auth") for d in agent_dirs()):
            drop_persistence(); break
        if SELF.exists() and SELF.stat().st_mtime != born:
            log_line("supervisor", "agentctl changed; exiting for cron to restart"); break
        if passes is None or n < passes: time.sleep(SUPERVISE_EVERY)


def restarts(d):
    """The supervisor's restarts of this agent in a row (agents/<pubkey>/restarts.json):
    count, delay, at (last restart), next (earliest next try). It lives on disk,
    so a crash loop keeps backing off across supervisors and reboots."""
    return read_json(d / "restarts.json", {}) or {}


def keeps_stopping(d):
    return restarts(d).get("count", 0) >= KEEPS_STOPPING


def recheck_launch(d, s):
    """An agent started before its harness's listing was known (launch.json
    checked false) is checked once the listing is in: one that runs what it
    should now is marked checked; one that should run another model or effort
    is restarted on it; one whose own choice is not offered is stopped, so it
    does not fail every turn unseen (status says why, and start refuses it
    until the choice is changed)."""
    launched = read_json(d / "launch.json")
    if not isinstance(launched, dict) or launched.get("checked", True): return
    harness = s.get("harness") or "claude"
    models = offered(harness)
    if models is None: return
    picked = choice(harness, s, models)
    if not picked.get("problem") and (picked.get("model"), picked.get("effort")) == (launched.get("model"), launched.get("effort")):
        write_private(d / "launch.json", json.dumps({**launched, "checked": True}))
        return
    if picked.get("problem"):
        with agent_lock(d): stop(d)
        log_line("supervisor", f"stopped {d.name[:8]}: {picked['problem']}")
        return
    try: log_line("supervisor", f"restarted {d.name[:8]} on {picked.get('model')} pid {start(d)}")
    except Exception as e: log_line("supervisor", f"restart {d.name[:8]} failed: {str(e)[:200]}")


def supervise_pass(now=None):
    """One look at every agent: restart an activated agent that is not running,
    waiting 5, 10, 20 ... 300 s between restarts while it keeps stopping. One
    that has stayed up 5 minutes since its last restart starts over at 5 s."""
    reap()
    now = now or time.time()
    for d in agent_dirs():
        cap_log(d / "agent.log", AGENT_LOG_CAP)
        s = read_settings(d)
        if not s.get("auth"): continue
        r = restarts(d)
        if running(d):
            if r and now - r.get("at", now) > HEALTHY_AFTER: (d / "restarts.json").unlink(missing_ok=True)
            recheck_launch(d, s)
            continue
        if now < r.get("next", 0): continue
        if known_bad(s.get("harness") or "claude"): continue  # waits for a sign-in
        delay = min(max(r.get("delay", 0) * 2, 5), RESTART_MAX_DELAY)
        try:
            log_line("supervisor", f"started {d.name[:8]} pid {start(d)}")
        except Exception as e:  # Fail, or anything unexpected: back off all the same
            log_line("supervisor", f"start {d.name[:8]} failed: {str(e)[:200]}")
        if d.exists():
            write_private(d / "restarts.json", json.dumps({"count": r.get("count", 0) + 1, "delay": delay, "at": now, "next": now + delay}))


# ---------------------------------------------------------------- sign-in
# `claude setup-token` prints a link, waits for the code the person pastes back,
# then prints a long-lived OAuth token. It needs a terminal, and the sign-in
# spans two SSH calls, so a detached helper runs it in a pty and keeps state in
# logins/<id>/ (mode 700): state.json (url or error), code (written by
# login.finish), result.json (written by the helper). The token never touches
# that folder: the helper writes it straight to secrets/claude.

URL_RE = re.compile(r"https://[^\s\"'<>]+/oauth/authorize\?[^\s\"'<>]+")
TOKEN_RE = re.compile(r"sk-ant-[a-z0-9]+-[A-Za-z0-9_\-]{20,}")
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")
CODE_RE = re.compile(r"^[A-Za-z0-9_\-#.~=+/]{8,1024}$")


def screen_text(raw):
    """Terminal output as plain text: cursor-forward becomes spaces, other escapes go."""
    raw = re.sub(rb"\x1b\[(\d*)C", lambda m: b" " * int(m.group(1) or 1), raw)
    raw = re.sub(rb"\x1b\[[0-9;?>=]*[A-Za-z]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b[()][A-Z0-9]|\x1b[=>78]", b"", raw)
    return raw.decode(errors="replace").replace("\r", "\n")


def login_dir(login_id):
    if not isinstance(login_id, str) or not LOGIN_ID.match(login_id):
        fail("loginId is not valid")
    return LOGINS / login_id


def kill_login(d):
    info = read_json(d / "helper.json", {})
    for pid in (info.get("child"), info.get("pid")):
        if not pid: continue
        try: os.killpg(pid, signal.SIGKILL)
        except OSError:
            try: os.kill(pid, signal.SIGKILL)
            except OSError: pass
    shutil.rmtree(d, ignore_errors=True)


def cleanup_logins(now=None):
    if not LOGINS.exists(): return
    now = now or time.time()
    for d in LOGINS.iterdir():
        if not d.is_dir(): continue
        info = read_json(d / "helper.json", {})
        started = info.get("startedAt") or d.stat().st_mtime
        alive = False
        if info.get("pid"):
            try: os.kill(info["pid"], 0); alive = True
            except OSError: pass
        if now - started > LOGIN_TTL or (not alive and now - started > 120):
            kill_login(d)


def login_start(harness, flows=None):
    """Opens one sign-in. Claude: a link whose page shows a code to paste back
    (needsCode true). Codex and Grok: a link and a short userCode the person
    approves there (needsCode false); the plugin then calls login.finish with
    no code, which waits for that approval. A plugin says it can show a device
    sign-in by sending flows: ["device"]; an older one cannot show the code,
    so it gets a sentence instead of a sign-in it could not finish."""
    if harness not in SIGN_IN:
        if harness in NO_SIGN_IN: fail(NO_SIGN_IN[harness])
        fail("Buzz cannot sign in that harness on this machine.")
    label = LABEL[harness]
    if harness == "claude" and not claude_cli():
        fail("Claude Code is not installed on this machine.")
    if harness in DEVICE:
        if not device_cli(harness): fail(f"{label} is not installed on this machine.")
        if "device" not in (flows if isinstance(flows, list) else []):
            fail(f"Update the Black 4 plugin in Buzz to sign in to {label} from it.")
    cleanup_logins()
    if LOGINS.exists():  # one sign-in at a time: a new one replaces the old
        for old in LOGINS.iterdir():
            if old.is_dir(): kill_login(old)
    login_id = secrets.token_hex(8)
    d = private_dir(private_dir(LOGINS) / login_id)
    write_private(d / "helper.json", json.dumps({"startedAt": time.time(), "harness": harness, "ttl": LOGIN_TTL}))
    env = {**base_env(), **root_env()}
    if os.environ.get("AGENTCTL_NO_CRON"): env["AGENTCTL_NO_CRON"] = "1"
    subprocess.Popen([PYTHON, str(SELF), "login-helper", login_id], env=env, cwd=str(d),
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    deadline = time.time() + 40
    while time.time() < deadline:
        state = read_json(d / "state.json")
        if state and state.get("url"):
            if harness == "claude":
                return {"ok": True, "loginId": login_id, "url": state["url"], "needsCode": True}
            return {"ok": True, "loginId": login_id, "url": state["url"], "needsCode": False,
                    "userCode": state.get("userCode"), "expiresAt": int(state.get("expiresAt") or 0) or None}
        if state and state.get("error"):
            kill_login(d); fail(state["error"])
        time.sleep(0.2)
    kill_login(d)
    fail(f"{label} did not give a sign-in link in time. Try again.")


def login_finish(login_id, code):
    d = login_dir(login_id)
    if not d.exists():
        fail("This sign-in has expired or was cancelled. Start the sign-in again.")
    harness = read_json(d / "helper.json", {}).get("harness") or "claude"
    if harness in DEVICE: return device_finish(d, harness)
    code = (code or "").strip() if isinstance(code, str) else ""
    if not CODE_RE.match(code):
        fail("That does not look like a sign-in code. Copy the whole code from the Anthropic page and paste it again.")
    if (d / "result.json").exists() or (d / "code").exists():
        fail("This sign-in is already finishing.")
    write_private(d / "code", code)
    deadline = time.time() + 90
    while time.time() < deadline:
        result = read_json(d / "result.json")
        if result is not None:
            return finished(d, result)
        if not d.exists():
            fail("This sign-in has expired or was cancelled. Start the sign-in again.")
        time.sleep(0.2)
    kill_login(d)
    fail("Claude Code did not answer after the code was entered. Start the sign-in again.")


def finished(d, result):
    """The reply for a sign-in whose helper has written its result. On success
    the helper goes on to restart the agents on that harness, so this replies
    without waiting for them; only the folder goes."""
    if not result.get("ok"):
        kill_login(d)
        fail(result.get("error") or "The sign-in did not finish.")
    shutil.rmtree(d, ignore_errors=True)
    return {"ok": True, "signedIn": True, "account": result.get("account")}


def helper_alive(info):
    try: os.kill(info["pid"], 0)
    except (KeyError, TypeError, OSError): return False
    return True


def device_finish(d, harness):
    """Waits up to FINISH_WAIT seconds for the person to approve the code. Not
    yet: {"ok": true, "signedIn": false, "pending": true}, and the sign-in stays
    open for the next call. A helper that has stopped, or a sign-in past its
    lifetime, is an error, never pending again."""
    deadline = time.time() + FINISH_WAIT
    while True:
        result = read_json(d / "result.json")
        if result is not None: return finished(d, result)
        if not d.exists():
            fail("This sign-in has expired or was cancelled. Start the sign-in again.")
        info = read_json(d / "helper.json", {}) or {}
        if time.time() - (info.get("startedAt") or 0) > (info.get("ttl") or LOGIN_TTL) + 30:
            kill_login(d)
            fail("This sign-in code expired. Start the sign-in again.")
        if not helper_alive(info) and read_json(d / "result.json") is None:
            kill_login(d)
            fail(f"The {LABEL[harness]} sign-in stopped on this machine. Start the sign-in again.")
        if time.time() >= deadline: return {"ok": True, "signedIn": False, "pending": True}
        time.sleep(0.3)


def run_in_pty(argv, env, cwd):
    """Starts argv on a wide pty; returns (pid, fd)."""
    import pty, struct, termios
    pid, fd = pty.fork()
    if pid == 0:
        os.chdir(str(cwd))
        os.execve(argv[0], argv, env)
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 1000, 0, 0))
    return pid, fd


def device_helper(login_id, d, info):
    """Runs detached. Drives `<cli> login --device-auth` in a pty, in a fresh
    home inside the login folder, so a sign-in that is abandoned or refused
    never touches the one agents use. Once the CLI exits signed in, its
    auth.json is moved into homes/<harness> and checked for real."""
    import select
    harness = info["harness"]
    label = LABEL[harness]
    started = info.get("startedAt") or time.time()
    ttl = info.get("ttl") or LOGIN_TTL
    home = cli_home(harness, d / "home")
    pid, fd = run_in_pty([device_cli(harness), *DEVICE[harness]["login"]], device_env(harness, home), d)
    info.update({"pid": os.getpid(), "child": pid})
    write_private(d / "helper.json", json.dumps(info))
    raw = b""  # a device sign-in prints no secret, but keep it in memory only

    def pump(seconds):
        nonlocal raw
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: chunk = os.read(fd, 65536)
                except OSError: return False
                if not chunk: return False
                raw += chunk
        return True

    def exit_code():
        try:
            done, status = os.waitpid(pid, os.WNOHANG)
            return os.waitstatus_to_exitcode(status) if done else None
        except ChildProcessError:
            return -1

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass

    try:
        url = code = None
        while not (url and code):
            alive = pump(0.5)
            text = screen_text(raw)
            url = url or (DEVICE_URL_RE.search(text) or [None])[0]
            code = code or (USER_CODE_RE.search(text) or [None])[0]
            if url and code: break
            if not alive or exit_code() is not None or time.time() - started > 45:
                write_private(d / "state.json", json.dumps({"error": f"{label} did not give a sign-in code. Try again."}))
                return finish({"ok": False, "error": "no code"})
        write_private(d / "state.json", json.dumps({"url": url, "userCode": code, "expiresAt": started + ttl}))
        while True:
            alive = pump(0.5)
            status = exit_code()
            if status is None and alive:
                if not d.exists(): return finish({"ok": False, "error": "cancelled"})
                if time.time() - started > ttl:
                    return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
                continue
            if status is None:  # pty closed: give the CLI a moment to exit
                for _ in range(20):
                    status = exit_code()
                    if status is not None: break
                    time.sleep(0.25)
            text = screen_text(raw)
            new = home / CRED_FILE
            if status == 0 and new.exists() and new.read_bytes().strip():
                write_private(private_dir(cli_home(harness)) / CRED_FILE, new.read_text())
                new.unlink(missing_ok=True)
                run_check(harness, wait=True)
                _, check = last_check(harness)
                if check.get("ok") is False:
                    return finish({"ok": False, "error": f"{label} signed in, but {DEVICE[harness]['service']} refused the sign-in. Check the subscription and start the sign-in again."})
                finish({"ok": True, "account": check.get("account")})
                return restart_harness_agents(harness)  # after the reply is free to go
            if re.search(r"expired|timed? ?out", text, re.I):
                return finish({"ok": False, "error": "This sign-in code expired. Start the sign-in again."})
            if re.search(r"denied|declined|rejected|cancel", text, re.I):
                return finish({"ok": False, "error": "The sign-in was not approved. Start the sign-in again."})
            return finish({"ok": False, "error": f"{label} did not finish the sign-in. Start the sign-in again."})
    finally:
        raw = b""
        try: os.close(fd)
        except OSError: pass
        shutil.rmtree(d / "home", ignore_errors=True)


def login_helper(login_id):
    """Runs detached, for one sign-in. Whatever goes wrong, login.start and
    login.finish get an answer: an unexpected failure is written as the result."""
    d = LOGINS / login_id
    if not LOGIN_ID.match(login_id) or not d.is_dir(): return
    info = read_json(d / "helper.json", {})
    try:
        if info.get("harness") in DEVICE: return device_helper(login_id, d, info)
        return claude_helper(login_id, d, info)
    except Exception as e:
        log_line("login", f"sign-in helper failed: {type(e).__name__}")
        if not d.exists() or (d / "result.json").exists(): return
        error = "The sign-in failed on this machine. Start the sign-in again."
        if not (read_json(d / "state.json") or {}).get("url"): write_private(d / "state.json", json.dumps({"error": error}))
        write_private(d / "result.json", json.dumps({"ok": False, "error": error}))


def claude_helper(login_id, d, info):
    """Drives `claude setup-token` in a pty."""
    import pty, select, struct, termios
    started = info.get("startedAt") or time.time()
    env = base_env()
    env.update({"TERM": "xterm-256color", "BROWSER": "/usr/bin/true", "COLUMNS": "1000", "LINES": "50"})
    cli = claude_cli()
    pid, fd = pty.fork()
    if pid == 0:
        os.chdir(str(d))
        os.execve(cli, [cli, "setup-token"], env)
    info.update({"pid": os.getpid(), "child": pid})
    write_private(d / "helper.json", json.dumps(info))
    # Wide enough that the link and the token never wrap.
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 1000, 0, 0))
    raw = b""  # held in memory only: after the code it contains the token

    def pump(seconds):
        nonlocal raw
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([fd], [], [], 0.2)
            if r:
                try: chunk = os.read(fd, 65536)
                except OSError: return False
                if not chunk: return False
                raw += chunk
                return True
        return True

    def finish(result):
        if d.exists(): write_private(d / "result.json", json.dumps(result))
        try: os.kill(pid, signal.SIGKILL)
        except OSError: pass

    try:
        url = None
        while url is None:
            if time.time() - started > 45 or not pump(0.5):
                write_private(d / "state.json", json.dumps({"error": "Claude Code did not give a sign-in link. Try again."}))
                return finish({"ok": False, "error": "no link"})
            m = URL_RE.search(screen_text(raw))
            if m: url = m.group(0)
        write_private(d / "state.json", json.dumps({"url": url}))
        while not (d / "code").exists():
            if not d.exists() or time.time() - started > LOGIN_TTL:
                return finish({"ok": False, "error": "This sign-in expired. Start the sign-in again."})
            pump(0.5)  # keep the pty drained
        code = (d / "code").read_text().strip()
        (d / "code").unlink(missing_ok=True)
        raw = b""
        os.write(fd, code.encode())
        time.sleep(0.3)
        os.write(fd, b"\r")
        deadline = time.time() + 75
        alive = True
        while time.time() < deadline:
            alive = pump(0.5) and alive
            text = screen_text(raw)
            token = TOKEN_RE.search(text)
            if token:
                emails = EMAIL_RE.findall(text[token.end():] + text[:token.start()])
                account = emails[0] if emails else None
                save_claude_token(token.group(0), account)
                raw = b""
                finish({"ok": True, "account": account})
                refresh_claude_models(wait=True)  # what this sign-in offers, before its agents start
                return restart_harness_agents("claude")  # after the reply is free to go
            err = re.search(r"OAuth error[^\n]*", text)
            if err:
                return finish({"ok": False, "error": "That code was not accepted. Start the sign-in again to get a new link."})
            if not alive:
                break
        finish({"ok": False, "error": "Claude Code did not finish the sign-in. Start the sign-in again."})
    finally:
        # What Claude Code showed after the code went in, for diagnosing a
        # sign-in that did not finish. The token and the code are masked first.
        try:
            shown = TOKEN_RE.sub("<token>", screen_text(raw))
            if "code" in dir() and code: shown = shown.replace(code, "<code>")
            if not (ROOT / "secrets" / "claude").exists() or "<token>" not in shown:
                write_private(private_dir(ROOT / "run") / "login-debug.txt", shown[-4000:])
        except Exception:
            pass
        raw = b""
        try: os.close(fd)
        except OSError: pass


def logout(harness):
    if harness == "claude": forget_claude_token()
    elif harness in DEVICE: forget_device(harness)
    else: fail("Buzz cannot sign that harness out on this machine.")
    stop_harness_agents(harness)
    return {"ok": True}


# ---------------------------------------------------------------- Buzz profile

def buzz(d, *args):
    s = read_settings(d)
    env = dict(base_env(), BUZZ_PRIVATE_KEY=(d / "key").read_text().strip(),
               BUZZ_RELAY_URL=s["community"], BUZZ_AUTH_TAG=json.dumps(s["auth"]))
    return subprocess.run([str(BIN / "buzz"), *args], env=env, capture_output=True, text=True, timeout=30)


def publish_profile(d):
    s = read_settings(d)
    args = ["users", "set-profile", "--name", s["name"]]
    if s.get("picture"): args += ["--avatar", s["picture"]]
    done = buzz(d, *args)
    return done.returncode == 0, (done.stderr or done.stdout)[-300:]


def owner_of(settings):
    auth = settings.get("auth")
    if isinstance(auth, list) and len(auth) == 4 and HEX64.match(str(auth[1])): return auth[1]
    return None


def community_url(value):
    if not isinstance(value, str) or not re.match(r"^(wss|https)://[A-Za-z0-9.-]+(:\d+)?/?$", value):
        fail("community must be a wss:// or https:// address")
    return "https://" + value.split("://", 1)[1].rstrip("/")


# ---------------------------------------------------------------- requests

CHANGES = {"remove", "activate", "profile", "instructions.set", "settings.set", "start", "heartbeat.set"}


def model_fields(s, cache=None, d=None):
    """What status and list say about an agent's model: the model and effort
    it runs with, whether it chose them (modelChosen, effortChosen), and
    modelNote or modelProblem when the machine has one. A running agent
    reports what it was started with (launch.json), which is what it runs
    until it restarts; a stopped one what it would start with now. `cache`
    keeps one offered() per harness across a list."""
    harness = s.get("harness") or "claude"
    if harness not in DEFAULTS: return {"model": None, "effort": None}
    chosen = {"modelChosen": bool(s.get("model")), "effortChosen": bool(s.get("effort"))}
    if cache is None: cache = {}
    if harness not in cache: cache[harness] = offered(harness)
    picked = choice(harness, s, cache[harness])
    unchecked = f"The machine has not yet checked that {LABEL[harness]} offers this model on its sign-in."
    if d is not None and running(d):
        launched = read_json(d / "launch.json")
        if not isinstance(launched, dict):
            return {"model": None, "effort": None, **chosen, "modelChecked": False,
                    "modelNote": f"Started before agents had a model here; it runs {LABEL[harness]}'s own default until it restarts."}
        checked = launched.get("checked", True) is not False or picked.get("checked", True)
        note = launched.get("note") or (None if checked else unchecked)
        return {"model": launched.get("model"), "effort": launched.get("effort"), **chosen, "modelChecked": bool(checked),
                **({"modelNote": note} if note else {}),
                **({"modelProblem": picked["problem"]} if picked.get("problem") else {})}
    checked = picked.get("checked", True)
    note = picked.get("note") or (None if checked else unchecked)
    return {"model": picked.get("model"), "effort": picked.get("effort"), **chosen, "modelChecked": checked,
            **({"modelNote": note} if note else {}),
            **({"modelProblem": picked["problem"]} if picked.get("problem") else {})}


def may_change(settings):
    """A caller changes only agents it created. The admin (the machine owner's
    own key, which has no label) changes any, and only the admin changes the
    agents it made, or ones made before creators were recorded."""
    creator = settings.get("createdBy")
    if CALLER and creator != CALLER:
        fail(f"This agent belongs to {creator or 'the machine owner'}. Only they or a Black 4 admin can change it.")

def handle(req):
    if not isinstance(req, dict): fail("request must be a JSON object")
    op = req.get("op")
    private_dir(AGENTS)

    if op == "machine.status": return machine_status()
    if op == "models": return models_reply()
    if op == "doctor": return doctor()
    if op == "login.start":
        harness = req.get("harness")
        # Every agent on a harness uses the machine's one sign-in: a teammate
        # may sign it in when it is signed out, never switch a working one.
        if CALLER and harness in SIGN_IN and credential(harness) and not known_bad(harness):
            fail(f"{LABEL[harness]} is already signed in on this machine. Only a Black 4 admin can switch it to another account.")
        return login_start(harness, req.get("flows"))
    if op == "login.finish": return login_finish(req.get("loginId"), req.get("code"))
    if op == "login.cancel":
        d = login_dir(req.get("loginId"))
        if d.exists(): kill_login(d)
        return {"ok": True}
    if op == "logout":
        if CALLER: fail("Only a Black 4 admin can sign this machine out.")
        return logout(req.get("harness"))

    if op == "provision":
        name = (req.get("name") or "").strip()
        if not name or len(name) > 128: fail("name is required (128 characters at most)")
        # A retried creation gets the same agent back, not a second key.
        for d in agent_dirs():
            s = read_settings(d)
            if (s.get("name") == name and not s.get("auth") and s.get("requestId") == req.get("requestId")
                    and s.get("createdBy") == CALLER):
                return {"ok": True, "pubkey": d.name}
        community = community_url(req.get("community"))
        config = req.get("config") or {}
        harness = config.get("harness") or "claude"
        model, effort = checked_choice(harness, config.get("model"), config.get("effort"))
        secret = secrets.token_hex(32)
        while not 0 < int(secret, 16) < N: secret = secrets.token_hex(32)
        pubkey = pubkey_of(secret)
        d = AGENTS / pubkey
        d.mkdir(mode=0o700)
        fd = os.open(d / "key", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.write(fd, secret.encode()); os.close(fd)
        write_settings(d, {
            "name": name, "picture": req.get("picture"), "requestId": req.get("requestId"),
            "community": community,
            "harness": harness, "model": model, "effort": effort,
            "instructions": config.get("instructions") or "",
            "respondTo": config.get("respondTo") or "owner-only",
            "allow": [k for k in (config.get("allow") or []) if HEX64.match(str(k))],
            "createdAt": int(time.time()), "createdBy": CALLER,
        })
        return {"ok": True, "pubkey": pubkey}

    if op == "identity":
        # Which owner key each agent attests, so the owner can be linked to a
        # Black 4 account. Public keys only; no key file is opened.
        return {"ok": True, "agents": [
            {"pubkey": d.name, "name": read_settings(d).get("name"),
             "owner": owner_of(read_settings(d))} for d in agent_dirs()]}

    if op == "list":
        rows, cache = [], {}
        for d in agent_dirs():
            s = read_settings(d)
            rows.append({"pubkey": d.name, "name": s.get("name"), "harness": s.get("harness"),
                         "respondTo": s.get("respondTo"), "activated": bool(s.get("auth")), "running": bool(running(d)),
                         "keepsStopping": keeps_stopping(d), "createdBy": s.get("createdBy"), "heartbeat": heartbeat_minutes(s),
                         **model_fields(s, cache, d)})
        return {"ok": True, "agents": rows}

    d = folder(req.get("pubkey"))
    if op in CHANGES and d.exists(): may_change(read_settings(d))
    # Asked for in person: the supervisor's backoff starts over.
    if op in ("start", "activate", "instructions.set", "settings.set") and d.exists(): (d / "restarts.json").unlink(missing_ok=True)
    if op == "remove":
        if d.exists():
            with agent_lock(d): stop(d)
            shutil.rmtree(d)
        drop_persistence()
        return {"ok": True}
    if not d.exists(): fail("no such agent on this machine")
    s = read_settings(d)

    if op == "activate":
        auth = req.get("auth")
        if (not isinstance(auth, list) or len(auth) != 4 or auth[0] != "auth"
                or not HEX64.match(str(auth[1])) or not re.match(r"^[0-9a-f]{128}$", str(auth[3]))):
            fail("auth must be a NIP-OA tag: [auth, owner, conditions, signature]")
        s["auth"] = auth
        s["community"] = community_url(req.get("community") or s["community"])
        for key in ("harness", "model", "effort", "instructions", "respondTo", "heartbeat"):
            if (req.get("config") or {}).get(key) is not None: s[key] = req["config"][key]
        s["model"], s["effort"] = checked_choice(s.get("harness") or "claude", s.get("model"), s.get("effort"))
        write_settings(d, s)
        pid = start(d)
        ok, detail = publish_profile(d)
        return {"ok": True, "pid": pid, "profilePublished": ok, **({} if ok else {"profileError": detail})}

    if op == "profile":
        if req.get("name"): s["name"] = req["name"].strip()
        if "picture" in req: s["picture"] = req.get("picture")
        write_settings(d, s)
        ok, detail = publish_profile(d)
        if not ok: fail("profile was not published: " + detail)
        return {"ok": True}

    if op == "heartbeat.get":
        return {"ok": True, **heartbeat_view(s)}
    if op == "heartbeat.set":
        # minutes: 0 turns it off; prompt: what each heartbeat does, "" for the default.
        if "minutes" in req:
            minutes = req.get("minutes")
            if minutes not in (0, None) and (not isinstance(minutes, int) or isinstance(minutes, bool)
                                             or not HEARTBEAT_MIN <= minutes <= HEARTBEAT_MAX):
                fail(f"minutes is 0 (off) or {HEARTBEAT_MIN} to {HEARTBEAT_MAX}")
            s["heartbeat"] = minutes or 0
        if "prompt" in req:
            prompt = req.get("prompt")
            if prompt is not None and not isinstance(prompt, str): fail("prompt is text")
            s["heartbeatPrompt"] = (prompt or "").strip()[:HEARTBEAT_PROMPT_MAX]
        write_settings(d, s)
        if s.get("auth"): start(d)
        return {"ok": True, **heartbeat_view(s)}

    if op == "instructions.get":
        return {"ok": True, "instructions": s.get("instructions") or ""}
    if op == "instructions.set":
        with agent_lock(d):
            s = read_settings(d)
            s["instructions"] = str(req.get("instructions") or "")[:20000]
            write_settings(d, s)
            if s.get("auth"): _start(d)
        return {"ok": True}

    if op == "settings.set":
        # The agent's model and effort; "" is the harness's default here. A
        # field left out stays as it was. An activated agent restarts on them.
        with agent_lock(d):
            s = read_settings(d)
            harness = s.get("harness") or "claude"
            model = req["model"] if "model" in req else s.get("model")
            effort = req["effort"] if "effort" in req else s.get("effort")
            s["model"], s["effort"] = checked_choice(harness, model, effort)
            write_settings(d, s)
            if s.get("auth"): _start(d)
        return {"ok": True, **model_fields(s, d=d)}

    if op == "start":
        return {"ok": True, "pid": start(d)}

    if op == "status":
        r = restarts(d)
        return {"ok": True, "running": bool(running(d)), "activated": bool(s.get("auth")),
                "name": s.get("name"), "harness": s.get("harness"), "respondTo": s.get("respondTo"),
                "keepsStopping": keeps_stopping(d), "restarts": r.get("count", 0), **model_fields(s, d=d),
                **({"nextRestart": int(r["next"])} if r.get("next") and not running(d) else {}),
                "log": log_tail(d, 1500)}

    fail("unknown op")


def main(argv=None):
    global CALLER
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["--caller"]:
        # Only an authorized_keys forced command or the door passes this, and
        # then nothing else: a teammate's key never reaches supervise or a helper.
        if len(argv) != 2 or not (CALLER_LABEL.fullmatch(argv[1]) or CALLER_EMAIL.fullmatch(argv[1])):
            print(json.dumps({"ok": False, "error": "this key's caller label is not valid; ask an admin to add it again"}))
            return
        CALLER, argv = argv[1], []
    if argv[:1] == ["supervise"]: return supervise()
    if argv[:1] == ["doctor"]: sys.exit(print_doctor())
    if argv[:1] == ["login-helper"] and len(argv) == 2: return login_helper(argv[1])
    if argv[:1] == ["check"] and len(argv) == 2 and argv[1] in SIGN_IN: return run_check(argv[1])
    if argv == ["models", "claude"]: return refresh_claude_models()
    try:
        try: req = json.loads(sys.stdin.read() or "{}")
        except ValueError: fail("request is not JSON")
        reply = handle(req)
    except Fail as e:
        reply = {"ok": False, "error": str(e)}
    except Exception as e:  # an unexpected failure is still one JSON line
        reply = {"ok": False, "error": f"agentctl failed: {type(e).__name__}: {str(e)[:300]}"}
    print(json.dumps(reply))


if __name__ == "__main__":
    main()
