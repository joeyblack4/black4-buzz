def agy_listing(slot):
    """One ACP session on this slot (`buzz-acp models`): (True, rows) with the
    models and thinking levels it offers, (False, None) when agy says the
    sign-in is missing or refused, (None, None) when it cannot tell."""
    agy = agy_cli()
    if not agy or not (BIN / "buzz-acp").exists(): return None, None
    env = slot_env(slot)
    if slot.endswith("-key"):
        key = stored_key("antigravity")
        if not key: return False, None
        env.update(KEYS["antigravity"]["env"](key, None))
    try:
        done = subprocess.run([str(BIN / "buzz-acp"), "models", "--json", "--agent-command", "agy", f"--agent-args={agy_args(slot_home(slot))}"],
                              cwd=private_dir(RUN / "check"), env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (subprocess.TimeoutExpired, OSError):
        return None, None
    try: listing = json.loads(done.stdout)
    except ValueError: listing = None
    if not isinstance(listing, dict):
        said = f"{done.stdout}\n{done.stderr}"
        if re.search(r"Authentication required|-32000|not (signed|logged) in|unauthenticated|invalid_grant", said, re.I): return False, None
        return None, None
    rows = agy_models(listing)
    return (True, rows) if rows else (None, None)


def agy_models(listing):
    """[{id, label, efforts}] from agy's ACP listing: the model option's
    values in its order, labelled as agy names them, each with the thinking
    levels that its <model>-<level> ids offer."""
    stable = listing.get("stable") if isinstance(listing.get("stable"), dict) else {}
    options = []
    for option in stable.get("configOptions") or []:
        if isinstance(option, dict) and option.get("category") == "model":
            options = [o for o in option.get("options") or [] if isinstance(o, dict) and isinstance(o.get("value"), str)]
    unstable = listing.get("unstable") if isinstance(listing.get("unstable"), dict) else {}
    ids = [m.get("modelId") for m in unstable.get("availableModels") or [] if isinstance(m, dict) and isinstance(m.get("modelId"), str)]
    rows = []
    for o in options:
        model = o["value"]
        if not MODEL_ID.match(model): continue
        levels = [i[len(model) + 1:] for i in ids if i.startswith(model + "-")]
        rows.append({"id": model, "label": str(o.get("name") or model), "efforts": effort_sorted(l for l in levels if l in EFFORT_ORDER)})
    return rows


def run_agy_check(slot):
    ok, _ = agy_listing(slot)
    return ok, None


def list_agy_models(slot):
    ok, rows = agy_listing(slot)
    return rows if ok else None


