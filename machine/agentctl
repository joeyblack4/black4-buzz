def base_env():
    """A clean environment for child processes: nothing inherited from SSH or cron
    except what a CLI needs to find its home and temp folder."""
    env = {"HOME": str(HOME), "PATH": agent_path(), "LANG": os.environ.get("LANG") or "en_US.UTF-8"}
    for key in ("USER", "LOGNAME", "SHELL", "TMPDIR"):
        if os.environ.get(key): env[key] = os.environ[key]
    env.setdefault("USER", os.environ.get("USER") or HOME.name)
    return env


