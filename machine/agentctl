# the private QWEN_HOME), its token refresh and its lock are exactly Qwen
# Code's: nothing here writes or refreshes a token. The file's `revision` is
# the sign-in attempt; a token refresh rewrites the file and keeps it, so the
# fingerprint is the revision, never the bytes. The check and the model list
# are the same script (`check`, `models`): no model is called.

MEMBER = {
    "qwen": {"home_env": "QWEN_HOME", "cred": "subscription_credentials.json", "service": "Qwen",
